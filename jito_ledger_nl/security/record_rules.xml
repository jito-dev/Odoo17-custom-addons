<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Multi-company scoping for jito.ledger.move and
            jito.ledger.move.line. FR-02 (Leading-Ledger Immutability)
            is already enforced at the schema level by the absence of
            any FK from jito_ledger_* into account.move*; these rules
            only constrain visibility per company.
        -->

        <record id="jito_ledger_move_multi_company_rule" model="ir.rule">
            <field name="name">jito.ledger.move: multi-company</field>
            <field name="model_id" ref="model_jito_ledger_move"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('jito_ledger_core.group_mgmt_ledger_accountant')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_senior_accountant')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_finance_manager')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_admin')),
            ]"/>
        </record>

        <record id="jito_ledger_move_line_multi_company_rule" model="ir.rule">
            <field name="name">jito.ledger.move.line: multi-company</field>
            <field name="model_id" ref="model_jito_ledger_move_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('jito_ledger_core.group_mgmt_ledger_accountant')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_senior_accountant')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_finance_manager')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_admin')),
            ]"/>
        </record>

    </data>
</odoo>
