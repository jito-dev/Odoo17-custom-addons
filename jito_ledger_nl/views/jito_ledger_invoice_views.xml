<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Invoicing layer (17.0.2.0.0 → 17.0.3.0.x).

        Underlying jito.ledger.move table; move_type discriminates
        Customer Invoices / Customer Credit Notes / Vendor Bills /
        Vendor Refunds.

        Two form-view shapes:

        1. view_jito_ledger_move_form_invoice (INHERITED) — generic
           invoicing UX bolted onto the base jito.ledger.move form.
           Used by Vendor Bills / Customer Credit Notes / Vendor Refunds
           via their actions. Shows move_type, line invoicing columns
           (product/qty/price), invoice_date / due_date, total footer.

        2. view_jito_ledger_move_form_customer_invoice (PRIMARY,
           17.0.3.0.0) — dedicated Customer Invoice form. Hides the six
           redundant fields, renames Partner → Customer, Document
           Currency → Currency, Lines → Invoice Lines, adds the
           Journal Items read-only preview tab. Used only by
           action_jito_ledger_customer_invoices via view_ids.

        Why two forms instead of conditional inheritance: Odoo prohibits
        `string` as a selector in xpath, and twin <field> declarations
        with the same name are clumsy to disambiguate. A primary form
        for the simplified flow is cleaner and avoids both pitfalls.
    -->

    <!-- (1) Inherited invoicing form (generic; no Customer-Invoice simplifications) -->

    <record id="view_jito_ledger_move_form_invoice" model="ir.ui.view">
        <field name="name">jito.ledger.move.form.invoice</field>
        <field name="model">jito.ledger.move</field>
        <field name="inherit_id" ref="view_jito_ledger_move_form"/>
        <field name="arch" type="xml">

            <!-- Move-type chip — visible on all non-Customer-Invoice doc types
                 (Customer Invoices use the primary form below where it's hidden). -->
            <xpath expr="//field[@name='ledger_id']" position="before">
                <field name="move_type" readonly="state != 'draft'"/>
            </xpath>

            <!-- Invoice-specific date fields (visible for any non-entry doc). -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="invoice_date"
                       readonly="state != 'draft'"
                       invisible="move_type == 'entry'"
                       required="move_type != 'entry'"/>
                <field name="invoice_date_due"
                       readonly="state != 'draft'"
                       invisible="move_type == 'entry'"/>
            </xpath>

            <!-- Add product/qty/price columns to the lines tree -->
            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="before">
                <field name="product_id"
                       options="{'no_create': True}"
                       column_invisible="parent.move_type == 'entry'"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/tree/field[@name='credit_amount_currency']" position="after">
                <field name="quantity"
                       column_invisible="parent.move_type == 'entry'"/>
                <field name="price_unit"
                       column_invisible="parent.move_type == 'entry'"/>
                <field name="price_subtotal"
                       column_invisible="parent.move_type == 'entry'"
                       sum="Subtotal"/>
            </xpath>

            <!-- Hide debit/credit columns on invoice-style docs since
                 amount_currency derives from price_subtotal × side -->
            <xpath expr="//field[@name='line_ids']/tree/field[@name='debit_amount_currency']" position="attributes">
                <attribute name="column_invisible">parent.move_type != 'entry'</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='credit_amount_currency']" position="attributes">
                <attribute name="column_invisible">parent.move_type != 'entry'</attribute>
            </xpath>

            <!-- Total footer for invoice-style docs -->
            <xpath expr="//notebook/page[@name='lines']" position="after">
                <group invisible="move_type == 'entry'">
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_untaxed"/>
                        <field name="amount_total"
                               class="oe_subtotal_footer_separator"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- (2) Primary form — Customer Invoice flow (17.0.3.0.0) -->

    <record id="view_jito_ledger_move_form_customer_invoice" model="ir.ui.view">
        <field name="name">jito.ledger.move.form.customer.invoice</field>
        <field name="model">jito.ledger.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Customer Invoice">
                <header>
                    <button name="action_post"
                            string="Post"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'posted' or reversal_move_ids or reversed_entry_id"/>
                    <button name="action_reverse"
                            string="Reverse Entry"
                            type="object"
                            invisible="state != 'posted' or reversal_move_ids"
                            confirm="This creates an additive counter-entry. Both the original and the reversal stay visible. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <!-- Hidden but required-on-DB fields, pre-filled by default_get -->
                    <field name="move_type" invisible="1"/>
                    <field name="ledger_id" invisible="1"/>
                    <field name="journal_id" invisible="1"/>
                    <field name="entry_type" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="reversal_move_ids" invisible="1"/>
                    <field name="reversed_entry_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"
                                   placeholder="New (assigned on Post)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   string="Customer"
                                   readonly="state != 'draft'"
                                   required="1"
                                   options="{'no_create': True}"/>
                            <field name="ref"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="invoice_date"
                                   readonly="state != 'draft'"
                                   required="1"/>
                            <field name="invoice_date_due"
                                   readonly="state != 'draft'"/>
                            <field name="date"
                                   string="Accounting Date"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   string="Currency"
                                   readonly="state != 'draft'"
                                   required="1"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="invoice_lines">
                            <field name="invoice_line_ids"
                                   readonly="state != 'draft'"
                                   context="{'default_currency_id': currency_id, 'jito_journal_id': journal_id, 'default_move_type': 'out_invoice', 'default_display_type': 'product'}">
                                <tree editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="account_id"
                                           options="{'no_create': True}"/>
                                    <field name="name" string="Label"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"
                                           string="Subtotal"
                                           sum="Subtotal"/>
                                    <!-- Hidden but loaded fields -->
                                    <field name="amount_currency" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="move_type" column_invisible="1"/>
                                    <field name="display_type" column_invisible="1"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                Add product lines for the invoice. Account
                                defaults to <strong>Product Sales</strong>;
                                override per line if needed.
                            </p>
                            <group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_total"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="Journal Items" name="journal_items">
                            <field name="line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="account_id"/>
                                    <field name="name" string="Label"/>
                                    <field name="debit_amount_currency"
                                           string="Debit"
                                           sum="Debit Total"/>
                                    <field name="credit_amount_currency"
                                           string="Credit"
                                           sum="Credit Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                Read-only preview of the underlying journal items.
                                The <strong>Account Receivable</strong> balancing
                                line is auto-added on Post — in draft state only
                                the product lines appear here.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- (3) Primary form — Vendor Bill flow (17.0.4.0.0) -->

    <record id="view_jito_ledger_move_form_vendor_bill" model="ir.ui.view">
        <field name="name">jito.ledger.move.form.vendor.bill</field>
        <field name="model">jito.ledger.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Vendor Bill">
                <header>
                    <button name="action_post"
                            string="Post"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'posted' or reversal_move_ids or reversed_entry_id"/>
                    <button name="action_reverse"
                            string="Reverse Entry"
                            type="object"
                            invisible="state != 'posted' or reversal_move_ids"
                            confirm="This creates an additive counter-entry. Both the original and the reversal stay visible. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <!-- Hidden but required-on-DB fields, pre-filled by default_get -->
                    <field name="move_type" invisible="1"/>
                    <field name="ledger_id" invisible="1"/>
                    <field name="journal_id" invisible="1"/>
                    <field name="entry_type" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="reversal_move_ids" invisible="1"/>
                    <field name="reversed_entry_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"
                                   placeholder="New (assigned on Post)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   string="Vendor"
                                   readonly="state != 'draft'"
                                   required="1"
                                   options="{'no_create': True}"
                                   context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="ref"
                                   string="Bill Reference"
                                   readonly="state != 'draft'"
                                   placeholder="Vendor's invoice number…"/>
                        </group>
                        <group>
                            <field name="invoice_date"
                                   string="Bill Date"
                                   readonly="state != 'draft'"
                                   required="1"/>
                            <field name="invoice_date_due"
                                   string="Due Date"
                                   readonly="state != 'draft'"/>
                            <field name="date"
                                   string="Accounting Date"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   string="Currency"
                                   readonly="state != 'draft'"
                                   required="1"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bill Lines" name="bill_lines">
                            <field name="invoice_line_ids"
                                   readonly="state != 'draft'"
                                   context="{'default_currency_id': currency_id, 'jito_journal_id': journal_id, 'default_move_type': 'in_invoice', 'default_display_type': 'product'}">
                                <tree editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="account_id"
                                           options="{'no_create': True}"/>
                                    <field name="name" string="Label"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"
                                           string="Subtotal"
                                           sum="Subtotal"/>
                                    <!-- Hidden but loaded fields -->
                                    <field name="amount_currency" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="move_type" column_invisible="1"/>
                                    <field name="display_type" column_invisible="1"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                Add product lines for the bill. Account
                                defaults to <strong>Operating Expenses</strong>;
                                override per line if needed.
                            </p>
                            <group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_total"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="Journal Items" name="journal_items">
                            <field name="line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="account_id"/>
                                    <field name="name" string="Label"/>
                                    <field name="debit_amount_currency"
                                           string="Debit"
                                           sum="Debit Total"/>
                                    <field name="credit_amount_currency"
                                           string="Credit"
                                           sum="Credit Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                Read-only preview of the underlying journal items.
                                The <strong>Account Payable</strong> balancing
                                line is auto-added on Post — in draft state the
                                preview is recomputed live.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree view — invoice-style: Number / Partner / Total / State -->

    <record id="view_jito_ledger_move_tree_invoice" model="ir.ui.view">
        <field name="name">jito.ledger.move.tree.invoice</field>
        <field name="model">jito.ledger.move</field>
        <field name="arch" type="xml">
            <tree string="Invoices"
                  sample="1"
                  decoration-info="state == 'draft'"
                  decoration-muted="state == 'reversed'">
                <field name="name"/>
                <field name="invoice_date" optional="show"/>
                <field name="date" optional="hide"/>
                <field name="partner_id" string="Customer"/>
                <field name="ref" optional="hide"/>
                <field name="invoice_date_due" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="move_type" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'reversed'"/>
            </tree>
        </field>
    </record>

    <!-- Search view shared by all four doc-type actions. -->

    <record id="view_jito_ledger_move_search_invoice" model="ir.ui.view">
        <field name="name">jito.ledger.move.search.invoice</field>
        <field name="model">jito.ledger.move</field>
        <field name="arch" type="xml">
            <search string="Invoices">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="ref"/>
                <field name="invoice_date"/>
                <separator/>
                <filter string="Draft" name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="state_posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter string="Reversed" name="state_reversed"
                        domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter string="This Month" name="date_this_month"
                        domain="[('invoice_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Invoice Date" name="group_inv_date"
                            context="{'group_by': 'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Four actions — Customer Invoices uses the primary simplified form;
         the other three reference the inherited generic form. -->

    <record id="action_jito_ledger_customer_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">jito.ledger.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_state_posted': 1}</field>
        <field name="search_view_id" ref="view_jito_ledger_move_search_invoice"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_jito_ledger_move_tree_invoice')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_jito_ledger_move_form_customer_invoice')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Customer Invoice</p>
            <p>NL-ledger customer invoices. Defaults to the configured
               Customer Invoices journal and posts to <strong>Account
               Receivable</strong> / <strong>Product Sales</strong> by
               default; override either via <em>Configuration → Customer
               Invoices</em>.</p>
        </field>
    </record>

    <record id="action_jito_ledger_customer_credit_notes" model="ir.actions.act_window">
        <field name="name">Customer Credit Notes</field>
        <field name="res_model">jito.ledger.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'out_refund')]</field>
        <field name="context">{'default_move_type': 'out_refund', 'search_default_state_posted': 1}</field>
        <field name="search_view_id" ref="view_jito_ledger_move_search_invoice"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_jito_ledger_move_tree_invoice')}),
            (0, 0, {'view_mode': 'form'}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Customer Credit Note</p>
        </field>
    </record>

    <record id="action_jito_ledger_vendor_bills" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">jito.ledger.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_state_posted': 1}</field>
        <field name="search_view_id" ref="view_jito_ledger_move_search_invoice"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_jito_ledger_move_tree_invoice')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_jito_ledger_move_form_vendor_bill')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Vendor Bill</p>
            <p>NL-ledger vendor bills. Defaults to the configured
               Vendor Bills journal and posts to <strong>Account
               Payable</strong> / <strong>Operating Expenses</strong> by
               default; override either via <em>Configuration → Vendor
               Bills</em>.</p>
        </field>
    </record>

    <record id="action_jito_ledger_vendor_refunds" model="ir.actions.act_window">
        <field name="name">Vendor Refunds</field>
        <field name="res_model">jito.ledger.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="context">{'default_move_type': 'in_refund', 'search_default_state_posted': 1}</field>
        <field name="search_view_id" ref="view_jito_ledger_move_search_invoice"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_jito_ledger_move_tree_invoice')}),
            (0, 0, {'view_mode': 'form'}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Vendor Refund</p>
        </field>
    </record>

</odoo>
