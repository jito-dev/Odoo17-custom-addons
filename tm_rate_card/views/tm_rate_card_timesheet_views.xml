<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- TIMESHEET TREE VIEW (Embedded in Rate Card Entry) -->
    <!-- ============================================================ -->

    <record id="view_tm_rate_card_timesheet_tree" model="ir.ui.view">
        <field name="name">tm.rate.card.timesheet.tree</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree string="Timesheets" create="false" delete="false" edit="false"
                  decoration-muted="validated_status == 'validated'">
                <!-- Date & Employee -->
                <field name="date"/>
                <field name="employee_id"/>

                <!-- Project & Task -->
                <field name="project_id"/>
                <field name="task_id"/>

                <!-- Description -->
                <field name="name"/>

                <!-- Hours -->
                <field name="unit_amount" string="Hours" sum="Total Hours"/>

                <!-- Billing Rate & Amount -->
                <field name="tm_billing_currency_id" optional="show" string="Billing Currency"/>
                <field name="tm_billing_rate" widget="monetary" optional="show"/>
                <field name="tm_billable_amount" widget="monetary" sum="Total Billable"/>

                <!-- Validation Status -->
                <field name="validated_status" widget="badge"
                       decoration-success="validated_status == 'validated'"
                       decoration-info="validated_status == 'draft'"
                       optional="show"/>

                <!-- Cost (employee cost rate) -->
                <field name="amount" widget="monetary" string="Cost" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- DRAFT TIMESHEET PREVIEW TREE VIEW -->
    <!-- ============================================================ -->

    <record id="view_tm_rate_card_draft_timesheet_tree" model="ir.ui.view">
        <field name="name">tm.rate.card.draft.timesheet.tree</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree string="Draft Timesheets (Preview)" create="false" delete="false" edit="false"
                  decoration-warning="True">
                <!-- Date & Employee -->
                <field name="date"/>
                <field name="employee_id"/>

                <!-- Project & Task -->
                <field name="project_id"/>
                <field name="task_id"/>

                <!-- Description -->
                <field name="name"/>

                <!-- Hours -->
                <field name="unit_amount" string="Hours" sum="Total Hours"/>

                <!-- Validation Status -->
                <field name="validated_status" widget="badge"
                       decoration-warning="validated_status == 'draft'"
                       string="Status"/>

                <!-- Note: Billing rate and amount not shown because draft timesheets don't have them yet -->
                <!-- They will be calculated when validated -->
            </tree>
        </field>
    </record>

</odoo>
