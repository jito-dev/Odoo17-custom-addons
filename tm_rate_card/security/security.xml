<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- GROUPS -->
        <!-- ============================================================ -->

        <!-- Rate Card Viewer: Read-only access -->
        <record id="group_tm_rate_card_viewer" model="res.groups">
            <field name="name">Rate Card Viewer</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="comment">Users can view rate card entries (read-only)</field>
        </record>

        <!-- Rate Card Manager: Full CRUD (subject to governance rules) -->
        <record id="group_tm_rate_card_manager" model="res.groups">
            <field name="name">Rate Card Manager</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="comment">Users can create, edit, and manage rate card entries (Finance/Sales admins)</field>
            <field name="implied_ids" eval="[(4, ref('group_tm_rate_card_viewer'))]"/>
        </record>

        <!-- ============================================================ -->
        <!-- RECORD RULES - MULTI-COMPANY -->
        <!-- ============================================================ -->

        <!-- Multi-company rule: Users only see entries in their allowed companies -->
        <record id="tm_rate_card_entry_multi_company_rule" model="ir.rule">
            <field name="name">Rate Card Entry: Multi-Company</field>
            <field name="model_id" ref="model_tm_rate_card_entry"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_tm_rate_card_viewer')), (4, ref('group_tm_rate_card_manager'))]"/>
        </record>

    </data>
</odoo>
