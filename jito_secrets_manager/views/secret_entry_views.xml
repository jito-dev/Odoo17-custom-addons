<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Tree views ──────────────────────────────────────────────────────── -->

    <record id="view_secret_entry_tree" model="ir.ui.view">
        <field name="name">secret.entry.tree</field>
        <field name="model">secret.entry</field>
        <field name="arch" type="xml">
            <tree string="Secrets" decoration-info="is_shared_with_me">
                <header>
                    <button name="action_open_new_form"
                            type="object"
                            string="New Secret"
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="secret_type" widget="badge"
                       decoration-info="secret_type == 'login'"
                       decoration-warning="secret_type == 'card'"
                       decoration-success="secret_type == 'note'"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="user_id" optional="show"/>
                <field name="share_count" string="Shares" optional="show"/>
                <field name="is_shared_with_me" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_secret_entry_shared_tree" model="ir.ui.view">
        <field name="name">secret.entry.shared.tree</field>
        <field name="model">secret.entry</field>
        <field name="arch" type="xml">
            <tree string="Shared with Me" create="false">
                <field name="name"/>
                <field name="secret_type" widget="badge"
                       decoration-info="secret_type == 'login'"
                       decoration-warning="secret_type == 'card'"
                       decoration-success="secret_type == 'note'"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="user_id" string="Owner"/>
            </tree>
        </field>
    </record>

    <!-- ── Form view ───────────────────────────────────────────────────────── -->

    <record id="view_secret_entry_form" model="ir.ui.view">
        <field name="name">secret.entry.form</field>
        <field name="model">secret.entry</field>
        <field name="arch" type="xml">
            <form string="Secret">
                <header>
                    <field name="vault_is_unsealed" invisible="1"/>
                    <field name="is_shared_with_me" invisible="1"/>
                    <!-- Vault state badges -->
                    <span class="badge text-bg-danger"
                          invisible="vault_is_unsealed">
                        <i class="fa fa-lock me-1"/>Vault Sealed
                    </span>
                    <span class="badge text-bg-success"
                          invisible="not vault_is_unsealed">
                        <i class="fa fa-unlock me-1"/>Vault Unsealed
                    </span>
                    <span class="badge text-bg-info ms-1"
                          invisible="not is_shared_with_me">
                        <i class="fa fa-share-alt me-1"/>Shared with you
                    </span>
                </header>

                <sheet>
                    <!-- Vault sealed overlay warning -->
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3"
                         invisible="vault_is_unsealed">
                        <i class="fa fa-lock"/>
                        <span>
                            The vault is <strong>sealed</strong>. Secret values cannot be viewed or saved until an administrator unseals the vault.
                        </span>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. GitHub Admin Account"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Details">
                            <field name="secret_type"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': False}"/>
                        </group>
                        <group string="Ownership">
                            <field name="user_id"
                                   options="{'no_create_edit': True}"
                                   groups="jito_secrets_manager.group_secrets_admin"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <!-- Secret payload — rendered by Owl widget -->
                    <!-- transient_payload carries the plaintext JSON to the server on save -->
                    <!-- encrypted_payload is the actual stored ciphertext -->
                    <div class="o_secret_payload_section mt-3">
                        <field name="transient_payload"
                               widget="SecretPayloadWidget"
                               nolabel="1"/>
                        <field name="encrypted_payload" invisible="1"/>
                    </div>

                    <notebook>
                        <page string="Sharing" name="sharing">
                            <field name="share_ids"
                                   context="{'default_secret_id': active_id}"
                                   readonly="not vault_is_unsealed">
                                <tree string="Shares" editable="bottom">
                                    <field name="shared_with_user_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="shared_by_user_id" readonly="1"/>
                                    <field name="expires_at"/>
                                    <field name="is_expired" widget="boolean"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Log" name="audit_log"
                              groups="jito_secrets_manager.group_secrets_admin">
                            <field name="audit_log_ids" readonly="1">
                                <tree string="Audit Log" create="false" delete="false" edit="false">
                                    <field name="timestamp"/>
                                    <field name="user_id"/>
                                    <field name="action" widget="badge"
                                           decoration-info="action in ('create','share')"
                                           decoration-warning="action == 'reveal'"
                                           decoration-danger="action == 'delete'"
                                           decoration-success="action == 'edit'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ─────────────────────────────────────────────────────── -->

    <record id="view_secret_entry_search" model="ir.ui.view">
        <field name="name">secret.entry.search</field>
        <field name="model">secret.entry</field>
        <field name="arch" type="xml">
            <search string="Secrets">
                <field name="name" string="Name"/>
                <field name="tag_ids" string="Tags"/>
                <filter string="Login + Password" name="type_login"
                        domain="[('secret_type', '=', 'login')]"/>
                <filter string="Card" name="type_card"
                        domain="[('secret_type', '=', 'card')]"/>
                <filter string="Note" name="type_note"
                        domain="[('secret_type', '=', 'note')]"/>
                <separator/>
                <filter string="Shared with Me" name="shared_with_me"
                        domain="[('share_ids.shared_with_user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'secret_type'}"/>
                    <filter string="Owner" name="group_owner"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Actions ─────────────────────────────────────────────────────────── -->

    <!-- New Secret button: checks vault is unsealed first, then opens a fresh form -->
    <record id="action_new_secret" model="ir.actions.act_window">
        <field name="name">New Secret</field>
        <field name="res_model">secret.entry</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <record id="action_my_secrets" model="ir.actions.act_window">
        <field name="name">My Secrets</field>
        <field name="res_model">secret.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="search_view_id" ref="view_secret_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No secrets yet. Create your first one!
            </p>
        </field>
    </record>

    <record id="action_shared_with_me" model="ir.actions.act_window">
        <field name="name">Shared with Me</field>
        <field name="res_model">secret.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_secret_entry_shared_tree"/>
        <field name="domain">
            [('user_id', '!=', uid),
             ('share_ids.shared_with_user_id', '=', uid),
             ('share_ids.expires_at', '&gt;', time.strftime('%Y-%m-%d %H:%M:%S'))]
        </field>
        <field name="search_view_id" ref="view_secret_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No secrets have been shared with you yet.
            </p>
        </field>
    </record>

    <record id="action_create_secret_page" model="ir.actions.client">
        <field name="name">Create Secret</field>
        <field name="tag">jito_secrets_manager.create_secret</field>
    </record>

    <record id="action_all_secrets" model="ir.actions.act_window">
        <field name="name">All Secrets</field>
        <field name="res_model">secret.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secret_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No secrets found.
            </p>
        </field>
    </record>
</odoo>
