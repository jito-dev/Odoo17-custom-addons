<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone share list for admin reference -->
    <record id="view_secret_share_tree" model="ir.ui.view">
        <field name="name">secret.share.tree</field>
        <field name="model">secret.share</field>
        <field name="arch" type="xml">
            <tree string="Shares"
                  decoration-muted="is_expired">
                <field name="secret_id"/>
                <field name="shared_with_user_id"/>
                <field name="shared_by_user_id"/>
                <field name="expires_at"/>
                <field name="is_expired" widget="boolean"/>
            </tree>
        </field>
    </record>
</odoo>
