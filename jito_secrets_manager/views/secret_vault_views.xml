<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_secret_vault_form" model="ir.ui.view">
        <field name="name">secret.vault.form</field>
        <field name="model">secret.vault</field>
        <field name="arch" type="xml">
            <form string="Vault Configuration" create="false" delete="false">
                <sheet>
                    <!-- SEALED state banner -->
                    <div class="alert alert-danger o_form_label d-flex align-items-center gap-3 mb-4"
                         invisible="is_unsealed">
                        <i class="fa fa-lock fa-2x"/>
                        <div>
                            <strong>Vault is SEALED</strong>
                            <div class="text-muted">
                                All secrets are encrypted and inaccessible. Unseal the vault to enable access.
                            </div>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button name="action_open_change_passphrase_wizard"
                                    string="Change Passphrase"
                                    type="object"
                                    class="btn btn-secondary"
                                    groups="jito_secrets_manager.group_secrets_admin"/>
                            <button name="action_open_unseal_wizard"
                                    string="Unseal Vault"
                                    type="object"
                                    class="btn btn-danger"/>
                        </div>
                    </div>

                    <!-- UNSEALED state banner -->
                    <div class="alert alert-success o_form_label d-flex align-items-center gap-3 mb-4"
                         invisible="not is_unsealed">
                        <i class="fa fa-unlock fa-2x"/>
                        <div>
                            <strong>Vault is UNSEALED</strong>
                            <div class="text-muted">
                                Secrets are accessible. The vault will seal automatically on server restart.
                            </div>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button name="action_open_change_passphrase_wizard"
                                    string="Change Passphrase"
                                    type="object"
                                    class="btn btn-secondary"
                                    groups="jito_secrets_manager.group_secrets_admin"/>
                            <button name="action_seal"
                                    string="Seal Vault"
                                    type="object"
                                    class="btn btn-warning"
                                    confirm="Seal the vault? All users will lose access to secrets until it is unsealed again."/>
                        </div>
                    </div>

                    <!-- Required for invisible modifiers on the banners above -->
                    <field name="is_unsealed" invisible="1"/>

                    <group string="Vault Status">
                        <group>
                            <field name="is_initialized" string="Initialized" widget="boolean"/>
                            <field name="state" string="Current State"/>
                        </group>
                    </group>

                    <div class="text-muted mt-3">
                        <i class="fa fa-info-circle"/>
                        The vault uses AES-256 (Fernet) encryption with a PBKDF2-derived key.
                        The master key is held only in server memory and is never persisted to disk or database.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_secret_vault_open" model="ir.actions.server">
        <field name="name">Vault</field>
        <field name="model_id" ref="model_secret_vault"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_vault_singleton()</field>
    </record>
</odoo>
