<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_secret_audit_log_tree" model="ir.ui.view">
        <field name="name">secret.audit.log.tree</field>
        <field name="model">secret.audit.log</field>
        <field name="arch" type="xml">
            <tree string="Audit Log" create="false" delete="false" edit="false"
                  decoration-warning="action == 'reveal'"
                  decoration-danger="action == 'delete'"
                  decoration-info="action in ('unseal', 'seal')">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="secret_name" string="Secret"/>
                <field name="action" widget="badge"
                       decoration-info="action in ('create','share','unseal','seal')"
                       decoration-warning="action == 'reveal'"
                       decoration-danger="action == 'delete'"
                       decoration-success="action == 'edit'"/>
            </tree>
        </field>
    </record>

    <record id="action_secret_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">secret.audit.log</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_secret_audit_log_tree"/>
    </record>
</odoo>
