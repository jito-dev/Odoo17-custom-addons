<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_secret_tag_tree" model="ir.ui.view">
        <field name="name">secret.tag.tree</field>
        <field name="model">secret.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_secret_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">secret.tag</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
