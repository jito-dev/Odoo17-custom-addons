<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_secrets_manager" model="ir.module.category">
        <field name="name">Secrets Manager</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_secrets_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_secrets_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create, view, and share their own secrets.</field>
    </record>

    <record id="group_secrets_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_secrets_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_secrets_user'))]"/>
        <field name="comment">Full access: all secrets, vault seal/unseal, configuration, audit log.</field>
    </record>
</odoo>
