<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="jito_secrets_manager.SecretPayloadWidget">
    <div class="o_secret_payload_widget">

        <!-- Vault sealed state -->
        <t t-if="!state.vaultUnsealed">
            <div class="o_secret_sealed_placeholder d-flex align-items-center gap-2 text-muted p-3 rounded border">
                <i class="fa fa-lock fa-lg"/>
                <span>Secret values are encrypted. Unseal the vault to view or edit.</span>
            </div>
        </t>

        <!-- Loading state -->
        <t t-elif="!state.loaded">
            <div class="d-flex align-items-center gap-2 p-3 text-muted">
                <i class="fa fa-spinner fa-spin"/>
                <span>Loading secret...</span>
            </div>
        </t>

        <!-- Payload fields -->
        <t t-else="">
            <div class="o_secret_fields_container">

                <!-- Built-in type fields -->
                <t t-foreach="state.fields" t-as="field" t-key="field.key">
                    <div class="o_secret_field_row mb-3">
                        <label class="o_form_label text-muted mb-1 d-block"
                               t-att-for="'field_' + field.key">
                            <t t-esc="field.label"/>
                        </label>

                        <t t-if="props.readonly or !props.record.isInEdition">
                            <!-- ── View mode ── -->
                            <div class="d-flex align-items-center gap-1">
                                <t t-if="field.sensitive">
                                    <span t-if="!state.revealedFields[field.key]"
                                          class="o_secret_masked font-monospace text-muted">
                                        ●●●●●●●●●●
                                    </span>
                                    <t t-else="">
                                        <t t-if="field.multiline">
                                            <pre class="o_secret_value font-monospace mb-0"
                                                 style="white-space: pre-wrap; word-break: break-all;"
                                                 t-esc="field.value || ''"/>
                                        </t>
                                        <span t-else=""
                                              class="o_secret_value font-monospace"
                                              t-esc="field.value || ''"/>
                                    </t>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.toggleReveal(field.key)">
                                        <i t-att-class="state.revealedFields[field.key] ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-att-title="'Copy ' + field.label"
                                            t-on-click="() => this.copyField(field.key, field.label)">
                                        <i t-att-class="state.copiedField === field.key ? 'fa fa-check text-success' : 'fa fa-copy'"/>
                                    </button>
                                </t>
                                <t t-else="">
                                    <t t-if="field.multiline">
                                        <pre class="o_secret_value font-monospace mb-0"
                                             style="white-space: pre-wrap; word-break: break-all;"
                                             t-esc="field.value || ''"/>
                                    </t>
                                    <span t-else=""
                                          class="o_secret_value"
                                          t-esc="field.value || ''"/>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-att-title="'Copy ' + field.label"
                                            t-on-click="() => this.copyField(field.key, field.label)">
                                        <i t-att-class="state.copiedField === field.key ? 'fa fa-check text-success' : 'fa fa-copy'"/>
                                    </button>
                                </t>
                            </div>
                        </t>

                        <t t-else="">
                            <!-- ── Edit mode ── -->
                            <div class="d-flex align-items-start gap-1">
                                <t t-if="field.multiline">
                                    <textarea t-att-id="'field_' + field.key"
                                              class="o_input flex-grow-1 font-monospace"
                                              rows="6"
                                              t-att-placeholder="field.label"
                                              t-on-input="(ev) => this.onFieldInput(field.key, ev.target.value)"
                                              t-att-value="field.value || ''"/>
                                </t>
                                <t t-else="">
                                    <input t-att-id="'field_' + field.key"
                                           class="o_input flex-grow-1"
                                           t-att-type="field.sensitive and !state.revealedFields[field.key] ? 'password' : 'text'"
                                           t-att-value="field.value || ''"
                                           t-att-placeholder="field.label"
                                           t-on-input="(ev) => this.onFieldInput(field.key, ev.target.value)"/>
                                    <t t-if="field.sensitive">
                                        <button class="btn btn-sm btn-outline-secondary"
                                                title="Show / Hide"
                                                t-on-click="() => this.toggleReveal(field.key)">
                                            <i t-att-class="state.revealedFields[field.key] ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                        </button>
                                    </t>
                                </t>
                                <button class="btn btn-sm btn-outline-secondary"
                                        t-att-title="'Copy ' + field.label"
                                        t-on-click="() => this.copyField(field.key, field.label)">
                                    <i t-att-class="state.copiedField === field.key ? 'fa fa-check text-success' : 'fa fa-copy'"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Divider before custom fields (if any) -->
                <t t-if="state.customFields.length > 0">
                    <hr class="my-2"/>
                    <div class="text-muted small mb-2">
                        <i class="fa fa-plus-circle me-1"/>Custom Fields
                    </div>
                </t>

                <!-- Custom (ad-hoc) fields -->
                <t t-foreach="state.customFields" t-as="cf" t-key="cf_index">
                    <div class="o_secret_field_row o_secret_custom_field mb-3">
                        <t t-if="props.readonly or !props.record.isInEdition">
                            <label class="o_form_label text-muted mb-1 d-block">
                                <t t-esc="cf.label"/>
                            </label>
                            <div class="d-flex align-items-center gap-1">
                                <t t-if="cf.sensitive">
                                    <span t-if="!state.revealedCustom[cf_index]"
                                          class="o_secret_masked font-monospace text-muted">
                                        ●●●●●●●●●●
                                    </span>
                                    <span t-else=""
                                          class="o_secret_value font-monospace"
                                          t-esc="cf.value || ''"/>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.toggleRevealCustom(cf_index)">
                                        <i t-att-class="state.revealedCustom[cf_index] ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.copyCustomField(cf_index, cf.label)">
                                        <i t-att-class="state.copiedCustom === cf_index ? 'fa fa-check text-success' : 'fa fa-copy'"/>
                                    </button>
                                </t>
                                <t t-else="">
                                    <span class="o_secret_value flex-grow-1" t-esc="cf.value || ''"/>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.copyCustomField(cf_index, cf.label)">
                                        <i t-att-class="state.copiedCustom === cf_index ? 'fa fa-check text-success' : 'fa fa-copy'"/>
                                    </button>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <!-- Edit mode for custom field -->
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <input class="o_input o_secret_custom_label"
                                       style="max-width: 140px;"
                                       type="text"
                                       t-att-value="cf.label"
                                       placeholder="Label"
                                       t-on-input="(ev) => this.onCustomLabelInput(cf_index, ev.target.value)"/>
                                <div class="form-check form-switch d-flex align-items-center ms-auto" title="Mark as sensitive">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           t-att-checked="cf.sensitive"
                                           t-on-change="(ev) => this.onCustomSensitiveChange(cf_index, ev.target.checked)"/>
                                    <label class="form-check-label ms-1 small text-muted">Sensitive</label>
                                </div>
                                <button class="btn btn-sm btn-outline-danger"
                                        title="Remove field"
                                        t-on-click="() => this.removeCustomField(cf_index)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <input class="o_input flex-grow-1"
                                       t-att-type="cf.sensitive and !state.revealedCustom[cf_index] ? 'password' : 'text'"
                                       t-att-value="cf.value"
                                       placeholder="Value"
                                       t-on-input="(ev) => this.onCustomValueInput(cf_index, ev.target.value)"/>
                                <button class="btn btn-sm btn-outline-secondary"
                                        title="Show / Hide"
                                        t-on-click="() => this.toggleRevealCustom(cf_index)">
                                    <i t-att-class="state.revealedCustom[cf_index] ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        t-att-title="'Copy ' + (cf.label || 'field')"
                                        t-on-click="() => this.copyCustomField(cf_index, cf.label || 'field')">
                                    <i t-att-class="state.copiedCustom === cf_index ? 'fa fa-check text-success' : 'fa fa-copy'"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Add Field button (edit mode only) -->
                <t t-if="!props.readonly and props.record.isInEdition">
                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-primary"
                                t-on-click="addCustomField">
                            <i class="fa fa-plus me-1"/>Add Field
                        </button>
                    </div>
                </t>

            </div>
        </t>

    </div>
</t>

</templates>
