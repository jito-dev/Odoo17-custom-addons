<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="jito_secrets_manager.CreateSecretAction">
        <div class="o_action d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
            <div class="text-center">
                <i class="fa fa-lock fa-4x text-muted mb-4"/>
                <h2 class="mb-3">Secrets Manager</h2>
                <p class="text-muted mb-4">Store and manage your encrypted credentials securely.</p>
                <button type="button"
                        class="btn btn-primary btn-lg"
                        t-on-click="onClickCreate">
                    <i class="fa fa-plus me-2"/>
                    Create Secret
                </button>
            </div>
        </div>
    </t>

</templates>
