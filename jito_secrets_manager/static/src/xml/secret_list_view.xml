<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Standalone button template for the secret_list view.
        Renders directly — no xpath inheritance that could silently fail.
        The "New Secret" button always appears in the layout-buttons slot
        (top-left control panel area), regardless of activeActions.create.
    -->
    <t t-name="jito_secrets_manager.SecretListView.Buttons">
        <div class="o_list_buttons d-flex gap-1 align-items-baseline" role="toolbar">
            <button type="button"
                    class="btn btn-primary"
                    t-on-click="onClickNewSecret">
                New Secret
            </button>
        </div>
    </t>

</templates>
