                            <tr t-if="object.email">
                                <td style="padding:0 16px 4px;">✉️ <a t-att-href="'mailto:%s' % object.email" style="color:#017e84;text-decoration:none;"><t t-out="object.email">contact@example.com</t></a></td>
                            </tr>
                            <tr t-if="object.phone or object.mobile">
                                <td style="padding:0 16px 4px;">📞 <t t-out="object.phone or object.mobile">+00 000 000</t></td>
                            </tr>
