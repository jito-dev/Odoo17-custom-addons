                <tr>
                    <td style="padding:14px 32px;background:#fafbfc;border-top:1px solid #eef0f2;font-size:11px;color:#9aa0a6;border-radius:0 0 6px 6px;">— Sent automatically by Contact Birthday Reminders. You receive this because you are the Account Manager of this contact.</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

