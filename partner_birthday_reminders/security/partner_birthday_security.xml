<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            One role only, on purpose.

            hr_birthday_reminders needs two groups because *being a
            recipient* is an explicit assignment there (the subscription
            roster). Here the audience is derived from data — a contact's
            Account Manager (res.partner.user_id) — so there is nothing
            to grant: every internal user is automatically "responsible"
            for their own contacts and needs no extra role.

            That leaves a single oversight role: someone who can see and
            tune everyone's preferences and read the full reminder log.
        -->
        <record id="module_category_partner_birthday" model="ir.module.category">
            <field name="name">Contact Birthdays</field>
            <field name="description">Oversight of the contact birthday reminder engine.</field>
            <field name="sequence">26</field>
        </record>

        <record id="group_partner_birthday_manager" model="res.groups">
            <field name="name">Contact Birthday Manager</field>
            <field name="category_id" ref="module_category_partner_birthday"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Can read and edit every Account Manager's reminder preferences and read the full reminder log. Does not, by itself, cause any reminder to be received — reminders always follow the contact's Account Manager field.</field>
        </record>

    </data>

    <data noupdate="1">

        <!--
            Record rules.

            Rules attached to the SAME group are OR'd; rules across
            groups are AND'd — hence one rule per group per intent.

            base.group_system is listed on the manager rules from day
            one. Without it an admin who also matches the narrower "own
            rows only" rule is blocked from editing other people's rows,
            with a confusing AccessError on save.
        -->

        <record id="rule_pref_manager_all" model="ir.rule">
            <field name="name">partner.birthday.pref: manager/system full</field>
            <field name="model_id" ref="model_partner_birthday_pref"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_partner_birthday_manager')),
                (4, ref('base.group_system')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            Regular internal users only ever see and touch their own
            preference row. There is no "read all" rule here (unlike the
            HR module, where seeing the roster prevents duplicate
            assignments) — with per-contact routing, other people's
            preferences are simply none of your business.
        -->
        <record id="rule_pref_own" model="ir.rule">
            <field name="name">partner.birthday.pref: own row</field>
            <field name="model_id" ref="model_partner_birthday_pref"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_log_manager_read_all" model="ir.rule">
            <field name="name">partner.birthday.log: manager/system read all</field>
            <field name="model_id" ref="model_partner_birthday_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_partner_birthday_manager')),
                (4, ref('base.group_system')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_log_own_read" model="ir.rule">
            <field name="name">partner.birthday.log: read own rows</field>
            <field name="model_id" ref="model_partner_birthday_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
