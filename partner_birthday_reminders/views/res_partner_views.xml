<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Birthday field on the standard contact form.

        Placed next to Job Position / Title, hidden on companies (a
        company has no birthday, and hiding it keeps the eligibility
        rule visible in the UI itself rather than only in code).
        `next_birthday` sits beside it as a read-only echo so users can
        see at a glance that the reminder engine picked the date up.
    -->
    <record id="view_partner_form_birthday" model="ir.ui.view">
        <field name="name">res.partner.form.birthday</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="title" position="after">
                <field name="birthday" invisible="is_company"/>
                <field name="next_birthday" invisible="is_company or not birthday" readonly="1"/>
                <field name="birthday_eligible" invisible="1"/>
                <field name="has_internal_user" invisible="1"/>
            </field>
        </field>
    </record>

    <!--
        Views for the Birthdays board. They are NOT inherited from the
        standard Contacts views: the board answers a different question
        ("who is coming up?") and must not disturb the Contacts app.
        priority=99 keeps Odoo from ever picking them as the default
        view for res.partner — the action below references them by id.
    -->
    <record id="view_partner_birthday_tree" model="ir.ui.view">
        <field name="name">res.partner.birthday.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Contact Birthdays" create="0" default_order="next_birthday">
                <field name="display_name" string="Contact"/>
                <field name="parent_id" optional="show"/>
                <field name="user_id" string="Account Manager" widget="many2one_avatar_user"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="birthday" optional="hide"/>
                <field name="next_birthday"/>
                <field name="birthday_proximity" widget="badge"
                       decoration-danger="birthday_proximity == '1_today'"
                       decoration-warning="birthday_proximity == '2_tomorrow'"
                       decoration-info="birthday_proximity == '3_this_week'"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_birthday_kanban" model="ir.ui.view">
        <field name="name">res.partner.birthday.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" default_group_by="birthday_proximity"
                    default_order="next_birthday">
                <field name="birthday_proximity"/>
                <field name="next_birthday"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="display_name"/>
                                    </strong>
                                    <div class="text-muted" t-if="record.parent_id.raw_value">
                                        <field name="parent_id"/>
                                    </div>
                                </div>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span>🎂 <field name="next_birthday"/></span>
                                <div t-if="record.email.raw_value" class="text-muted">
                                    <field name="email"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_partner_birthday_calendar" model="ir.ui.view">
        <field name="name">res.partner.birthday.calendar</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!--
                next_birthday is a read-only computed field, so the
                calendar is display-only: no create, no drag-and-drop
                rescheduling (which would try to write it and fail).
            -->
            <calendar string="Contact Birthdays" date_start="next_birthday"
                      mode="month" create="0" event_open_popup="1"
                      color="user_id" hide_time="1">
                <field name="user_id" filters="1" avatar_field="avatar_128"/>
                <field name="email"/>
            </calendar>
        </field>
    </record>

    <record id="view_partner_birthday_search" model="ir.ui.view">
        <field name="name">res.partner.birthday.search</field>
        <field name="model">res.partner</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Contact Birthdays">
                <field name="display_name" string="Contact"/>
                <field name="user_id" string="Account Manager"/>
                <field name="parent_id" string="Company"/>
                <filter name="my_contacts" string="My contacts"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="No account manager"
                        domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('birthday_proximity', '=', '1_today')]"/>
                <filter name="tomorrow" string="Tomorrow"
                        domain="[('birthday_proximity', '=', '2_tomorrow')]"/>
                <filter name="this_week" string="Within 7 days"
                        domain="[('birthday_proximity', 'in', ['1_today', '2_tomorrow', '3_this_week'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_proximity" string="Proximity"
                            context="{'group_by': 'birthday_proximity'}"/>
                    <filter name="group_by_manager" string="Account Manager"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_next_birthday" string="Month"
                            context="{'group_by': 'next_birthday:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_partner_birthdays" model="ir.actions.act_window">
        <field name="name">Contact Birthdays</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,calendar,form</field>
        <field name="search_view_id" ref="view_partner_birthday_search"/>
        <!--
            The domain is the eligibility rule itself: a birthday is set,
            the record is a person, and it is not an Odoo internal user
            (current or archived). Everything else is filtered out before
            it reaches the board.
        -->
        <field name="domain">[('birthday_eligible', '=', True)]</field>
        <field name="context">{'search_default_group_by_proximity': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No contact birthdays yet</p>
            <p>
                Set the <b>Birthday</b> field on a contact and assign an
                <b>Account Manager</b> (the Salesperson field). The manager is
                then reminded 7 days before, 1 day before and on the day.
            </p>
            <p>
                Companies, contacts without a birthday and contacts linked to a
                current or past Odoo user never appear here — colleagues' birthdays
                belong to the HR birthday module.
            </p>
        </field>
    </record>

    <record id="action_partner_birthdays_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_birthday_kanban"/>
        <field name="act_window_id" ref="action_partner_birthdays"/>
    </record>

    <record id="action_partner_birthdays_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_partner_birthday_tree"/>
        <field name="act_window_id" ref="action_partner_birthdays"/>
    </record>

    <record id="action_partner_birthdays_calendar_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_partner_birthday_calendar"/>
        <field name="act_window_id" ref="action_partner_birthdays"/>
    </record>

    <record id="action_partner_birthdays_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_partner_birthdays"/>
    </record>

</odoo>
