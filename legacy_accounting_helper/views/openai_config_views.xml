<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_openai_config_form" model="ir.ui.view">
        <field name="name">openai.config.form</field>
        <field name="model">openai.config</field>
        <field name="arch" type="xml">
            <form string="OpenAI API Configuration">
                <field name="connection_status" invisible="1"/>
                <sheet>
                    <div class="oe_title mb-0">
                        <h2>OpenAI API Configuration</h2>
                    </div>

                    <!-- Status badge -->
                    <div class="mb-4">
                        <span class="badge rounded-pill bg-secondary"
                              invisible="connection_status != 'untested'">
                            Not Tested
                        </span>
                        <span class="badge rounded-pill bg-success"
                              invisible="connection_status != 'ok'">
                            &#10003; Connected
                        </span>
                        <span class="badge rounded-pill bg-danger"
                              invisible="connection_status != 'failed'">
                            &#10007; Failed
                        </span>
                    </div>

                    <group>
                        <group string="API Settings">
                            <field name="company_id" readonly="1"/>
                            <field name="api_key"
                                   password="True"
                                   placeholder="sk-…"/>
                            <field name="model_name"/>
                        </group>
                    </group>

                    <div class="mt-3 mb-3">
                        <button name="action_test_connection"
                                string="Test Connection"
                                type="object"
                                class="btn btn-primary"
                                icon="fa-plug"/>
                    </div>

                    <!-- Test result panel -->
                    <div invisible="not test_result">
                        <div class="alert alert-success mb-0" role="alert"
                             invisible="connection_status != 'ok'">
                            <strong>Connection successful</strong>
                            <pre class="mb-0 mt-2" style="font-size:13px;white-space:pre-wrap;">
                                <field name="test_result" readonly="1" nolabel="1"/>
                            </pre>
                        </div>
                        <div class="alert alert-danger mb-0" role="alert"
                             invisible="connection_status != 'failed'">
                            <strong>Connection failed</strong>
                            <pre class="mb-0 mt-2" style="font-size:13px;white-space:pre-wrap;">
                                <field name="test_result" readonly="1" nolabel="1"/>
                            </pre>
                        </div>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted" style="font-size:0.85rem;">
                            Get your API key at
                            <strong>platform.openai.com/api-keys</strong>.
                            The key is stored in the database — treat this record with
                            appropriate access controls.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action: get-or-create singleton and open form -->
    <record id="action_open_openai_config" model="ir.actions.server">
        <field name="name">Open OpenAI API Configuration</field>
        <field name="model_id" ref="model_openai_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>
</odoo>
