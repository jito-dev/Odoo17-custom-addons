<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ───────────────────────────────────────────────────────────── -->
    <record id="view_revolut_transaction_search" model="ir.ui.view">
        <field name="name">revolut.transaction.search</field>
        <field name="model">revolut.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <field name="description" string="Description"/>
                <field name="merchant_name" string="Merchant"/>
                <field name="reference" string="Reference"/>
                <field name="revolut_id" string="Revolut ID"/>
                <field name="revolut_tx_ref" string="TX Ref"/>
                <field name="account_name" string="Account"/>
                <field name="transfer_other_account_id" string="Other Account ID"/>
                <field name="currency" string="Currency"/>

                <!-- State filters -->
                <filter name="state_completed" string="Completed"
                        domain="[('state','=','completed')]"/>
                <filter name="state_pending" string="Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="state_declined" string="Declined / Failed"
                        domain="[('state','in',['declined','failed','reverted'])]"/>

                <separator/>

                <!-- Injection filters -->
                <filter name="filter_injected" string="Injected to Accounting"
                        domain="[('is_injected','=',True)]"/>
                <filter name="filter_not_injected" string="Not Injected"
                        domain="[('is_injected','=',False)]"/>

                <separator/>

                <!-- Vendor bill filters -->
                <filter name="filter_has_bill" string="Has Vendor Bill"
                        domain="[('vendor_bill_id','!=',False)]"/>
                <filter name="filter_no_bill" string="No Vendor Bill"
                        domain="[('vendor_bill_id','=',False)]"/>

                <separator/>

                <!-- Type filters -->
                <filter name="type_card" string="Card Payments"
                        domain="[('transaction_type','in',['card_payment','card_refund','card_chargeback','card_credit'])]"/>
                <filter name="type_transfer" string="Transfers"
                        domain="[('transaction_type','=','transfer')]"/>
                <filter name="type_exchange" string="Exchanges"
                        domain="[('transaction_type','=','exchange')]"/>
                <filter name="type_topup" string="Top-ups"
                        domain="[('transaction_type','in',['topup','topup_return'])]"/>
                <filter name="type_fee" string="Fees / Tax"
                        domain="[('transaction_type','in',['fee','tax','tax_refund'])]"/>
                <filter name="type_internal_transfer" string="Internal Transfers"
                        domain="[('transfer_between_accounts','=',True)]"/>
                <filter name="type_fcf" string="FCF (Cash Funds)"
                        domain="[('transaction_type','in',['fcf_buy','fcf_sell','fcf_interest','fcf_fee'])]"/>
                <filter name="filter_synthetic" string="Synthetic (Fees)"
                        domain="[('is_synthetic','=',True)]"/>

                <separator/>

                <!-- Source filters -->
                <filter name="source_api" string="API Transactions"
                        domain="[('source','=','api')]"/>
                <filter name="source_csv" string="CSV Imported"
                        domain="[('source','=','csv')]"/>

                <separator/>

                <filter name="filter_date_local" string="Settlement Date (Local)" date="settlement_date_local"/>
                <filter name="filter_date_utc" string="Settlement Date (UTC)" date="settlement_date"/>

                <group expand="0" string="Group By">
                    <filter name="group_type"     string="Type"            context="{'group_by': 'transaction_type'}"/>
                    <filter name="group_state"    string="State"           context="{'group_by': 'state'}"/>
                    <filter name="group_currency" string="Currency"        context="{'group_by': 'currency'}"/>
                    <filter name="group_account"  string="Account"         context="{'group_by': 'account_name'}"/>
                    <filter name="group_other_account" string="Other Account ID" context="{'group_by': 'transfer_other_account_id'}"/>
                    <filter name="group_source"   string="Source"          context="{'group_by': 'source'}"/>
                    <filter name="group_country"  string="Merchant Country" context="{'group_by': 'merchant_country'}"/>
                    <separator/>
                    <filter name="group_month_local" string="Month (Local)" context="{'group_by': 'settlement_date_local:month'}"/>
                    <filter name="group_year_local"  string="Year (Local)"  context="{'group_by': 'settlement_date_local:year'}"/>
                    <separator/>
                    <filter name="group_month_utc" string="Month (UTC)"    context="{'group_by': 'settlement_date:month'}"/>
                    <filter name="group_year_utc"  string="Year (UTC)"     context="{'group_by': 'settlement_date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Tree ─────────────────────────────────────────────────────────────── -->
    <record id="view_revolut_transaction_tree" model="ir.ui.view">
        <field name="name">revolut.transaction.tree</field>
        <field name="model">revolut.transaction</field>
        <field name="arch" type="xml">
            <tree string="Revolut Transactions" default_order="created_at desc"
                  decoration-success="state == 'completed'"
                  decoration-warning="state in ('pending', 'created')"
                  decoration-danger="state in ('declined', 'failed', 'reverted')">
                <header>
                    <button name="action_sync_all_from_revolut"
                            string="Sync All from Revolut"
                            type="object"
                            class="btn-primary"
                            display="always"
                            icon="fa-refresh"/>
                    <button name="action_reindex_accounts"
                            string="Reindex Accounts"
                            type="object"
                            class="btn-secondary"
                            display="always"
                            icon="fa-link"/>
                </header>
                <field name="revolut_id"            string="TX ID"               optional="hide"/>
                <field name="revolut_tx_ref"        string="TX Ref"              optional="hide"/>
                <field name="settlement_date_local" string="Settlement Date (Local)" optional="show"/>
                <field name="settlement_date"   string="Settlement Date (UTC)" optional="hide"/>
                <field name="settlement_datetime_utc" string="Settlement Timestamp (UTC)" optional="hide"/>
                <field name="transaction_type"  string="Type"        optional="show"/>
                <field name="state"             string="State"       widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state in ('pending', 'created')"
                       decoration-danger="state in ('declined', 'failed', 'reverted')"
                       optional="show"/>
                <field name="source"            string="Source"      widget="badge"
                       decoration-info="source == 'csv'"
                       decoration-success="source == 'api'"
                       optional="show"/>
                <field name="is_synthetic"      string="Synthetic"   widget="boolean"
                       optional="hide" readonly="1"/>
                <field name="description"       string="Description" optional="show"/>
                <field name="merchant_name"     string="Merchant"    optional="show"/>
                <field name="merchant_country"  string="Country"     optional="hide"/>
                <field name="amount"            string="Amount"      optional="show"/>
                <field name="tx_fee"            string="Fee"         optional="hide"/>
                <field name="currency"          string="Currency"    optional="show"/>
                <field name="balance_after"     string="Balance"     optional="hide"/>
                <field name="account_name"      string="Account"     optional="show"/>
                <field name="account_revolut_id" string="Account ID"  optional="hide"/>
                <field name="transfer_between_accounts" string="Int. Transfer"
                       widget="boolean" optional="hide" readonly="1"/>
                <field name="transfer_other_account_id" string="Other Account ID"
                       optional="hide" readonly="1"/>
                <field name="reference"                 string="Reference"   optional="hide"/>
                <field name="reason_code"               string="Reason"      optional="hide"/>
                <field name="invoice_attachment_count"  string="Receipts"    optional="hide"
                       decoration-success="invoice_attachment_count &gt; 0"
                       decoration-muted="invoice_attachment_count == 0"/>
                <field name="receipt_list_html"  string="Receipt"     optional="show"
                       widget="html" readonly="1"/>
                <field name="is_injected" string="Accounting" widget="boolean"
                       optional="show" readonly="1"
                       decoration-success="is_injected"
                       decoration-muted="not is_injected"/>
                <field name="has_vendor_bill" string="Bill" widget="boolean"
                       optional="hide" readonly="1"
                       decoration-success="has_vendor_bill"
                       decoration-muted="not has_vendor_bill"/>
            </tree>
        </field>
    </record>

    <!-- ── Form ─────────────────────────────────────────────────────────────── -->
    <record id="view_revolut_transaction_form" model="ir.ui.view">
        <field name="name">revolut.transaction.form</field>
        <field name="model">revolut.transaction</field>
        <field name="arch" type="xml">
            <form string="Revolut Transaction" create="false">
                <header>
                    <field name="is_injected" invisible="1"/>
                    <field name="has_vendor_bill" invisible="1"/>
                    <field name="invoice_attachment_count" invisible="1"/>
                    <field name="is_bill_reconciled" invisible="1"/>
                    <!-- Accounting injection -->
                    <button name="action_inject_to_accounting"
                            string="Inject to Accounting"
                            type="object"
                            class="btn-primary"
                            icon="fa-arrow-right"
                            invisible="is_injected or state != 'completed'"/>
                    <button name="action_remove_from_accounting"
                            string="Remove from Accounting"
                            type="object"
                            class="btn-secondary"
                            icon="fa-undo"
                            invisible="not is_injected"/>
                    <!-- Vendor bill creation -->
                    <button name="action_create_vendor_bill"
                            string="Create Bill &amp; Reconcile"
                            type="object"
                            class="btn-primary"
                            icon="fa-magic"
                            invisible="has_vendor_bill or invoice_attachment_count == 0"/>
                    <button name="action_create_draft_vendor_bill"
                            string="Create Draft Bill"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-text-o"
                            invisible="has_vendor_bill or invoice_attachment_count == 0"/>
                    <!-- Reconciliation & navigation -->
                    <button name="action_reconcile_vendor_bill"
                            string="Reconcile Bill"
                            type="object"
                            class="btn-primary"
                            icon="fa-check-square-o"
                            invisible="not has_vendor_bill or not is_injected or is_bill_reconciled"/>
                    <button name="action_open_vendor_bill"
                            string="Open Bill"
                            type="object"
                            class="btn-link"
                            icon="fa-external-link"
                            invisible="not has_vendor_bill"/>
                </header>
                <sheet>
                    <group>
                        <group string="Transaction">
                            <field name="revolut_id"        string="Revolut ID"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'completed'"
                                   decoration-warning="state in ('pending', 'created')"
                                   decoration-danger="state in ('declined', 'failed', 'reverted')"/>
                            <field name="transaction_type"  string="Type"/>
                            <field name="amount"/>
                            <field name="currency"/>
                            <field name="description"/>
                            <field name="reference"/>
                            <field name="reason_code"/>
                            <field name="related_transaction_id" string="Related Transaction"/>
                            <field name="statement_line_id" string="Statement Line"
                                   readonly="1" invisible="not is_injected"/>
                            <field name="vendor_bill_id" string="Vendor Bill"
                                   readonly="1" invisible="not has_vendor_bill"/>
                        </group>
                        <group string="Timing">
                            <field name="created_at"/>
                            <field name="updated_at"/>
                            <field name="completed_at"/>
                            <field name="scheduled_for"/>
                        </group>
                    </group>
                    <group>
                        <group string="Account">
                            <field name="account_map_id" string="Account"
                                   invisible="not account_map_id"/>
                            <field name="account_name"
                                   invisible="account_map_id"/>
                            <field name="account_revolut_id" string="Account ID"/>
                            <field name="source" widget="badge"
                                   decoration-info="source == 'csv'"
                                   decoration-success="source == 'api'"/>
                            <field name="company_id"/>
                            <field name="transfer_between_accounts" invisible="1"/>
                            <field name="transfer_other_account_map_id"
                                   string="Transfer To/From"
                                   invisible="not transfer_between_accounts or not transfer_other_account_map_id"/>
                            <field name="transfer_other_account_name"
                                   string="Transfer To/From"
                                   invisible="not transfer_between_accounts or transfer_other_account_map_id"/>
                            <field name="transfer_other_account_id"
                                   string="Other Account ID"
                                   invisible="not transfer_between_accounts"/>
                        </group>
                        <group string="Merchant" invisible="not merchant_name">
                            <field name="merchant_name"/>
                            <field name="merchant_city"/>
                            <field name="merchant_country"/>
                            <field name="merchant_category_code" string="MCC"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Supporting Documents" name="supporting_docs">

                            <!-- Hidden fields required for invisible expressions -->
                            <field name="receipt_is_pdf" invisible="1"/>
                            <field name="google_user_connected" invisible="1"/>
                            <field name="gmail_search_performed" invisible="1"/>
                            <field name="gmail_search_results_count" invisible="1"/>
                            <field name="revolut_fetch_performed" invisible="1"/>
                            <field name="revolut_fetched_count" invisible="1"/>

                            <!-- ── Attached Documents ─────────────────────── -->
                            <div class="o_horizontal_separator mb-2">Attached Documents</div>

                            <!-- Receipt preview -->
                            <div class="text-center mb-3" invisible="not receipt_preview">
                                <field name="receipt_preview"
                                       widget="image"
                                       options="{'size': [400, 600]}"
                                       readonly="1"
                                       nolabel="1"
                                       style="max-width:400px; max-height:600px; object-fit:contain; border:1px solid #dee2e6; border-radius:4px;"/>
                                <div class="text-muted small mt-1">
                                    <field name="receipt_preview_filename" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                            <div class="mb-3" invisible="not receipt_is_pdf">
                                <button name="action_open_receipt_pdf"
                                        string="Open PDF Receipt"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-file-pdf-o"/>
                            </div>

                            <field name="invoice_attachment_ids"
                                   widget="many2many_binary"
                                   nolabel="1"
                                   string="Attached Invoice/Bill"/>

                            <!-- ── Revolut Receipts ───────────────────────── -->
                            <div class="o_horizontal_separator mt-4 mb-2 d-flex align-items-center gap-2">
                                <img src="/legacy_accounting_helper/static/src/img/Revolu_icon.png"
                                     style="height:20px;width:20px;object-fit:contain;"/>
                                Revolut Receipts
                            </div>
                            <div class="mb-2 d-flex gap-2">
                                <button name="action_fetch_revolut_staged"
                                        string="Fetch from Revolut"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-cloud-download"/>
                            </div>

                            <div class="alert alert-info mb-2"
                                 invisible="not revolut_fetch_performed or revolut_fetched_count != 0">
                                No receipts found in Revolut for this transaction.
                            </div>

                            <field name="revolut_fetched_receipt_ids"
                                   nolabel="1"
                                   invisible="revolut_fetched_count == 0">
                                <tree create="false" delete="false" editable="false">
                                    <field name="name" string="Filename"/>
                                    <field name="mime_type" string="Type" optional="hide"/>
                                    <field name="is_attached" widget="boolean"
                                           string="Attached" readonly="1"/>
                                    <button name="action_preview"
                                            string="Preview"
                                            type="object"
                                            icon="fa-eye"
                                            class="btn-secondary btn-sm"/>
                                    <button name="action_attach"
                                            string="Attach"
                                            type="object"
                                            icon="fa-paperclip"
                                            class="btn-primary btn-sm"
                                            invisible="is_attached"/>
                                    <button name="action_attach"
                                            string="Re-attach"
                                            type="object"
                                            icon="fa-refresh"
                                            class="btn-secondary btn-sm"
                                            invisible="not is_attached"/>
                                </tree>
                            </field>

                            <!-- ── Gmail Lookup ───────────────────────────── -->
                            <div class="o_horizontal_separator mt-4 mb-2 d-flex align-items-center gap-2">
                                <img src="/legacy_accounting_helper/static/src/img/Gmail_icon.png"
                                     style="height:20px;width:20px;object-fit:contain;"/>
                                Gmail Lookup
                            </div>

                            <!-- Not connected warning -->
                            <div class="alert alert-warning mt-2"
                                 invisible="google_user_connected">
                                Connect your Google account first:
                                <i>Revolut Business API Integration → Google / Gmail Setup</i>
                            </div>

                            <!-- Search inputs (when connected) -->
                            <group invisible="not google_user_connected">
                                <group>
                                    <field name="gmail_search_keywords"
                                           placeholder="invoice payment Slack…"/>
                                    <field name="gmail_search_date"/>
                                    <field name="gmail_search_range"/>
                                </group>
                                <group>
                                    <field name="gmail_search_with_attachment"
                                           widget="boolean_toggle"/>
                                </group>
                            </group>
                            <div class="mb-3 d-flex gap-2"
                                 invisible="not google_user_connected">
                                <button name="action_gmail_search"
                                        string="Search Gmail"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-search"/>
                                <button name="action_gmail_clear"
                                        string="Clear"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-times"
                                        invisible="not gmail_search_performed"/>
                                <button name="action_ai_analyze"
                                        string="AI Analyze"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-magic"
                                        invisible="gmail_search_results_count == 0"/>
                            </div>

                            <!-- Email cards HTML -->
                            <field name="gmail_search_results_html"
                                   widget="html"
                                   readonly="1"
                                   nolabel="1"
                                   invisible="not gmail_search_performed"/>

                            <!-- Found attachments tree -->
                            <field name="gmail_found_attachment_ids"
                                   nolabel="1"
                                   invisible="gmail_search_results_count == 0">
                                <tree create="false" delete="false" editable="false"
                                      decoration-success="is_ai_selected">
                                    <field name="is_ai_selected" string="AI" widget="boolean" readonly="1"/>
                                    <field name="ai_selection_reason" string="AI Reason" optional="show" readonly="1"/>
                                    <field name="email_from" string="From"/>
                                    <field name="email_subject" string="Subject"/>
                                    <field name="email_date" string="Email Date"/>
                                    <field name="name" string="Filename"/>
                                    <field name="mime_type" string="Type" optional="hide"/>
                                    <field name="size_display" string="Size"/>
                                    <field name="is_attached" widget="boolean"
                                           string="Attached" readonly="1"/>
                                    <button name="action_preview"
                                            string="Preview"
                                            type="object"
                                            icon="fa-eye"
                                            class="btn-secondary btn-sm"/>
                                    <button name="action_attach"
                                            string="Attach"
                                            type="object"
                                            icon="fa-paperclip"
                                            class="btn-primary btn-sm"
                                            invisible="is_attached"/>
                                    <button name="action_attach"
                                            string="Re-attach"
                                            type="object"
                                            icon="fa-refresh"
                                            class="btn-secondary btn-sm"
                                            invisible="not is_attached"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Legs" name="legs">
                            <field name="leg_ids" nolabel="1">
                                <tree string="Legs" create="false" edit="false">
                                    <field name="leg_id"                    string="Leg ID"/>
                                    <field name="amount"/>
                                    <field name="currency"/>
                                    <field name="fee"/>
                                    <field name="bill_amount"               optional="hide"/>
                                    <field name="bill_currency"             optional="hide"/>
                                    <field name="balance"                   string="Balance After"/>
                                    <field name="description"/>
                                    <field name="account_id"                string="Account ID"/>
                                    <field name="counterparty_id"           optional="hide"/>
                                    <field name="counterparty_account_type" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Raw JSON" name="raw_json">
                            <field name="raw_json" widget="text" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Server action: batch fetch from Revolut (appears in ⚙ Actions menu) -->
    <record id="action_server_fetch_revolut_attachments" model="ir.actions.server">
        <field name="name">Fetch Attachments from Revolut</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_fetch_revolut_attachments()</field>
    </record>

    <!-- ── Server action: batch inject to accounting (appears in ⚙ Actions menu) -->
    <record id="action_server_inject_to_accounting" model="ir.actions.server">
        <field name="name">Inject to Accounting</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_inject_to_accounting()</field>
    </record>

    <!-- ── Server action: batch remove from accounting (appears in ⚙ Actions menu) -->
    <record id="action_server_remove_from_accounting" model="ir.actions.server">
        <field name="name">Remove from Accounting</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_remove_from_accounting()</field>
    </record>

    <!-- ── Server action: batch create vendor bills & reconcile (appears in ⚙ Actions menu) -->
    <record id="action_server_create_vendor_bills" model="ir.actions.server">
        <field name="name">Create Bills &amp; Reconcile</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_vendor_bill()</field>
    </record>

    <!-- ── Server action: batch create draft vendor bills (appears in ⚙ Actions menu) -->
    <record id="action_server_create_draft_vendor_bills" model="ir.actions.server">
        <field name="name">Create Draft Bills</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_draft_vendor_bill()</field>
    </record>

    <!-- ── Server action: batch reconcile vendor bills (appears in ⚙ Actions menu) -->
    <record id="action_server_reconcile_vendor_bills" model="ir.actions.server">
        <field name="name">Reconcile Bills</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_reconcile_vendor_bill()</field>
    </record>

    <!-- ── Server action: batch remove attachments (appears in ⚙ Actions menu) -->
    <record id="action_server_remove_attachments" model="ir.actions.server">
        <field name="name">Remove Attachments</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_remove_attachments()</field>
    </record>

    <!-- ── Server action: batch delete transactions (appears in ⚙ Actions menu) -->
    <record id="action_server_delete_transactions" model="ir.actions.server">
        <field name="name">Delete Transactions</field>
        <field name="model_id" ref="model_revolut_transaction"/>
        <field name="binding_model_id" ref="model_revolut_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_delete_transactions()</field>
    </record>

    <!-- ── Window action ────────────────────────────────────────────────────── -->
    <record id="action_revolut_helper_transactions" model="ir.actions.act_window">
        <field name="name">Revolut Transactions</field>
        <field name="res_model">revolut.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_revolut_transaction_search"/>
        <field name="context">{'search_default_state_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transactions yet</p>
            <p>Click <strong>Sync All from Revolut</strong> to download all transactions.</p>
        </field>
    </record>

    <!-- ── Window action: Income View (amount > 0, hard domain) ─────────────── -->
    <record id="action_revolut_income_view" model="ir.actions.act_window">
        <field name="name">Income Transactions</field>
        <field name="res_model">revolut.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_revolut_transaction_search"/>
        <field name="domain">[('amount', '&gt;', 0)]</field>
        <field name="context">{'search_default_state_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No income transactions found</p>
            <p>Income transactions (positive amounts) will appear here once synced.</p>
        </field>
    </record>

    <!-- ── Extend Journal Items tree: optional Revolut TX ID column ─────── -->
    <record id="view_move_line_tree_revolut_tx_ref" model="ir.ui.view">
        <field name="name">account.move.line.tree.revolut.tx.ref</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='matching_number']" position="after">
                <field name="revolut_tx_ref" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
