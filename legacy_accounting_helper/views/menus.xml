<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action: get-or-create singleton and open form -->
    <record id="action_open_legacy_config" model="ir.actions.server">
        <field name="name">Open Revolut Business API Integration</field>
        <field name="model_id" ref="model_legacy_accounting_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>

    <!-- Top-level application menu — visible to accountant and income reviewer -->
    <menuitem id="menu_legacy_accounting_root"
              name="Revolut Business API Integration"
              web_icon="legacy_accounting_helper,static/description/icon.png"
              sequence="100"
              groups="legacy_accounting_helper.group_revolut_accountant,legacy_accounting_helper.group_revolut_income_reviewer"/>

    <!-- Explicitly clear any stale action_id left on the root menu from older module versions -->
    <record id="menu_legacy_accounting_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <!-- Sub-menu: Expenses Matching (transactions) — accountant only -->
    <menuitem id="menu_revolut_helper_tool"
              name="Expenses Matching"
              parent="menu_legacy_accounting_root"
              action="legacy_accounting_helper.action_revolut_helper_transactions"
              sequence="10"
              groups="legacy_accounting_helper.group_revolut_accountant"/>

    <!-- Sub-menu: Income View — accountant and income reviewer -->
    <menuitem id="menu_revolut_income_view"
              name="Income View"
              parent="menu_legacy_accounting_root"
              action="legacy_accounting_helper.action_revolut_income_view"
              sequence="20"
              groups="legacy_accounting_helper.group_revolut_accountant,legacy_accounting_helper.group_revolut_income_reviewer"/>

    <!-- Sub-menu: Flexible Cash Funds — accountant only -->
    <menuitem id="menu_fcf_accounts"
              name="Flexible Cash Funds"
              parent="menu_legacy_accounting_root"
              action="legacy_accounting_helper.action_fcf_accounts"
              sequence="30"
              groups="legacy_accounting_helper.group_revolut_accountant"/>

    <!-- Sub-menu: Configuration — Administrator only -->
    <menuitem id="menu_legacy_configuration"
              name="Configuration"
              parent="menu_legacy_accounting_root"
              sequence="90"
              groups="legacy_accounting_helper.group_revolut_admin"/>

    <!-- Sub-menu: Revolut Business API Integration (under Configuration) -->
    <menuitem id="menu_legacy_revolut_config"
              name="Revolut Business API Integration"
              parent="menu_legacy_configuration"
              action="action_open_legacy_config"
              sequence="10"/>

    <!-- Sub-menu: Google / Gmail Setup (under Configuration) -->
    <menuitem id="menu_google_gmail_setup"
              name="Google / Gmail Setup"
              parent="menu_legacy_configuration"
              action="legacy_accounting_helper.action_google_account_manager"
              sequence="20"/>

    <!-- Sub-menu: OpenAI Configuration (under Configuration) -->
    <menuitem id="menu_openai_config"
              name="OpenAI Configuration"
              parent="menu_legacy_configuration"
              action="legacy_accounting_helper.action_open_openai_config"
              sequence="30"/>

    <!-- Sub-menu: Revolut Account Mappings (under Configuration) -->
    <menuitem id="menu_revolut_account_mappings"
              name="Revolut Account Mappings"
              parent="menu_legacy_configuration"
              action="legacy_accounting_helper.action_revolut_account_journal_map"
              sequence="15"/>

    <!-- Server action: open timezone config form -->
    <record id="action_open_timezone_config" model="ir.actions.server">
        <field name="name">Timezone Configuration</field>
        <field name="model_id" ref="model_legacy_accounting_config"/>
        <field name="state">code</field>
        <field name="code">
record = model.sudo().search([('company_id', '=', env.company.id)], limit=1)
if not record:
    record = model.sudo().create({'company_id': env.company.id})
action = {
    'type': 'ir.actions.act_window',
    'name': 'Timezone Configuration',
    'res_model': 'legacy.accounting.config',
    'res_id': record.id,
    'view_mode': 'form',
    'view_id': env.ref('legacy_accounting_helper.view_legacy_accounting_config_timezone_form').id,
    'target': 'current',
}
        </field>
    </record>

    <!-- Sub-menu: Timezone (under Configuration) -->
    <menuitem id="menu_timezone_config"
              name="Timezone"
              parent="menu_legacy_configuration"
              action="action_open_timezone_config"
              sequence="40"/>
</odoo>
