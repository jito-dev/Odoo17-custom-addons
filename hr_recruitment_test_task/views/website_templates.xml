<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_test_submission" name="Test Task Submission">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-primary text-white p-4">
                                <h3 class="mb-0">Technical Test Submission</h3>
                                <p class="mb-0 opacity-75">Candidate: <t t-esc="applicant.partner_name"/></p>
                            </div>
                            <div class="card-body p-4">
                                <!-- Instructions -->
                                <div class="alert alert-light border mb-4">
                                    <h5><i class="fa fa-info-circle text-primary"></i> Instructions</h5>
                                    <p class="mb-0 text-muted">Please provide the link to your public GitHub repository containing the solution. You can add notes if necessary.</p>
                                </div>

                                <!-- History Table (Resubmit feature) -->
                                <t t-if="previous_submissions">
                                    <div class="mb-4">
                                        <h6 class="text-muted text-uppercase fw-bold">Previous Submissions</h6>
                                        <div class="list-group">
                                            <t t-foreach="previous_submissions" t-as="sub">
                                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <span class="badge bg-secondary me-2">v<t t-esc="sub.version"/></span>
                                                        <a t-att-href="sub.github_link" target="_blank" class="text-decoration-none">
                                                            <i class="fa fa-github"></i> <t t-esc="sub.github_link"/>
                                                        </a>
                                                    </div>
                                                    <small class="text-muted"><span t-field="sub.create_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></small>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                    <hr/>
                                </t>

                                <!-- Submission Form -->
                                <h5 class="mb-3">New Submission</h5>
                                <form action="/test-task/submit" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="token" t-att-value="token"/>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">GitHub Repository Link <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fa fa-github"></i></span>
                                            <input type="url" name="github_link" class="form-control" required="required" placeholder="https://github.com/username/repo"/>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Additional Notes</label>
                                        <textarea name="additional_info" class="form-control" rows="4" placeholder="Any comments about your implementation..."></textarea>
                                    </div>

                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fa fa-paper-plane"></i> Submit Result
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="template_thank_you" name="Thank You">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5 text-center">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 p-5">
                            <div class="text-success mb-3">
                                <i class="fa fa-check-circle fa-5x"></i>
                            </div>
                            <h1 class="mb-3">Received!</h1>
                            <p class="lead text-muted">Your test task has been successfully submitted. Our team has been notified and will review your code shortly.</p>
                            <div class="mt-4">
                                <a href="/" class="btn btn-outline-primary">Return to Home</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>