<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_job_stage_config_hide_confirm_form" model="ir.ui.view">
        <field name="name">hr.job.stage.config.hide.confirm.form</field>
        <field name="model">hr.job.stage.config.hide.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm hide stage">
                <group>
                    <field name="config_id" invisible="1"/>
                    <field name="applicant_count" readonly="1"/>
                    <field name="stage_name" readonly="1"/>
                    <field name="job_name" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    <p>
                        The applicants currently on this stage will <strong>NOT</strong>
                        be deleted. They keep their position and stay reachable via the
                        "Show hidden" kanban filter and the job's Stages tab.
                    </p>
                    <p>Hide the stage anyway?</p>
                </div>
                <footer>
                    <button name="action_confirm_hide"
                            type="object"
                            string="Yes, hide stage"
                            class="btn-warning"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
