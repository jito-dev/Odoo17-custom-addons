<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Settles cancellations whose grace window has passed.

            Applicants reach it two ways and it needs both. `_trigger(at=...)`
            queues a one-shot run right after each cancellation's window, which
            is what makes a genuine cancellation surface in minutes rather than
            at the top of the next hour. The interval below is the safety net:
            the sweep selects its work from applicant STATE, not from a queue,
            so a trigger lost to a rollback, a restart or a restore costs a
            delay and nothing else.

            noupdate="1" so a module upgrade never resets an interval somebody
            tuned, nor re-enables a cron somebody deliberately stopped.
        -->
        <record id="ir_cron_call_stage_confirm_cancellations" model="ir.cron">
            <field name="name">Call Stage: settle cancelled bookings</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="state">code</field>
            <field name="code">model._cron_call_stage_confirm_cancellations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
