<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bridge: surface the booked Google Meet link and the live booking
        slot in the Call Scheduling cockpit, and let attended/no-show apply
        to a rescheduled (still-booked) call.
    -->
    <record id="hr_applicant_view_form_call_meet" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.call.meet</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id"
               ref="hr_recruitment_call_stage.hr_applicant_view_form_call_stage"/>
        <field name="arch" type="xml">
            <!-- Live booked slot next to the status. Also shown once the
                 booking is cancelled: that slot is the first thing a recruiter
                 needs in order to decide what to do next, and the status chip
                 beside it already says the call is gone. -->
            <xpath expr="//field[@name='call_outcome']" position="after">
                <field name="call_booked_start" readonly="1"
                       string="Booked slot"
                       invisible="call_status not in ('booked', 'rescheduled', 'attended', 'no_show', 'cancelled')"/>
                <!-- The source, never the person: Odoo archives a cancelled
                     booking as the organiser even when the candidate clicked,
                     so naming a user here would accuse the wrong colleague. -->
                <field name="call_cancel_source" readonly="1"
                       invisible="call_status != 'cancelled'"/>
            </xpath>

            <!-- A cancelled call left the cockpit with NO action at all: the
                 recruiter was handed a to-do saying "decide" and no button to
                 decide with. The invite and its link are still live, so
                 sending it again is the one move that needs no new record. -->
            <xpath expr="//button[@name='action_resend_invite_email']" position="attributes">
                <attribute name="invisible">call_status not in ('sent', 'cancelled')</attribute>
            </xpath>

            <!-- Where the call actually happens -->
            <xpath expr="//page[@name='call_scheduling_page']/group[1]" position="after">
                <group>
                    <group string="Meeting">
                        <field name="meet_url" widget="url" readonly="1"
                               string="Google Meet"
                               placeholder="Available once the candidate books a slot"/>
                    </group>
                </group>
                <!-- Button on its own left-aligned row (not inside the group
                     grid, where it rendered shifted into the value column). -->
                <div class="o_row mt-1 mb-2" name="call_join_bar">
                    <button name="action_join_call"
                            string="Join call"
                            type="object"
                            class="btn-primary px-4"
                            icon="fa-video-camera"
                            invisible="not meet_url"/>
                </div>
            </xpath>

            <!-- A rescheduled call is still a booked call: allow outcomes.
                 Each outcome button also stays visible in the OPPOSITE
                 terminal state so the recruiter can correct a mis-click
                 (attended <-> no-show) now that call_outcome is read-only. -->
            <xpath expr="//button[@name='action_mark_attended']" position="attributes">
                <attribute name="invisible">call_status not in ('booked', 'rescheduled', 'no_show')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_mark_no_show']" position="attributes">
                <attribute name="invisible">call_status not in ('booked', 'rescheduled', 'attended')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kanban badges for the two new lifecycle states -->
    <record id="hr_applicant_view_kanban_call_meet" model="ir.ui.view">
        <field name="name">hr.applicant.view.kanban.call.meet</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id"
               ref="hr_recruitment_call_stage.hr_applicant_view_kanban_call_status"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]" position="inside">
                <div class="o_kanban_inline_block ms-2"
                     t-if="record.call_scheduling_visible.raw_value">
                    <span t-if="record.call_status.raw_value == 'rescheduled'"
                          class="badge text-bg-success"
                          title="Slot rescheduled by candidate">
                        <i class="fa fa-calendar"/> Rescheduled
                    </span>
                    <span t-if="record.call_status.raw_value == 'cancelled'"
                          class="badge text-bg-danger"
                          title="Booking cancelled">
                        <i class="fa fa-ban"/> Cancelled
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
