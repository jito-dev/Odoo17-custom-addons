<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jito.public.holiday.timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project_timesheet_holidays.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
                Append a "Public Holidays Task" row directly below the existing
                "Task" (leave_timesheet_task_id) row that is rendered inside the
                project_timesheet_holidays settings block.
            -->
            <xpath expr="//field[@name='leave_timesheet_task_id']/.." position="after">
                <div class="w-100">
                    <label string="Public Holidays Task"
                           for="public_holiday_timesheet_task_id"
                           class="col-2 col-lg-3"/>
                    <field name="public_holiday_timesheet_task_id"
                           context="{'active_test': False, 'default_project_id': internal_project_id}"
                           class="oe_inline ml16"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
