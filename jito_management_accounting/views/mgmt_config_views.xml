<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_config_form" model="ir.ui.view">
        <field name="name">mgmt.config.form</field>
        <field name="model">mgmt.config</field>
        <field name="arch" type="xml">
            <form string="Management Accounting Settings" create="false" delete="false">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="default_currency_id"/>
                        </group>
                        <group string="Ingestion Defaults">
                            <field name="auto_ingest_posted_only"/>
                            <field name="auto_ingest_reconciled_only"/>
                        </group>
                    </group>
                    <group>
                        <group string="Journal Entry Defaults">
                            <field name="default_receivable_account_id"/>
                            <field name="default_payable_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmt_config_server" model="ir.actions.server">
        <field name="name">Settings</field>
        <field name="model_id" ref="model_mgmt_config"/>
        <field name="state">code</field>
        <field name="code">action = env['mgmt.config'].action_open_settings()</field>
    </record>
</odoo>
