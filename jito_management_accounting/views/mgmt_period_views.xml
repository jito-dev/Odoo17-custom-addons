<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_period_tree" model="ir.ui.view">
        <field name="name">mgmt.period.tree</field>
        <field name="model">mgmt.period</field>
        <field name="arch" type="xml">
            <tree string="Periods" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
                <field name="source_line_count" string="Sources"/>
                <field name="ledger_line_count" string="Ledger"/>
                <field name="lock_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_period_form" model="ir.ui.view">
        <field name="name">mgmt.period.form</field>
        <field name="model">mgmt.period</field>
        <field name="arch" type="xml">
            <form string="Management Period">
                <header>
                    <button name="action_open" string="Open Period" type="object"
                            invisible="state != 'draft'" class="oe_highlight"
                            help="Makes this period editable. You can then ingest data and run classification."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="%(jito_management_accounting.action_mgmt_ingest_wizard)d"
                            string="Ingest Source Data" type="action"
                            invisible="state != 'open'" class="oe_highlight"
                            context="{'default_period_id': active_id}"
                            help="Pull financial journal entries into management accounting as source lines. Use filters to control what gets imported."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="%(jito_management_accounting.action_mgmt_process_mapping_wizard)d"
                            string="Apply Classification Rules" type="action"
                            invisible="state != 'open'"
                            context="{'default_period_id': active_id, 'default_action_type': 'mapping'}"
                            help="Run all classification rules against unclassified source lines. First matching rule wins. Unmatched lines can be classified manually."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="%(jito_management_accounting.action_mgmt_process_allocation_wizard)d"
                            string="Apply Allocations" type="action"
                            invisible="state != 'open'"
                            context="{'default_period_id': active_id, 'default_action_type': 'allocation'}"
                            help="Split management account balances across target accounts using allocation rules."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_reset_mapping" string="Reset Classification" type="object"
                            invisible="state != 'open'" class="btn-secondary"
                            confirm="This will delete ALL classification ledger lines and reset source lines to unclassified. Continue?"
                            help="Delete all classification ledger lines for this period and reset source lines to unclassified."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_reset_allocations" string="Reset Allocations" type="object"
                            invisible="state != 'open'" class="btn-secondary"
                            confirm="This will delete ALL allocation ledger lines for this period. Continue?"
                            help="Delete all allocation ledger lines for this period. Classification lines are kept."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_close" string="Close Period" type="object"
                            invisible="state != 'open'" class="btn-secondary"
                            confirm="Are you sure you want to close this period? This will lock all management ledger entries."
                            help="Lock this period. No further changes to ledger lines will be allowed."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_reopen" string="Reopen Period" type="object"
                            invisible="state != 'closed'" class="btn-secondary"
                            confirm="Are you sure you want to reopen this period?"
                            help="Unlock this period for editing. Only possible if no later period is closed."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_source_lines"
                                icon="fa-download">
                            <field name="source_line_count" widget="statinfo" string="Source Lines"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_ledger_lines"
                                icon="fa-book">
                            <field name="ledger_line_count" widget="statinfo" string="Ledger Lines"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="lock_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Period notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_mgmt_period_search" model="ir.ui.view">
        <field name="name">mgmt.period.search</field>
        <field name="model">mgmt.period</field>
        <field name="arch" type="xml">
            <search string="Periods">
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgmt_period" model="ir.actions.act_window">
        <field name="name">Periods</field>
        <field name="res_model">mgmt.period</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mgmt_period_search"/>
    </record>
</odoo>
