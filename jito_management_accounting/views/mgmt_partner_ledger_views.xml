<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Ledger: tree view -->
    <record id="view_mgmt_partner_ledger_tree" model="ir.ui.view">
        <field name="name">mgmt.ledger.line.partner.ledger.tree</field>
        <field name="model">mgmt.ledger.line</field>
        <field name="arch" type="xml">
            <tree string="Partner Ledger" default_order="partner_id, date desc">
                <field name="date"/>
                <field name="period_id"/>
                <field name="partner_id"/>
                <field name="mgmt_account_id"/>
                <field name="label"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Credit"/>
                <field name="balance" sum="Total Balance"/>
                <field name="ref_currency_id" optional="hide"/>
                <field name="ref_amount" optional="hide"/>
                <field name="matching_number" optional="hide"/>
                <field name="origin_type" widget="badge" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Partner Ledger: pivot view -->
    <record id="view_mgmt_partner_ledger_pivot" model="ir.ui.view">
        <field name="name">mgmt.ledger.line.partner.ledger.pivot</field>
        <field name="model">mgmt.ledger.line</field>
        <field name="arch" type="xml">
            <pivot string="Partner Ledger">
                <field name="partner_id" type="row"/>
                <field name="mgmt_account_id" type="row"/>
                <field name="period_id" type="col"/>
                <field name="debit" type="measure"/>
                <field name="credit" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Partner Ledger: graph view -->
    <record id="view_mgmt_partner_ledger_graph" model="ir.ui.view">
        <field name="name">mgmt.ledger.line.partner.ledger.graph</field>
        <field name="model">mgmt.ledger.line</field>
        <field name="arch" type="xml">
            <graph string="Partner Ledger" type="bar">
                <field name="partner_id"/>
                <field name="balance" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Partner Ledger: search view -->
    <record id="view_mgmt_partner_ledger_search" model="ir.ui.view">
        <field name="name">mgmt.ledger.line.partner.ledger.search</field>
        <field name="model">mgmt.ledger.line</field>
        <field name="arch" type="xml">
            <search string="Partner Ledger">
                <field name="partner_id"/>
                <field name="mgmt_account_id"/>
                <field name="label"/>
                <separator/>
                <filter name="has_partner" string="With Partner" domain="[('partner_id', '!=', False)]"/>
                <filter name="no_partner" string="Without Partner" domain="[('partner_id', '=', False)]"/>
                <separator/>
                <filter name="mapping" string="Classification" domain="[('origin_type', '=', 'mapping')]"/>
                <filter name="allocation" string="Allocation" domain="[('origin_type', '=', 'allocation')]"/>
                <filter name="timing" string="Timing" domain="[('origin_type', '=', 'timing')]"/>
                <filter name="manual" string="Journal Entry" domain="[('origin_type', '=', 'manual')]"/>
                <separator/>
                <filter name="income" string="Income" domain="[('mgmt_account_type', '=', 'income')]"/>
                <filter name="expense" string="Expense" domain="[('mgmt_account_type', '=', 'expense')]"/>
                <filter name="cost_of_revenue" string="Cost of Revenue" domain="[('mgmt_account_type', '=', 'cost_of_revenue')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_account" string="Management Account" context="{'group_by': 'mgmt_account_id'}"/>
                    <filter name="group_by_group" string="Account Group" context="{'group_by': 'mgmt_account_group_id'}"/>
                    <filter name="group_by_period" string="Period" context="{'group_by': 'period_id'}"/>
                    <filter name="group_by_origin" string="Origin" context="{'group_by': 'origin_type'}"/>
                    <filter name="group_by_type" string="Account Type" context="{'group_by': 'mgmt_account_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Partner Ledger: action -->
    <record id="action_mgmt_partner_ledger" model="ir.actions.act_window">
        <field name="name">Partner Ledger</field>
        <field name="res_model">mgmt.ledger.line</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="search_view_id" ref="view_mgmt_partner_ledger_search"/>
        <field name="context">{'search_default_has_partner': 1, 'search_default_group_by_partner': 1}</field>
        <field name="domain">[('partner_id', '!=', False)]</field>
    </record>

    <!-- Use dedicated views for the partner ledger action -->
    <record id="action_mgmt_partner_ledger_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_mgmt_partner_ledger_tree"/>
        <field name="act_window_id" ref="action_mgmt_partner_ledger"/>
    </record>

    <record id="action_mgmt_partner_ledger_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_mgmt_partner_ledger_pivot"/>
        <field name="act_window_id" ref="action_mgmt_partner_ledger"/>
    </record>

    <record id="action_mgmt_partner_ledger_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_mgmt_partner_ledger_graph"/>
        <field name="act_window_id" ref="action_mgmt_partner_ledger"/>
    </record>
</odoo>
