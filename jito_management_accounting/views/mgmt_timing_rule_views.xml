<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_timing_rule_tree" model="ir.ui.view">
        <field name="name">mgmt.timing.rule.tree</field>
        <field name="model">mgmt.timing.rule</field>
        <field name="arch" type="xml">
            <tree string="Timing Adjustments" decoration-info="state == 'draft'" decoration-success="state == 'applied'">
                <field name="name"/>
                <field name="source_mgmt_account_id"/>
                <field name="method"/>
                <field name="amount"/>
                <field name="source_period_id"/>
                <field name="target_period_id"/>
                <field name="spread_periods"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'applied'"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_timing_rule_form" model="ir.ui.view">
        <field name="name">mgmt.timing.rule.form</field>
        <field name="model">mgmt.timing.rule</field>
        <field name="arch" type="xml">
            <form string="Timing Adjustment">
                <header>
                    <button name="action_apply" string="Apply" type="object"
                            invisible="state != 'draft'" class="oe_highlight"
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_reverse" string="Reverse" type="object"
                            invisible="state != 'applied'" class="btn-secondary"
                            confirm="This will remove all generated ledger lines. Continue?"
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_mgmt_account_id"/>
                            <field name="method"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="source_period_id"/>
                            <field name="spread_periods" invisible="method != 'straight_line'"/>
                            <field name="target_period_id" invisible="method == 'straight_line'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Generated Lines" name="lines" invisible="state != 'applied'">
                            <field name="ledger_line_ids">
                                <tree string="Generated Ledger Lines">
                                    <field name="date"/>
                                    <field name="period_id"/>
                                    <field name="mgmt_account_id"/>
                                    <field name="label"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                    <field name="balance" sum="Total Balance"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" placeholder="Timing adjustment description..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_mgmt_timing_rule" model="ir.actions.act_window">
        <field name="name">Timing Adjustments</field>
        <field name="res_model">mgmt.timing.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
