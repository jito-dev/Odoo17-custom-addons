<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_account_mapping_tree" model="ir.ui.view">
        <field name="name">mgmt.account.mapping.tree</field>
        <field name="model">mgmt.account.mapping</field>
        <field name="arch" type="xml">
            <tree string="Default Classification" editable="bottom">
                <field name="financial_account_id"/>
                <field name="mgmt_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_account_mapping_form" model="ir.ui.view">
        <field name="name">mgmt.account.mapping.form</field>
        <field name="model">mgmt.account.mapping</field>
        <field name="arch" type="xml">
            <form string="Default Classification">
                <sheet>
                    <group>
                        <field name="financial_account_id"/>
                        <field name="mgmt_account_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmt_account_mapping" model="ir.actions.act_window">
        <field name="name">Default Classification</field>
        <field name="res_model">mgmt.account.mapping</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
