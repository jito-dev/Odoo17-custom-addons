<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_account_group_tree" model="ir.ui.view">
        <field name="name">mgmt.account.group.tree</field>
        <field name="model">mgmt.account.group</field>
        <field name="arch" type="xml">
            <tree string="Account Groups">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_account_group_form" model="ir.ui.view">
        <field name="name">mgmt.account.group.form</field>
        <field name="model">mgmt.account.group</field>
        <field name="arch" type="xml">
            <form string="Account Group">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts" name="accounts">
                            <field name="account_ids">
                                <tree string="Accounts">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="account_type"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Child Groups" name="children">
                            <field name="child_ids">
                                <tree string="Child Groups">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmt_account_group" model="ir.actions.act_window">
        <field name="name">Account Groups</field>
        <field name="res_model">mgmt.account.group</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
