<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_account_tree" model="ir.ui.view">
        <field name="name">mgmt.account.tree</field>
        <field name="model">mgmt.account</field>
        <field name="arch" type="xml">
            <tree string="Management Accounts">
                <field name="code"/>
                <field name="name"/>
                <field name="account_type"/>
                <field name="group_id"/>
                <field name="active" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_account_form" model="ir.ui.view">
        <field name="name">mgmt.account.form</field>
        <field name="model">mgmt.account</field>
        <field name="arch" type="xml">
            <form string="Management Account">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="account_type"/>
                        </group>
                        <group>
                            <field name="group_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgmt_account_search" model="ir.ui.view">
        <field name="name">mgmt.account.search</field>
        <field name="model">mgmt.account</field>
        <field name="arch" type="xml">
            <search string="Management Accounts">
                <field name="code"/>
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_type" string="Type" context="{'group_by': 'account_type'}"/>
                    <filter name="group_by_group" string="Group" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgmt_account" model="ir.actions.act_window">
        <field name="name">Management Accounts</field>
        <field name="res_model">mgmt.account</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mgmt_account_search"/>
    </record>
</odoo>
