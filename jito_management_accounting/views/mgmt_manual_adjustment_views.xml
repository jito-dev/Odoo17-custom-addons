<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_manual_adjustment_tree" model="ir.ui.view">
        <field name="name">mgmt.manual.adjustment.tree</field>
        <field name="model">mgmt.manual.adjustment</field>
        <field name="arch" type="xml">
            <tree string="Management Journal Entries" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="period_id"/>
                <field name="total_debit" sum="Total Debit"/>
                <field name="total_credit" sum="Total Credit"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_manual_adjustment_form" model="ir.ui.view">
        <field name="name">mgmt.manual.adjustment.form</field>
        <field name="model">mgmt.manual.adjustment</field>
        <field name="arch" type="xml">
            <form string="Management Journal Entry">
                <header>
                    <button name="action_post" string="Post" type="object"
                            invisible="state != 'draft'" class="oe_highlight"
                            help="Create ledger lines from this journal entry. Entry must be balanced (total debit = total credit)."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'posted'" class="btn-secondary"
                            confirm="This will remove all generated ledger lines. Continue?"
                            help="Remove all generated ledger lines and cancel this journal entry."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'" class="btn-secondary"
                            help="Return this cancelled journal entry to draft for editing."
                            groups="jito_management_accounting.group_mgmt_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="period_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="is_balanced" invisible="1"/>
                            <div colspan="2" invisible="is_balanced" class="alert alert-warning" role="alert">
                                <strong>Warning:</strong> This journal entry is not balanced. Total debit must equal total credit.
                            </div>
                        </group>
                    </group>
                    <group string="Reason (required)">
                        <field name="reason" nolabel="1" placeholder="Explain why this journal entry is needed..."/>
                    </group>
                    <notebook>
                        <page string="Entry Lines" name="lines">
                            <field name="line_ids">
                                <tree string="Lines" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="mgmt_account_id"/>
                                    <field name="label"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Generated Ledger Lines" name="ledger_lines" invisible="state != 'posted'">
                            <field name="ledger_line_ids">
                                <tree string="Ledger Lines">
                                    <field name="date"/>
                                    <field name="mgmt_account_id"/>
                                    <field name="label"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_mgmt_manual_adjustment_search" model="ir.ui.view">
        <field name="name">mgmt.manual.adjustment.search</field>
        <field name="model">mgmt.manual.adjustment</field>
        <field name="arch" type="xml">
            <search string="Management Journal Entries">
                <field name="name"/>
                <field name="reason"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_period" string="Period" context="{'group_by': 'period_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgmt_manual_adjustment" model="ir.actions.act_window">
        <field name="name">Management Journal Entries</field>
        <field name="res_model">mgmt.manual.adjustment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mgmt_manual_adjustment_search"/>
    </record>
</odoo>
