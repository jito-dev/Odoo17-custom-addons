<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Analytic Plan Views -->
    <record id="view_mgmt_analytic_plan_tree" model="ir.ui.view">
        <field name="name">mgmt.analytic.plan.tree</field>
        <field name="model">mgmt.analytic.plan</field>
        <field name="arch" type="xml">
            <tree string="Analytic Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_analytic_plan_form" model="ir.ui.view">
        <field name="name">mgmt.analytic.plan.form</field>
        <field name="model">mgmt.analytic.plan</field>
        <field name="arch" type="xml">
            <form string="Analytic Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts" name="accounts">
                            <field name="account_ids">
                                <tree string="Analytic Accounts">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmt_analytic_plan" model="ir.actions.act_window">
        <field name="name">Analytic Plans</field>
        <field name="res_model">mgmt.analytic.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Analytic Account Views -->
    <record id="view_mgmt_analytic_account_tree" model="ir.ui.view">
        <field name="name">mgmt.analytic.account.tree</field>
        <field name="model">mgmt.analytic.account</field>
        <field name="arch" type="xml">
            <tree string="Analytic Accounts">
                <field name="code"/>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="parent_id"/>
                <field name="active" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_analytic_account_form" model="ir.ui.view">
        <field name="name">mgmt.analytic.account.form</field>
        <field name="model">mgmt.analytic.account</field>
        <field name="arch" type="xml">
            <form string="Analytic Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="plan_id"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook invisible="not child_ids">
                        <page string="Children" name="children">
                            <field name="child_ids">
                                <tree string="Sub-Accounts">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgmt_analytic_account_search" model="ir.ui.view">
        <field name="name">mgmt.analytic.account.search</field>
        <field name="model">mgmt.analytic.account</field>
        <field name="arch" type="xml">
            <search string="Analytic Accounts">
                <field name="name"/>
                <field name="code"/>
                <field name="plan_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgmt_analytic_account" model="ir.actions.act_window">
        <field name="name">Analytic Accounts</field>
        <field name="res_model">mgmt.analytic.account</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mgmt_analytic_account_search"/>
        <field name="context">{'search_default_group_by_plan': 1}</field>
    </record>
</odoo>
