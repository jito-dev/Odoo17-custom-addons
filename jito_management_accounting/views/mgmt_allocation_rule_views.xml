<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_allocation_rule_tree" model="ir.ui.view">
        <field name="name">mgmt.allocation.rule.tree</field>
        <field name="model">mgmt.allocation.rule</field>
        <field name="arch" type="xml">
            <tree string="Allocation Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_mgmt_account_id"/>
                <field name="method"/>
                <field name="active" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_allocation_rule_form" model="ir.ui.view">
        <field name="name">mgmt.allocation.rule.form</field>
        <field name="model">mgmt.allocation.rule</field>
        <field name="arch" type="xml">
            <form string="Allocation Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="source_mgmt_account_id"/>
                            <field name="method"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocation Targets" name="targets">
                            <field name="line_ids">
                                <tree string="Targets" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="target_mgmt_account_id"/>
                                    <field name="percentage" invisible="parent.method != 'percentage'"/>
                                    <field name="fixed_amount" invisible="parent.method != 'fixed_amount'"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" placeholder="Allocation rule description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmt_allocation_rule" model="ir.actions.act_window">
        <field name="name">Allocation Rules</field>
        <field name="res_model">mgmt.allocation.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
