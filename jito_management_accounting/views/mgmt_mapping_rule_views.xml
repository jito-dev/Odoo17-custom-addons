<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_mapping_rule_tree" model="ir.ui.view">
        <field name="name">mgmt.mapping.rule.tree</field>
        <field name="model">mgmt.mapping.rule</field>
        <field name="arch" type="xml">
            <tree string="Classification Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="match_account_ids" widget="many2many_tags" optional="show"/>
                <field name="match_journal_ids" widget="many2many_tags" optional="show"/>
                <field name="match_partner_ids" widget="many2many_tags" optional="hide"/>
                <field name="match_label_contains" optional="hide"/>
                <field name="target_mgmt_account_id"/>
                <field name="active" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_mgmt_mapping_rule_form" model="ir.ui.view">
        <field name="name">mgmt.mapping.rule.form</field>
        <field name="model">mgmt.mapping.rule</field>
        <field name="arch" type="xml">
            <form string="Classification Rule">
                <sheet>
                    <group>
                        <group string="Rule">
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Target">
                            <field name="target_mgmt_account_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Match Criteria" name="criteria">
                            <group>
                                <group string="Account &amp; Journal">
                                    <field name="match_account_ids" widget="many2many_tags"/>
                                    <field name="match_journal_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Partner &amp; Product">
                                    <field name="match_partner_ids" widget="many2many_tags"/>
                                    <field name="match_product_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group>
                                <group string="Text Matching">
                                    <field name="match_label_contains"/>
                                    <field name="match_ref_contains"/>
                                </group>
                                <group string="Analytic">
                                    <field name="match_analytic_account_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group>
                                <group string="Date Range">
                                    <field name="match_date_from"/>
                                    <field name="match_date_to"/>
                                </group>
                                <group string="Amount Range">
                                    <field name="match_amount_min"/>
                                    <field name="match_amount_max"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" placeholder="Rule description and purpose..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgmt_mapping_rule_search" model="ir.ui.view">
        <field name="name">mgmt.mapping.rule.search</field>
        <field name="model">mgmt.mapping.rule</field>
        <field name="arch" type="xml">
            <search string="Classification Rules">
                <field name="name"/>
                <field name="target_mgmt_account_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_target" string="Target Account" context="{'group_by': 'target_mgmt_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgmt_mapping_rule" model="ir.actions.act_window">
        <field name="name">Classification Rules</field>
        <field name="res_model">mgmt.mapping.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mgmt_mapping_rule_search"/>
    </record>
</odoo>
