<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_process_wizard_form" model="ir.ui.view">
        <field name="name">mgmt.process.wizard.form</field>
        <field name="model">mgmt.process.wizard</field>
        <field name="arch" type="xml">
            <form string="Process Management Data">
                <group>
                    <field name="period_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="action_type"/>
                </group>
                <footer>
                    <button name="action_process" string="Process" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mgmt_process_mapping_wizard" model="ir.actions.act_window">
        <field name="name">Apply Classification Rules</field>
        <field name="res_model">mgmt.process.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_type': 'mapping'}</field>
    </record>

    <record id="action_mgmt_process_allocation_wizard" model="ir.actions.act_window">
        <field name="name">Apply Allocation Rules</field>
        <field name="res_model">mgmt.process.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_type': 'allocation'}</field>
    </record>
</odoo>
