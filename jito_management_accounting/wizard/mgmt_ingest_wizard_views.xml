<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_ingest_wizard_form" model="ir.ui.view">
        <field name="name">mgmt.ingest.wizard.form</field>
        <field name="model">mgmt.ingest.wizard</field>
        <field name="arch" type="xml">
            <form string="Ingest Source Data">
                <group>
                    <field name="period_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <separator string="Status Filters"/>
                <group>
                    <group>
                        <field name="filter_posted" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <field name="filter_reconciled" widget="boolean_toggle"/>
                    </group>
                </group>
                <separator string="Scope Filters"/>
                <group>
                    <group>
                        <field name="filter_journal_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="filter_account_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="filter_entry_type"/>
                    </group>
                    <group>
                        <field name="filter_partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="filter_analytic_account_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="filter_exclude_zero" widget="boolean_toggle"/>
                    </group>
                </group>
                <footer>
                    <button name="action_ingest" string="Ingest" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mgmt_ingest_wizard" model="ir.actions.act_window">
        <field name="name">Ingest Source Data</field>
        <field name="res_model">mgmt.ingest.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
