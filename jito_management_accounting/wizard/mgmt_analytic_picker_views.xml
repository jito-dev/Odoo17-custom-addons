<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_analytic_picker_form" model="ir.ui.view">
        <field name="name">mgmt.analytic.picker.form</field>
        <field name="model">mgmt.analytic.picker</field>
        <field name="arch" type="xml">
            <form string="Set/View Analytics">
                <field name="target_model" invisible="1"/>
                <field name="target_id" invisible="1"/>
                <group>
                    <group>
                        <field name="target_balance" string="Line Balance"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="text-muted mb-3">
                    Click a plan to edit its distribution. Each plan must total 100%%.
                    Add new plans with "Add a line".
                </div>
                <field name="plan_line_ids" nolabel="1">
                    <tree string="Analytic Plans" delete="true">
                        <field name="plan_id"/>
                        <field name="distribution_summary" string="Accounts"/>
                        <field name="total_percentage" string="Total %"
                               decoration-success="is_complete"
                               decoration-danger="not is_complete"/>
                        <field name="total_amount" string="Total Amount"/>
                        <field name="is_complete" column_invisible="True"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="sequence" column_invisible="True"/>
                    </tree>
                    <form string="Plan Distribution">
                        <header>
                            <button name="action_remove"
                                    string="Remove Plan"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-trash"
                                    confirm="Remove this plan and its distribution?"/>
                        </header>
                        <group>
                            <group>
                                <field name="plan_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_percentage"
                                       decoration-success="is_complete"
                                       decoration-danger="not is_complete"/>
                                <field name="total_amount"/>
                                <field name="is_complete" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <field name="line_ids" nolabel="1">
                            <tree string="Distribution" editable="bottom" delete="true">
                                <field name="account_id" context="{'default_plan_id': parent.plan_id}"/>
                                <field name="percentage" string="%" sum="Total %"/>
                                <field name="amount" sum="Total Amount"/>
                                <field name="plan_id" column_invisible="True"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="target_balance" column_invisible="True"/>
                            </tree>
                        </field>
                    </form>
                </field>
                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
