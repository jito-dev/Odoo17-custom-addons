<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_assign_account_wizard_form" model="ir.ui.view">
        <field name="name">mgmt.assign.account.wizard.form</field>
        <field name="model">mgmt.assign.account.wizard</field>
        <field name="arch" type="xml">
            <form string="Classify Source Line">
                <group string="Source Line">
                    <group>
                        <field name="financial_account_id"/>
                        <field name="label"/>
                    </group>
                    <group>
                        <field name="source_balance"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <separator string="Classification"/>
                <field name="line_ids" context="{'default_wizard_id': id}">
                    <tree editable="bottom" string="Classification Lines" delete="true">
                        <field name="sequence" widget="handle"/>
                        <field name="mgmt_account_id" options="{'no_create': True}"/>
                        <field name="partner_id" optional="show"/>
                        <field name="percentage"/>
                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id" column_invisible="True"/>
                    </tree>
                </field>
                <group>
                    <group>
                        <field name="total_percentage"/>
                        <field name="remaining_percentage"
                               decoration-danger="not is_fully_assigned"
                               decoration-success="is_fully_assigned"/>
                        <field name="total_amount"/>
                        <field name="remaining"
                               decoration-danger="not is_fully_assigned"
                               decoration-success="is_fully_assigned"/>
                    </group>
                    <group>
                        <field name="is_fully_assigned" invisible="1"/>
                    </group>
                </group>
                <field name="source_line_id" invisible="1"/>
                <field name="period_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <footer>
                    <button name="action_classify" string="Classify" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
