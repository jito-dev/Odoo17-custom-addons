<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgmt_match_wizard_form" model="ir.ui.view">
        <field name="name">mgmt.match.wizard.form</field>
        <field name="model">mgmt.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Match Management Ledger Lines">
                <group string="Selected Lines">
                    <field name="line_ids" nolabel="1" readonly="1">
                        <tree string="Lines to Match">
                            <field name="date"/>
                            <field name="mgmt_account_id"/>
                            <field name="label"/>
                            <field name="partner_id"/>
                            <field name="debit" sum="Total Debit"/>
                            <field name="credit" sum="Total Credit"/>
                            <field name="balance" sum="Balance"/>
                            <field name="currency_id" column_invisible="True"/>
                        </tree>
                    </field>
                </group>
                <group>
                    <group string="Totals">
                        <field name="total_debit"/>
                        <field name="total_credit"/>
                        <field name="difference"/>
                        <field name="is_balanced" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Write-off" invisible="is_balanced">
                        <field name="writeoff_mgmt_account_id" required="not is_balanced"/>
                        <field name="writeoff_period_id" required="not is_balanced"/>
                        <field name="writeoff_label"/>
                    </group>
                </group>
                <div invisible="not is_balanced" class="alert alert-success" role="alert">
                    Lines are balanced. No write-off needed.
                </div>
                <div invisible="is_balanced" class="alert alert-warning" role="alert">
                    Lines are not balanced. A write-off line will be created.
                </div>
                <footer>
                    <button name="action_match" string="Match" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
