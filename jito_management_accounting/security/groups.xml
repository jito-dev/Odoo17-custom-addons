<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_management_accounting" model="ir.module.category">
        <field name="name">Management Accounting</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_mgmt_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_management_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mgmt_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_management_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_mgmt_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Company-based record rules -->
    <record id="mgmt_config_comp_rule" model="ir.rule">
        <field name="name">Management Config: multi-company</field>
        <field name="model_id" ref="model_mgmt_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_account_group_comp_rule" model="ir.rule">
        <field name="name">Management Account Group: multi-company</field>
        <field name="model_id" ref="model_mgmt_account_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_account_comp_rule" model="ir.rule">
        <field name="name">Management Account: multi-company</field>
        <field name="model_id" ref="model_mgmt_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_account_mapping_comp_rule" model="ir.rule">
        <field name="name">Default Classification: multi-company</field>
        <field name="model_id" ref="model_mgmt_account_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
