    </record>

    <record id="mgmt_timing_rule_comp_rule" model="ir.rule">
        <field name="name">Management Timing Rule: multi-company</field>
        <field name="model_id" ref="model_mgmt_timing_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_manual_adjustment_comp_rule" model="ir.rule">
        <field name="name">Management Journal Entry: multi-company</field>
