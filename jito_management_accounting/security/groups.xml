    <record id="mgmt_period_comp_rule" model="ir.rule">
        <field name="name">Management Period: multi-company</field>
        <field name="model_id" ref="model_mgmt_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_source_line_comp_rule" model="ir.rule">
