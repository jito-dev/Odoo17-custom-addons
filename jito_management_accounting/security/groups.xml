        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_mapping_rule_comp_rule" model="ir.rule">
        <field name="name">Classification Rule: multi-company</field>
        <field name="model_id" ref="model_mgmt_mapping_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="mgmt_allocation_rule_comp_rule" model="ir.rule">
