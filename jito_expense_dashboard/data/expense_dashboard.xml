<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Expenses dashboard fed from accounting entries, placed in the standard
        Finance group right after the stock "Expenses" dashboard (sequence 40).
    -->
    <record id="dashboard_expense_accounting" model="spreadsheet.dashboard">
        <field name="name">Expenses (Accounting)</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="jito_expense_dashboard/data/files/expense_accounting_dashboard.json"/>
        <field name="dashboard_group_id"
               ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[
            Command.link(ref('account.group_account_readonly')),
            Command.link(ref('account.group_account_invoice')),
        ]"/>
        <field name="sequence">45</field>
    </record>

    <!--
        Hide the stock "Expenses" dashboard.

        `spreadsheet_dashboard_hr_expense` ships a Finance dashboard that reads
        `hr.expense` only. This company books its costs as vendor bills and journal
        entries, so that dashboard is permanently empty - two tiles named "Expenses"
        side by side, one of them showing nothing.

        Visibility is a record rule on `spreadsheet.dashboard`
        (`[('group_ids', 'in', user.groups_id.ids)]`), so clearing `group_ids` takes
        the tile off the list for everyone, admins included, without deleting the
        record or touching `hr_expense` itself. Restore it by dropping this record
        and upgrading the module.

        Note: this rewrites a record owned by another module. An upgrade of
        `spreadsheet_dashboard_hr_expense` (an Odoo version upgrade) restores the
        stock `group_ids` - re-run `-u jito_expense_dashboard` afterwards.
    -->
    <record id="spreadsheet_dashboard_hr_expense.spreadsheet_dashboard_expense"
            model="spreadsheet.dashboard">
        <field name="group_ids" eval="[Command.clear()]"/>
    </record>

</odoo>
