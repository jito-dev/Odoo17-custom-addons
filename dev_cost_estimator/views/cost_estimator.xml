<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="devo_cost_estimator_form" model="ir.ui.view">
        <field name="name">cost.estimator.data.form</field>
        <field name="model">cost.estimator.data</field>
        <field name="arch" type="xml">
            <form string="Cost Estimator" create="0" delete="0">
                <style>
                    .o_control_panel {
                        display: none !important;
                    }
                    .o_control_panel .o_pager {
                        display: none !important;
                    }
                    .o_field_multi_salary_chart {
                        width: 100% !important;
                        max-width: 100% !important;
                        display: block !important;
                    }
                </style>
                <header>
                    <button name="action_find_estimate"
                            string="Find"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_force_refresh"
                            string="Force Refresh"
                            type="object"
                            invisible="not multi_charts_json and not avg_min and not avg_max"/>
                    <button name="action_export_pdf"
                            string="Export PDF"
                            type="object"
                            invisible="not multi_charts_json"/>
                    <button name="action_clear"
                            string="Clear"
                            type="object"
                            invisible="not multi_charts_json and not avg_min and not avg_max"/>
                </header>
                <sheet>
                    <field name="avg_min" invisible="1"/>
                    <field name="avg_max" invisible="1"/>
                    <field name="multi_charts_json" invisible="1"/>
                    <group>
                        <group string="Query">
                            <field name="query_category_ids"
                                   widget="many2many_tags"
                                   domain="[('id', 'in', enabled_category_ids)]"
                                   options="{'no_create': True}"
                                   string="Categories"/>
                            <field name="exp" widget="selection"/>
                        </group>
                        <group string="Admin settings">
                            <field name="enabled_category_ids" widget="many2many_tags" string="Available Categories"
                                   options="{'no_create': True}"/>
                            <field name="multiplier" widget="selection" string="Multiplier"/>
                        </group>
                    </group>

                    <!-- Multi-category charts -->
                    <div invisible="not multi_charts_json">
                        <field name="multi_charts_display_json"
                               nolabel="1"
                               readonly="1"
                               widget="multi_salary_chart"/>
                    </div>

                    <div>
                        <h4>
                            – A specialist is considered Senior level when they have 5+ years of experience across multiple projects and pass a technical interview conducted by our senior specialists
                        </h4>
                        <h4>
                            – The final price includes paid vacations, sick leave, birthday gifts, local taxes, and other overhead — no hidden fees
                        </h4>
                        <h4>
                            – Specialists are contracted through our company — you receive a single monthly invoice for all provided resources
                        </h4>
                        <h4>
                            – We provide detailed monthly timesheets to ensure transparency of the work delivered
                        </h4>
                        <h4>
                            – If the collaboration doesn't work out, we replace the specialist at no additional cost
                        </h4>
                    </div>

                    <!-- Legacy single-category result (shown when no multi_charts_json) -->
                    <div invisible="multi_charts_json or (not avg_min and not avg_max)">
                        <div class="salary-range-container mt-4">
                            <div class="salary-section-title mb-3">Estimated rate range per resource</div>
                            <div class="row align-items-center">
                                <div class="col-4 text-center text-lg-start">
                                    <field name="salary_display_monthly" readonly="1" nolabel="1" class="salary-value"/>
                                </div>
                                <div class="col-4 text-center">
                                    <field name="salary_display_hourly" readonly="1" nolabel="1" class="salary-value"/>
                                </div>
                                <div class="col-4 text-center text-lg-end">
                                    <field name="salary_display_daily" readonly="1" nolabel="1" class="salary-value"/>
                                </div>
                            </div>
                        </div>
                        <field name="chart_display_json" nolabel="1" readonly="1" widget="salary_chart"/>
                        <group string="Market">
                            <group>
                                <field name="online_count" string="Candidates Online" readonly="1"/>
                                <field name="cached_at" string="Data As Of" readonly="1"/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cost_estimator" model="ir.actions.act_window">
        <field name="name">Cost Estimator</field>
        <field name="res_model">cost.estimator.data</field>
        <field name="view_mode">form</field>
    </record>

</odoo>
