<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="upwork_simple_accounting_integration.InvoiceUploader" owl="1">
        <div class="o_action o_upwork_invoice_uploader p-4">
            <div style="max-width:820px;">

                <h2 class="mb-1">Upload Upwork Invoices</h2>
                <p class="text-muted mb-4">
                    Upload Upwork's bulk PDFs. Each document is split into single pages
                    and routed automatically: the <strong>service invoice</strong> page
                    becomes a Customer Invoice, the <strong>Upwork fee</strong> page and
                    <strong>charge</strong> pages become Vendor Bills. The summary page is dropped.
                </p>

                <!-- Info -->
                <div class="alert alert-info mb-4">
                    <i class="fa fa-info-circle me-2"/>
                    Filenames must contain a <strong>T&lt;digits&gt;</strong> token —
                    e.g. <code>2026-03-15_…_T899387936_invoice.pdf</code>.
                    Type 1 = 3-page (service + fee), Type 2 = 2-page (Upwork charge);
                    other page counts are flagged.
                </div>

                <!-- ── Idle: pick files ─────────────────────────────────── -->
                <t t-if="!state.uploading and !state.done">
                    <label class="btn btn-primary btn-lg mb-0">
                        <i class="fa fa-upload me-2"/>Select PDF Invoices
                        <input type="file" multiple="multiple" accept="application/pdf"
                               t-on-change="onFileChange"
                               style="display:none;"/>
                    </label>
                </t>

                <!-- ── Uploading: progress bar ──────────────────────────── -->
                <t t-if="state.uploading">
                    <p class="mb-2">
                        Processing file
                        <strong t-esc="state.current + 1"/> of
                        <strong t-esc="state.total"/>…
                    </p>
                    <div class="progress mb-2" style="height:22px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             t-att-style="'width:' + progressPct + '%'">
                            <t t-esc="progressPct"/>%
                        </div>
                    </div>
                </t>

                <!-- ── Done: results ────────────────────────────────────── -->
                <t t-if="state.done">
                    <div class="d-flex gap-3 mb-3">
                        <span class="badge text-bg-success" style="font-size:0.95rem;">
                            <t t-esc="routedCount"/> routed
                        </span>
                        <span class="badge text-bg-warning" style="font-size:0.95rem;"
                              t-if="warnCount">
                            <t t-esc="warnCount"/> partial
                        </span>
                        <span class="badge text-bg-danger" style="font-size:0.95rem;"
                              t-if="failedCount">
                            <t t-esc="failedCount"/> failed
                        </span>
                    </div>

                    <div style="max-height:360px; overflow-y:auto;">
                        <table class="table table-sm table-striped" style="font-size:0.85rem;">
                            <thead>
                                <tr>
                                    <th>File</th>
                                    <th>Type</th>
                                    <th>Routed to</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.results" t-as="r" t-key="r_index">
                                    <tr>
                                        <td style="font-family:monospace;" t-esc="r.filename"/>
                                        <td t-esc="r.doc_type or '—'"/>
                                        <td>
                                            <span t-esc="routedSummary(r)"/>
                                            <div class="text-muted" t-if="r.message" t-esc="r.message"/>
                                        </td>
                                        <td>
                                            <span class="badge" t-att-class="badgeClass(r.status)"
                                                  t-esc="r.status"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <label class="btn btn-primary mt-2 mb-0">
                        <i class="fa fa-upload me-2"/>Upload More
                        <input type="file" multiple="multiple" accept="application/pdf"
                               t-on-change="onFileChange"
                               style="display:none;"/>
                    </label>
                </t>

            </div>
        </div>
    </t>
</templates>
