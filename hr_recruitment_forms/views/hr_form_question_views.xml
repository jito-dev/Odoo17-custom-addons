<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form Question Form View -->
    <record id="hr_form_question_view_form" model="ir.ui.view">
        <field name="name">hr.form.question.form</field>
        <field name="model">hr.form.question</field>
        <field name="arch" type="xml">
            <form string="Form Question">
                <sheet>
                    <!-- Validation error alert -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not answers_validation_error">
                        <field name="answers_validation_error" nolabel="1"/>
                    </div>

                    <group invisible="not is_section">
                        <group>
                            <field name="title" string="Section Title"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="template_id" invisible="job_id"/>
                            <field name="job_id" invisible="template_id"/>
                            <field name="is_section" invisible="1"/>
                        </group>
                        <group colspan="2">
                            <field name="description"/>
                        </group>
                    </group>

                    <group invisible="is_section">
                        <group>
                            <field name="title" string="Question"/>
                            <field name="question_type"/>
                            <field name="is_required"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="placeholder"/>
                            <field name="template_id" invisible="job_id"/>
                            <field name="job_id" invisible="template_id"/>
                            <field name="is_section" invisible="1"/>
                            <field name="has_answer_options" invisible="1"/>
                        </group>
                        <group colspan="2">
                            <field name="description"/>
                        </group>
                    </group>

                    <notebook invisible="is_section">
                        <!-- Answer Options -->
                        <page string="Answer Options" name="options"
                              invisible="not has_answer_options">
                            <field name="answer_option_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="value"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Rating Configuration -->
                        <page string="Rating Configuration" name="rating"
                              invisible="question_type != 'rating'">
                            <group>
                                <group>
                                    <field name="rating_min"/>
                                    <field name="rating_min_label"/>
                                </group>
                                <group>
                                    <field name="rating_max"/>
                                    <field name="rating_max_label"/>
                                </group>
                            </group>
                        </page>

                        <!-- Number Validation -->
                        <page string="Validation" name="validation"
                              invisible="question_type != 'number'">
                            <group>
                                <group>
                                    <field name="validation_min"/>
                                    <field name="validation_max"/>
                                </group>
                                <group>
                                    <field name="validation_error_msg"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form Question Tree View -->
    <record id="hr_form_question_view_tree" model="ir.ui.view">
        <field name="name">hr.form.question.tree</field>
        <field name="model">hr.form.question</field>
        <field name="arch" type="xml">
            <tree string="Form Questions" decoration-bf="is_section" decoration-info="is_section">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="is_section"/>
                <field name="question_type" invisible="is_section"/>
                <field name="is_required" invisible="is_section"/>
                <field name="template_id" optional="hide"/>
                <field name="job_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form Question Search View -->
    <record id="hr_form_question_view_search" model="ir.ui.view">
        <field name="name">hr.form.question.search</field>
        <field name="model">hr.form.question</field>
        <field name="arch" type="xml">
            <search string="Search Questions">
                <field name="title"/>
                <field name="template_id"/>
                <field name="job_id"/>
                <separator/>
                <filter string="Sections" name="sections" domain="[('is_section', '=', True)]"/>
                <filter string="Questions" name="questions" domain="[('is_section', '=', False)]"/>
                <separator/>
                <filter string="Required" name="required" domain="[('is_required', '=', True)]"/>
                <separator/>
                <filter string="Short Text" name="text" domain="[('question_type', '=', 'text')]"/>
                <filter string="Long Text" name="textarea" domain="[('question_type', '=', 'textarea')]"/>
                <filter string="Number" name="number" domain="[('question_type', '=', 'number')]"/>
                <filter string="Date" name="date" domain="[('question_type', '=', 'date')]"/>
                <filter string="Single Choice" name="single_choice" domain="[('question_type', '=', 'single_choice')]"/>
                <filter string="Multiple Choice" name="multiple_choice" domain="[('question_type', '=', 'multiple_choice')]"/>
                <filter string="Yes/No" name="yes_no" domain="[('question_type', '=', 'yes_no')]"/>
                <filter string="Rating" name="rating" domain="[('question_type', '=', 'rating')]"/>
                <group expand="0" string="Group By">
                    <filter string="Template" name="group_template" domain="[]" context="{'group_by': 'template_id'}"/>
                    <filter string="Job" name="group_job" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter string="Section" name="group_section" domain="[]" context="{'group_by': 'section_id'}"/>
                    <filter string="Type" name="group_type" domain="[]" context="{'group_by': 'question_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form Question Action -->
    <record id="hr_form_question_action" model="ir.actions.act_window">
        <field name="name">Form Questions</field>
        <field name="res_model">hr.form.question</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="hr_form_question_view_search"/>
        <field name="context">{'search_default_questions': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new question
            </p>
            <p>
                Questions are part of form templates or directly linked to jobs.
            </p>
        </field>
    </record>

</odoo>