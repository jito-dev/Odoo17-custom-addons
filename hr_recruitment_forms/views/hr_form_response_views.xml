<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form Response Form View -->
    <record id="hr_form_response_view_form" model="ir.ui.view">
        <field name="name">hr.form.response.form</field>
        <field name="model">hr.form.response</field>
        <field name="arch" type="xml">
            <form string="Form Response" create="0" edit="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applicant"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user">
                            <span>View Applicant</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="applicant_id"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="completion_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Answers" name="answers">
                            <field name="response_line_ids">
                                <tree create="0" edit="0" decoration-bf="is_section" decoration-info="is_section">
                                    <field name="question_sequence" column_invisible="1"/>
                                    <field name="is_section" column_invisible="1"/>
                                    <field name="question_title"/>
                                    <field name="question_type" invisible="is_section"/>
                                    <field name="display_value" invisible="is_section"/>
                                    <field name="is_empty" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form Response Tree View -->
    <record id="hr_form_response_view_tree" model="ir.ui.view">
        <field name="name">hr.form.response.tree</field>
        <field name="model">hr.form.response</field>
        <field name="arch" type="xml">
            <tree string="Form Responses" create="0">
                <field name="applicant_id"/>
                <field name="job_id"/>
                <field name="create_date"/>
                <field name="response_count" string="Answers"/>
                <field name="completion_percentage" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- Form Response Search View -->
    <record id="hr_form_response_view_search" model="ir.ui.view">
        <field name="name">hr.form.response.search</field>
        <field name="model">hr.form.response</field>
        <field name="arch" type="xml">
            <search string="Search Responses">
                <field name="applicant_id"/>
                <field name="job_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Job" name="group_job" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter string="Submission Date" name="group_date" domain="[]" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form Response Action -->
    <record id="hr_form_response_action" model="ir.actions.act_window">
        <field name="name">Form Responses</field>
        <field name="res_model">hr.form.response</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="hr_form_response_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No form responses yet
            </p>
            <p>
                Form responses will appear here when applicants submit their applications.
            </p>
        </field>
    </record>

    <!-- Form Response Line Form View -->
    <record id="hr_form_response_line_view_form" model="ir.ui.view">
        <field name="name">hr.form.response.line.form</field>
        <field name="model">hr.form.response.line</field>
        <field name="arch" type="xml">
            <form string="Form Answer">
                <sheet>
                    <group>
                        <group>
                            <field name="question_title" readonly="0"/>
                            <field name="question_type" invisible="1"/>
                            <field name="is_section" invisible="1"/>
                        </group>
                        <group>
                            <field name="applicant_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Answer" invisible="is_section">
                        <field name="value_text" invisible="question_type != 'text'"/>
                        <field name="value_textarea" invisible="question_type != 'textarea'"/>
                        <field name="value_number" invisible="question_type != 'number'"/>
                        <field name="value_date" invisible="question_type != 'date'"/>
                        <field name="value_single_choice_id" invisible="question_type != 'single_choice'" options="{'no_create': True, 'no_open': True}"/>
                        <field name="value_multiple_choice_ids" invisible="question_type != 'multiple_choice'" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="value_yes_no" invisible="question_type != 'yes_no'"/>
                        <field name="value_rating" invisible="question_type != 'rating'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form Response Line Tree View -->
    <record id="hr_form_response_line_view_tree" model="ir.ui.view">
        <field name="name">hr.form.response.line.tree</field>
        <field name="model">hr.form.response.line</field>
        <field name="arch" type="xml">
            <tree string="Form Answers" create="0" edit="0">
                <field name="question_sequence" column_invisible="1"/>
                <field name="question_title"/>
                <field name="question_type"/>
                <field name="display_value"/>
            </tree>
        </field>
    </record>

    <!-- Form Response Line Search View -->
    <record id="hr_form_response_line_view_search" model="ir.ui.view">
        <field name="name">hr.form.response.line.search</field>
        <field name="model">hr.form.response.line</field>
        <field name="arch" type="xml">
            <search string="Search Answers">
                <field name="question_title"/>
                <field name="applicant_id"/>
                <field name="job_id"/>
                <field name="display_value"/>
                <group expand="0" string="Group By">
                    <filter string="Job" name="group_job" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter string="Applicant" name="group_applicant" domain="[]" context="{'group_by': 'applicant_id'}"/>
                    <filter string="Question Type" name="group_type" domain="[]" context="{'group_by': 'question_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form Response Line Action (for analysis) -->
    <record id="hr_form_response_line_action" model="ir.actions.act_window">
        <field name="name">Form Answers</field>
        <field name="res_model">hr.form.response.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="hr_form_response_line_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No answers yet
            </p>
            <p>
                Individual answers to form questions will appear here.
            </p>
        </field>
    </record>

</odoo>