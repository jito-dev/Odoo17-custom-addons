<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_test_task_invite" model="mail.template">
        <field name="name">Recruitment: Test Task Invitation</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="subject">Technical Assessment for {{ object.job_id.name }}</field>
        <field name="email_to">{{ object.email_from }}</field>
        <field name="description">Sent to candidates when moved to 'Test Task Given' stage</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello <t t-out="object.partner_name or 'Applicant'"/>,<br/><br/>
                    
                    We were impressed by your profile and would like to invite you to complete a technical test task for the 
                    <strong><t t-out="object.job_id.name"/></strong> position.<br/><br/>
                    
                    Please submit your solution (GitHub link) using the portal below. You can update your submission if necessary.
                    <br/><br/>
                    <div style="text-align: center; margin: 16px 0px;">
                        <!-- Fixed: Calls public method -->
                        <a t-att-href="object.get_test_task_url()"
                           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">
                           View Task &amp; Submit
                        </a>
                    </div>
                    <br/>
                    Best regards,<br/>
                    The Recruitment Team
                </p>
            </div>
        </field>
    </record>
</odoo>