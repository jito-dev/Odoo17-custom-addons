<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add a "Interview Questions" page to the per-(job, stage) config form.
         These questions are copied into a Fireflies interview when it is created
         for a candidate sitting on this stage. -->
    <record id="view_hr_job_stage_config_form_fireflies" model="ir.ui.view">
        <field name="name">hr.job.stage.config.form.fireflies</field>
        <field name="model">hr.job.stage.config</field>
        <field name="inherit_id"
               ref="hr_recruitment_job_stage_config.view_hr_job_stage_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Interview Questions" name="fireflies_questions_page">
                    <p class="text-muted">
                        <i class="fa fa-info-circle me-1" title="Info"/>
                        One question per line. When a Fireflies interview is created for a
                        candidate on this stage, these are copied into the interview's own
                        questions — the recruiter just clicks <b>Ask AI</b>. Editing this
                        template later does not change interviews already created.
                    </p>
                    <field name="interview_question_template" nolabel="1"
                           placeholder="How many years with Kubernetes?&#10;What is the expected start date?&#10;What are the salary expectations?"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
