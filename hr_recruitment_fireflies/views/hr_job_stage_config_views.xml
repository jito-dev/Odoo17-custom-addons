<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add an "Interview questions" page to the per-(job, stage) config form.
         These questions are copied into a Fireflies interview created for a
         candidate sitting on this stage. v17.0.1.17.0: the former one-per-line
         Text box became an ordered drag-list; a paste box above it splits
         multi-line text into rows for fast bulk entry. -->
    <record id="view_hr_job_stage_config_form_fireflies" model="ir.ui.view">
        <field name="name">hr.job.stage.config.form.fireflies</field>
        <field name="model">hr.job.stage.config</field>
        <field name="inherit_id"
               ref="hr_recruitment_job_stage_config.view_hr_job_stage_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Interview questions" name="fireflies_questions_page">
                    <div class="text-muted mb-2">
                        <i class="fa fa-info-circle me-1" title="Info"/>
                        These questions guide the AI summary of the Fireflies
                        call for this stage. They are copied into each new
                        interview created for a candidate here — the recruiter
                        just clicks <b>Ask AI</b>. Editing this list does not
                        change interviews already created.
                    </div>

                    <field name="question_bulk_add" nolabel="1"
                           class="o_cs_bulk_add"
                           placeholder="Paste several questions here — one per line — then click away to split them into the list below."/>

                    <field name="interview_question_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" string="Question"
                                   placeholder="Type a question…"/>
                        </tree>
                    </field>

                    <div class="text-muted small mt-1">
                        <i class="fa fa-arrows-v me-1" title="Reorder"/>
                        Drag to reorder. Edits apply to this stage only.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
