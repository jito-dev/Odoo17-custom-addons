<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Interview Form (used standalone and as the inline o2m dialog) -->
    <record id="hr_applicant_interview_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.interview.form</field>
        <field name="model">hr.applicant.interview</field>
        <field name="arch" type="xml">
            <form string="Interview">
                <header>
                    <button name="action_analyze" type="object" string="Analyze"
                            class="btn-primary"
                            invisible="state in ('processing', 'done')"
                            icon="fa-magic"/>
                    <button name="action_analyze" type="object" string="Re-analyze"
                            invisible="state != 'done'"
                            confirm="Re-run the AI analysis for this interview?"
                            icon="fa-refresh"/>
                    <button name="action_print_summary" type="object" string="PDF"
                            invisible="not has_summary"
                            icon="fa-file-pdf-o"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="idle,processing,done"/>
                </header>
                <sheet>
                    <field name="has_summary" invisible="1"/>

                    <!-- Status banners -->
                    <div role="status" class="alert alert-info text-center"
                         invisible="state != 'processing'">
                        <i class="fa fa-fw fa-spin fa-spinner" title="Processing"/>
                        <span class="ms-1"><field name="state_message" nolabel="1"/></span>
                    </div>
                    <div role="status" class="alert alert-danger text-center"
                         invisible="state != 'error'">
                        <i class="fa fa-fw fa-exclamation-triangle" title="Error"/>
                        <span class="ms-1"><field name="state_message" nolabel="1"/></span>
                        <button name="action_analyze" class="btn btn-link" string="Retry" type="object"/>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Screening Call - Jane Doe"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="fireflies_link" widget="url" placeholder="https://app.fireflies.ai/view/...::ID"/>
                            <field name="interview_type"/>
                            <field name="question_template_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="interviewer_id" widget="many2one_avatar_user"/>
                            <field name="interview_date"/>
                            <field name="meeting_id" invisible="not meeting_id"/>
                            <field name="last_generated" invisible="not last_generated"/>
                            <field name="model_used" invisible="not model_used"/>
                        </group>
                    </group>

                    <!-- AI summary -->
                    <div invisible="state != 'done'">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="o_horizontal_separator fw-bold fs-4 mb-0">Summary for Client</div>
                            <field name="summary_clipboard" widget="CopyClipboardText" nolabel="1"
                                   string="Copy summary"/>
                        </div>

                        <field name="executive_summary" nolabel="1" readonly="1" class="fst-italic"/>

                        <div class="row mt-3">
                            <div class="col-lg-6 pe-4">
                                <div class="o_form_label text-success fw-bold">Strengths</div>
                                <field name="strengths" nolabel="1" readonly="1"/>
                            </div>
                            <div class="col-lg-6 border-start ps-4">
                                <div class="o_form_label text-danger fw-bold">Concerns / Risks</div>
                                <field name="concerns" nolabel="1" readonly="1"/>
                            </div>
                        </div>

                        <separator string="Highlights" invisible="not highlights"/>
                        <field name="highlights" nolabel="1" readonly="1" invisible="not highlights"/>

                        <separator string="Question &amp; Answer" invisible="not qa_line_ids"/>
                        <field name="qa_line_ids" readonly="1" invisible="not qa_line_ids">
                            <tree>
                                <field name="question"/>
                                <field name="answer"/>
                                <field name="coverage" widget="badge"
                                       decoration-success="coverage == 'covered'"
                                       decoration-warning="coverage == 'partial'"
                                       decoration-danger="coverage == 'missed'"
                                       decoration-muted="coverage == 'not_asked'"/>
                            </tree>
                        </field>
                    </div>

                    <notebook invisible="not transcript_text">
                        <page string="Transcript" name="transcript">
                            <field name="transcript_text" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Interview Tree -->
    <record id="hr_applicant_interview_view_tree" model="ir.ui.view">
        <field name="name">hr.applicant.interview.tree</field>
        <field name="model">hr.applicant.interview</field>
        <field name="arch" type="xml">
            <tree string="Interviews">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="interview_type"/>
                <field name="interview_date" optional="show"/>
                <field name="interviewer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'processing'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'idle'"/>
            </tree>
        </field>
    </record>

</odoo>
