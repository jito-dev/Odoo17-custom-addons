<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Document Generated - Form View                               -->
    <!-- ============================================================ -->
    <record id="view_document_generated_form" model="ir.ui.view">
        <field name="name">document.generated.form</field>
        <field name="model">document.generated</field>
        <field name="arch" type="xml">
            <form string="Generated Document">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Document">
                            <field name="template_id" readonly="1"/>
                            <field name="res_name" string="Source Record" readonly="1"
                                   invisible="not res_name"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'generated'"
                                   decoration-danger="state == 'error'"
                                   readonly="1"/>
                        </group>
                        <group string="Generated By">
                            <field name="generated_by" readonly="1"/>
                            <field name="create_date" readonly="1" string="Generated On"/>
                        </group>
                    </group>

                    <group string="Error Details" invisible="state != 'error'">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>

                    <div class="o_row mt-3" invisible="state != 'generated'">
                        <button name="action_download_docx"
                                type="object"
                                string="Download DOCX"
                                class="btn btn-primary"
                                invisible="not docx_attachment_id"/>
                        <button name="action_download_pdf"
                                type="object"
                                string="Download PDF"
                                class="btn btn-secondary"
                                invisible="not pdf_attachment_id"/>
                    </div>

                    <!-- Hidden fields used in computed/domain logic -->
                    <field name="docx_attachment_id" invisible="1"/>
                    <field name="pdf_attachment_id" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Document Generated - Tree View                               -->
    <!-- ============================================================ -->
    <record id="view_document_generated_tree" model="ir.ui.view">
        <field name="name">document.generated.tree</field>
        <field name="model">document.generated</field>
        <field name="arch" type="xml">
            <tree string="Generated Documents">
                <field name="name"/>
                <field name="template_id"/>
                <field name="res_name" string="Source Record" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'generated'"
                       decoration-danger="state == 'error'"/>
                <field name="generated_by" optional="show"/>
                <field name="create_date" string="Generated On" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Document Generated - Search View                             -->
    <!-- ============================================================ -->
    <record id="view_document_generated_search" model="ir.ui.view">
        <field name="name">document.generated.search</field>
        <field name="model">document.generated</field>
        <field name="arch" type="xml">
            <search string="Generated Documents">
                <field name="name"/>
                <field name="template_id"/>
                <separator/>
                <filter string="Generated" name="filter_generated"
                        domain="[('state', '=', 'generated')]"/>
                <filter string="Errors" name="filter_error"
                        domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="My Documents" name="filter_my_docs"
                        domain="[('generated_by', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Template" name="group_by_template"
                            context="{'group_by': 'template_id'}"/>
                    <filter string="Status" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Generated By" name="group_by_user"
                            context="{'group_by': 'generated_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Document Generated - Action                                  -->
    <!-- ============================================================ -->
    <record id="action_document_generated" model="ir.actions.act_window">
        <field name="name">Generated Documents</field>
        <field name="res_model">document.generated</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents generated yet
            </p>
            <p>
                Use the Generate button on a record or template to create your first document.
            </p>
        </field>
    </record>
</odoo>
