<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_revolut" model="payment.provider">
        <field name="name">Revolut</field>
        <field name="code">revolut</field>
        <field name="image_128" type="base64" file="payment_revolut/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_revolut"/>
        <!--
            What the hosted checkout page can offer. Revolut decides per order which of them are
            actually available to the customer, based on the merchant account and the currency.
        -->
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_visa'),
                         ref('payment.payment_method_mastercard'),
                         ref('payment.payment_method_maestro'),
                         ref('payment.payment_method_amex'),
                         ref('payment.payment_method_revolut_pay'),
                     ])]"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
    </record>

</odoo>
