<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherits jito_ledger_core's jito.ledger form to add extension-
        specific UX:

          * <header> with "New Extension Adjustment" action
          * <oe_button_box> with two stat buttons:
              - Adjustments    → action_view_extension_adjustments
              - Base Entries   → action_view_base_ledger_entries

        All controls are hidden when kind != 'extension'. The header
        button is also hidden on unsaved (draft) records — the action
        references self.id.
    -->

    <record id="view_jito_ledger_form_inherit_extension" model="ir.ui.view">
        <field name="name">jito.ledger.form.inherit.extension</field>
        <field name="model">jito.ledger</field>
        <field name="inherit_id" ref="jito_ledger_core.view_jito_ledger_form"/>
        <field name="arch" type="xml">

            <!-- Header with the quick-create action -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_extension_adjustment"
                            string="New Extension Adjustment"
                            type="object"
                            class="oe_highlight"
                            invisible="kind != 'extension' or not id"/>
                </header>
            </xpath>

            <!-- Stat buttons in the sheet, after the archive ribbon -->
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_extension_adjustments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            invisible="kind != 'extension'">
                        <field name="extension_adjustment_count"
                               widget="statinfo"
                               string="Adjustments"/>
                    </button>
                    <button name="action_view_base_ledger_entries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book"
                            invisible="kind != 'extension' or not base_ledger_id">
                        <field name="base_ledger_entry_count"
                               widget="statinfo"
                               string="Base Entries"/>
                    </button>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
