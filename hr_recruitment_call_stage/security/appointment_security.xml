<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!--
        v17.0.26.0.0 — recruiters must be able to SEE every appointment type.

        Stock `appointment` ships `appointment.appointment_type_rule_user`,
        granted to `appointment.group_appointment_user`:

            ['|','|','|', ('create_uid','=',user.id),
                          ('staff_user_ids.id','=',user.id),
                          ('staff_user_ids','=',False),
                          ('schedule_based_on','=','resources')]

        Record rules attached to groups are OR-ed, and there is no global rule
        on `appointment.type`. A recruiter in the Appointment *User* group
        therefore only sees types they created or are staff on — on prod that
        was 2 types out of 15 — so the Call Stage "Appointment type" dropdown
        offered them only their own types and an interview could never be
        wired to a colleague's type.

        This rule OR-s a read-only "see them all" onto recruiters. It is
        deliberately read-ONLY: write / create / unlink stay governed by the
        stock rules above, so nobody gains the ability to edit a colleague's
        appointment type through the recruitment app. The one write this
        module performs on a type (growing `staff_user_ids` with the
        interviewer the recruiter picked) goes through `sudo()` as an explicit,
        warned-about system policy — see
        `call_stage_assignment._call_grow_staff_pool`.
    -->
    <record id="appointment_type_rule_recruitment_read" model="ir.rule">
        <field name="name">appointment.type: recruiters may read every type (Call Stage)</field>
        <field name="model_id" ref="appointment.model_appointment_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
