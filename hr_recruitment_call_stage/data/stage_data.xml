<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Shipped "Call Booked" stage — the auto-managed destination after
         a candidate confirms a booking. noupdate=1 so recruiters can rename
         it without the next module upgrade trampling their edits. -->
    <record id="stage_call_booked" model="hr.recruitment.stage">
        <field name="name">Call Booked</field>
        <field name="sequence">35</field>
        <field name="fold" eval="False"/>
        <field name="default_visible_in_new_jobs" eval="False"/>
    </record>

</odoo>
