<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Call Stage overlay on the per-(job, stage) config popup.

        v17.0.27.0.0 layout pass. What changed and why:

        * "Who runs the call" (the three-pill radio) is GONE. It could not keep
          its promise — see `call_stage_assignment.call_assign_hint`. In its
          place, one muted sentence reporting what the appointment type
          actually does.
        * The call fields no longer share the foundation's Email group. Piling
          eight unrelated fields — including a full-width preview widget and a
          textarea — into one two-column grid is what made the dialog sprawl.
          They now sit in three titled sections, in the order a recruiter
          thinks: WHO runs it, WHAT the meeting is, WHAT the candidate sees.
        * The availability card and the two inline notes render OUTSIDE any
          group, so they get the full width instead of being squeezed into a
          grid cell.
        * The free-slot counter left the context strip: the availability card
          already states "N slots free" and saying it twice is noise.
        * The pool-growth notice dropped its alert box for a muted line under
          the Interviewer field — it belongs next to the action that causes it.

        Kept from v17.0.24.15.0: one status indicator (now inline with the
        adaptive title) and the single compact row of secondary actions.
        The hard save-gate remains the @api.constrains on the model; the view
        only surfaces state.
    -->
    <record id="view_hr_job_stage_config_form_call" model="ir.ui.view">
        <field name="name">hr.job.stage.config.form.call</field>
        <field name="model">hr.job.stage.config</field>
        <field name="inherit_id" ref="hr_recruitment_job_stage_config.view_hr_job_stage_config_form"/>
        <field name="arch" type="xml">

            <!-- Adaptive title: "Stage settings" -> "Call invite" for call
                 stages, with the readiness badge ON the title line.

                 v17.0.27.1.0 — the badge used to live in a <header> of its
                 own. A statusbar holding one small chip cost a full-width band
                 of empty space above the title, which is what made the top of
                 the dialog look padded out. Nothing else anchors to that
                 header (hr_recruitment_fireflies targets the //header of the
                 hr.recruitment.stage form — a different view), so it is gone
                 and the status sits where the eye already is. -->
            <xpath expr="//span[@name='stage_title_default']" position="attributes">
                <attribute name="invisible">is_call_stage</attribute>
            </xpath>
            <xpath expr="//span[@name='stage_title_default']" position="after">
                <span invisible="not is_call_stage">Call invite</span>
                <field name="call_readiness_state" widget="badge" nolabel="1"
                       class="o_cs_badge ms-2"
                       invisible="not is_call_stage"
                       decoration-success="call_readiness_state == 'ready'"
                       decoration-warning="call_readiness_state == 'needs_attention'"
                       decoration-danger="call_readiness_state == 'wont_send'"/>
            </xpath>

            <!-- Actionable problem alerts at the top of the Email page. No
                 "ready" banner: the title badge owns that state. -->
            <xpath expr="//page[@name='email_page']/group[1]" position="before">
                <field name="call_check_template" invisible="1"/>
                <field name="call_check_booking_button" invisible="1"/>
                <field name="call_check_appointment" invisible="1"/>
                <field name="call_check_staff" invisible="1"/>
                <field name="call_warn_staff_unsynced" invisible="1"/>
                <field name="call_warn_unsynced_breaks_meet" invisible="1"/>
                <field name="call_warn_work_hours_off" invisible="1"/>

                <div class="alert alert-danger o_cs_alert" role="alert"
                     invisible="call_readiness_state != 'wont_send'">
                    <strong>Won't send.</strong>
                    <ul class="mb-0">
                        <li invisible="call_check_booking_button">
                            Email template has no Book-a-call button
                            (<code>object.booking_url</code>).
                        </li>
                        <li invisible="call_check_appointment">
                            No appointment type is set.
                        </li>
                    </ul>
                </div>

                <!-- v17.0.25.0.0 — failures that used to be silent.
                     v17.0.26.1.0 — one sentence each; the sync warning no
                     longer waits for a google_meet type, because an unsynced
                     calendar makes every slot look free whatever the videocall
                     source is. -->
                <div class="alert alert-warning o_cs_alert" role="alert"
                     invisible="not is_call_stage or (call_readiness_state != 'needs_attention' and not call_warn_staff_unsynced and not call_warn_work_hours_off)">
                    <ul class="mb-0">
                        <li invisible="call_check_staff">
                            No booking-calendar staff on the appointment type —
                            candidates may see no slots.
                        </li>
                        <li invisible="not call_warn_staff_unsynced">
                            <field name="call_warn_unsynced_names" readonly="1" nolabel="1" class="oe_inline"/>
                            has no Google Calendar connected, so their busy time
                            is invisible here and slots may look free<span
                            invisible="not call_warn_unsynced_breaks_meet"> — and
                            the invite will carry no join link</span>.
                        </li>
                        <li invisible="not call_warn_work_hours_off">
                            Working hours are not enforced on this appointment
                            type, so slots can fall outside working time.
                        </li>
                    </ul>
                </div>
            </xpath>

            <!-- The toggle is the only call field that belongs in the Email
                 group: it is what turns the rest of the dialog on. -->
            <xpath expr="//page[@name='email_page']//field[@name='mail_template_id']" position="after">
                <field name="is_call_stage" widget="boolean_toggle"
                       string="This is a Call Stage"/>
            </xpath>

            <!-- Call sections, each full width, in the order a recruiter
                 thinks about them. -->
            <xpath expr="//page[@name='email_page']/group[1]" position="after">

                <!-- v17.0.28.0.0 — the stage no longer keeps its own list of
                     interviewers. Who runs the call is the appointment type's
                     own staff, shown here read-only: one answer, in the place
                     the slot grid also comes from. The stage picking a subset
                     was a snapshot taken once, and everything that moved after
                     it silently turned "Ann" back into "anyone free". -->
                <group string="Who runs the call" name="call_who"
                       invisible="not is_call_stage">
                    <field name="call_pool_shared_stages" invisible="1"/>
                    <!-- v17.0.24.0.0 — dormant, kept for easy rollback. -->
                    <field name="recruiter_user_ids" invisible="1"/>

                    <field name="call_staff_pool_ids"
                           string="Runs the call"
                           widget="many2many_avatar_user"
                           readonly="1"
                           options="{'no_open': True}"
                           help="The appointment type's own bookable staff. Edit it on the appointment type — that is also where the free slots come from, so the two can never disagree."/>
                </group>

                <!-- What actually decides the assignment lives on the
                     appointment type and is shared with sibling stages, so it
                     is reported here, never edited. -->
                <div class="o_cs_note" invisible="not is_call_stage or not call_assign_hint">
                    <field name="call_assign_hint" readonly="1" nolabel="1" class="oe_inline"/>
                </div>

                <!-- Picking a type IS the whole configuration now, so the one
                     thing worth flagging is that the type is not exclusive to
                     this stage: its staff, duration and questions are shared. -->
                <div class="o_cs_note o_cs_note_add"
                     invisible="not is_call_stage or not call_pool_shared_stages">
                    <i class="fa fa-link me-1" title="Shared appointment type"/>
                    This appointment type is also used by
                    <field name="call_pool_shared_stages" readonly="1" nolabel="1" class="oe_inline"/>.
                    Changing who runs it, how long it lasts or what it asks changes those stages too.
                </div>

                <field name="call_availability_7d"
                       widget="call_stage_availability" nolabel="1"
                       invisible="not is_call_stage or not booking_appointment_type_id"/>

                <group string="Meeting" name="call_meeting"
                       invisible="not is_call_stage">
                    <!-- Domain (v17.0.26.0.0): only types that schedule USERS
                         can host an interviewer, and stock `appointment.invite`
                         accepts punctual/recurring types only
                         (appointment/models/appointment_invite.py:34).
                         Filtering here beats failing at booking time; stored
                         values are not affected by a view domain. -->
                    <!-- The type IS the configuration (v17.0.28.0.0): who runs
                         the call, how long it lasts, what it asks. Getting into
                         it is the many2one's own internal-link arrow — adding a
                         second button beside it only duplicated that arrow, and
                         the stock one is the better of the two anyway: it opens
                         the type in a dialog ON TOP of these settings, where an
                         `act_window` with target=current would replace them. -->
                    <field name="booking_appointment_type_id"
                           string="Appointment type"
                           required="is_call_stage"
                           domain="[('schedule_based_on', '=', 'users'), ('category', 'in', ['punctual', 'recurring'])]"
                           options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>

                    <field name="call_booked_stage_id"
                           string="After booking, move to"
                           options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                           help="Auto-populated to the shipped 'Call Booked' stage. Override only for advanced setups."/>
                </group>

                <group string="The candidate sees" name="call_candidate"
                       invisible="not is_call_stage">
                    <field name="interviewer_user_ids"
                           string="Also joins the call"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                           help="Guests: they get the calendar invite with the Meet link and their photo is shown on the booking page, but they never affect slot availability. Seeded as the default on each candidate entering this stage; editable per-candidate."/>

                    <field name="what_to_expect"
                           string="What to expect"
                           class="o_cs_expect"
                           placeholder="One line = one bullet, e.g. 30-min technical discussion"
                           help="Shown to the candidate on the booking page as a bullet list (one line per bullet). Leave empty to hide the panel."/>
                </group>
            </xpath>

            <!-- One-line auto-button note + compact secondary action row,
                 placed just above the shell's "Effective template" note. -->
            <xpath expr="//page[@name='email_page']//div[hasclass('o_cs_effective')]" position="before">
                <div class="o_cs_note" invisible="not is_call_stage">
                    <i class="fa fa-info-circle me-1" title="Info"/>
                    The booking button is inserted automatically — nothing to paste.
                </div>

                <!-- Folded by default (v17.0.28.0.0). None of these is part of
                     configuring the stage — they are ways to go and look at
                     something. Six buttons sitting open under the settings read
                     as six more decisions to make. Native <details>, so the fold
                     needs no widget and no JS; each button carries its own
                     one-line hint on hover. -->
                <details class="o_cs_tools" invisible="not is_call_stage">
                    <summary class="o_cs_tools_head">
                        <i class="fa fa-chevron-right o_cs_tools_caret" role="img" aria-label="Toggle"/>
                        Check and preview
                    </summary>
                    <div class="o_cs_actions">
                        <button name="action_preview_email" type="object"
                                string="Preview" icon="fa-eye"
                                class="btn-secondary btn-sm"
                                title="See the invite exactly as a candidate receives it"
                                invisible="not call_check_template"/>
                        <button name="action_send_test_email" type="object"
                                string="Send test to me" icon="fa-paper-plane"
                                class="btn-secondary btn-sm"
                                title="Send that invite to your own address"
                                invisible="not call_check_template"/>
                        <button name="action_open_booking_page" type="object"
                                string="Booking page" icon="fa-external-link"
                                class="btn-secondary btn-sm"
                                title="Open the page where the candidate picks a slot"
                                invisible="not booking_appointment_type_id"/>
                        <button name="action_open_call_template" type="object"
                                string="Template" icon="fa-envelope-o"
                                class="btn-secondary btn-sm"
                                title="Edit the email template this stage sends"
                                invisible="not call_check_template"/>
                        <button name="action_open_applicants" type="object"
                                string="Applicants" icon="fa-users"
                                class="btn-secondary btn-sm"
                                title="List the candidates sitting on this stage"/>
                    </div>
                </details>
            </xpath>

        </field>
    </record>

</odoo>
