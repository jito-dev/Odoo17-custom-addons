<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Call Stage options are embedded directly on the foundation's
        email_page. v17.0.23.0.0 adds a readiness panel (header badge +
        alerts), a test toolbar, smart-button stats, and clickable "wired to"
        deep-link chips so a recruiter can tell at a glance whether the invite
        will go out correctly and where the call is wired. The hard save-gate
        is the @api.constrains on the model — the view only surfaces state.
    -->
    <record id="view_hr_job_stage_config_form_call" model="ir.ui.view">
        <field name="name">hr.job.stage.config.form.call</field>
        <field name="model">hr.job.stage.config</field>
        <field name="inherit_id" ref="hr_recruitment_job_stage_config.view_hr_job_stage_config_form"/>
        <field name="arch" type="xml">

            <!-- Header: readiness badge + test toolbar (Call Stage only) -->
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="call_readiness_state" widget="badge"
                           invisible="not is_call_stage"
                           decoration-success="call_readiness_state == 'ready'"
                           decoration-warning="call_readiness_state == 'needs_attention'"
                           decoration-danger="call_readiness_state == 'wont_send'"/>
                    <button name="action_send_test_email" type="object"
                            string="Send test email to me" icon="fa-paper-plane"
                            invisible="not is_call_stage or not call_check_template"/>
                    <button name="action_open_booking_page" type="object"
                            string="Open booking page" icon="fa-external-link"
                            invisible="not is_call_stage or not booking_appointment_type_id"/>
                    <button name="action_preview_email" type="object"
                            string="Preview rendered email" icon="fa-eye"
                            invisible="not is_call_stage or not call_check_template"/>
                </header>
            </xpath>

            <!-- Smart-button stats -->
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box"
                     invisible="not is_call_stage">
                    <button class="oe_stat_button" icon="fa-users" type="object"
                            name="action_open_applicants">
                        <field name="applicant_count" widget="statinfo"
                               string="Applicants"/>
                    </button>
                    <button class="oe_stat_button" icon="fa-calendar-check-o"
                            type="object" name="action_open_booking_page"
                            invisible="not booking_appointment_type_id or call_free_slot_count_7d &lt; 0">
                        <field name="call_free_slot_count_7d" widget="statinfo"
                               string="Free slots (7d)"/>
                    </button>
                </div>
            </xpath>

            <!-- Hidden check fields + readiness alert panel at top of Email page -->
            <xpath expr="//page[@name='email_page']/group[1]" position="before">
                <field name="call_check_template" invisible="1"/>
                <field name="call_check_booking_button" invisible="1"/>
                <field name="call_check_appointment" invisible="1"/>
                <field name="call_check_staff" invisible="1"/>

                <div class="alert alert-danger" role="alert"
                     invisible="call_readiness_state != 'wont_send'">
                    <strong>Won't send.</strong> Fix the blocking items:
                    <ul class="mb-0">
                        <li invisible="call_check_booking_button">
                            Email template has no Book-a-call button
                            (<code>object.booking_url</code>).
                        </li>
                        <li invisible="call_check_appointment">
                            No appointment type is set.
                        </li>
                    </ul>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="call_readiness_state != 'needs_attention'">
                    <strong>Needs attention.</strong>
                    <ul class="mb-0">
                        <li invisible="call_check_staff">
                            No booking-calendar staff on the appointment type —
                            candidates may see no slots.
                        </li>
                    </ul>
                </div>
                <div class="alert alert-success" role="alert"
                     invisible="call_readiness_state != 'ready'">
                    <i class="fa fa-check-circle me-1"/>
                    Ready to send — the call invite will render a working
                    booking button.
                </div>
            </xpath>

            <!-- Toggle is_call_stage right after mail_template_id.
                 NB: this lands inside the foundation's email_page <group> — keep
                 ONLY <field> elements here; a bare <div> in a <group> breaks the
                 2-column grid. The "no booking button" warning is already
                 surfaced by the readiness alert panel above (outside the group). -->
            <xpath expr="//page[@name='email_page']//field[@name='mail_template_id']" position="after">
                <field name="is_call_stage" widget="boolean_toggle" string="This is a Call Stage"/>
            </xpath>

            <!-- All call-stage fields after the toggle -->
            <xpath expr="//page[@name='email_page']//field[@name='is_call_stage']" position="after">

                <field name="booking_appointment_type_id"
                       invisible="not is_call_stage"
                       required="is_call_stage"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>

                <field name="call_booked_stage_id"
                       invisible="not is_call_stage"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                       help="Auto-populated to the shipped 'Call Booked' stage. Override only for advanced setups."/>

                <!-- v17.0.24.0.0 — HIDDEN. Booking staff/calendars are now
                     configured on the Appointment Type directly (its
                     staff_user_ids), which is the single source of truth for
                     slots. Field kept invisible (data dormant) for easy
                     rollback; remove invisible="1" to restore. -->
                <field name="recruiter_user_ids"
                       widget="many2many_tags"
                       invisible="1"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>

                <field name="interviewer_user_ids"
                       widget="many2many_tags"
                       invisible="not is_call_stage"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                       help="Extra participants (e.g. CEO) added to every call booked from this stage. They get the calendar invite with the Meet link and their photo is shown to the candidate on the booking page. They do NOT affect slot availability. Seeded as the default on each candidate entering this stage; editable per-candidate."/>

                <field name="what_to_expect"
                       invisible="not is_call_stage"
                       placeholder="One line = one bullet, e.g.&#10;30-min technical discussion&#10;Questions about your background&#10;Bring any portfolio you'd like to show"
                       help="Shown to the candidate on the booking page as a 'What to expect' bullet list (one line per bullet). Leave empty to hide the panel."/>

            </xpath>

            <!-- Info note + "Wired to" deep-link chips at the end of the page -->
            <xpath expr="//page[@name='email_page']" position="inside">

                <p class="text-muted mt-2" invisible="not is_call_stage">
                    <i class="fa fa-info-circle"/>
                    Your assigned email template should include a
                    <b>Book a call</b> button rendered via
                    <code>object.booking_url</code>.
                    The link is per-candidate and resolves at email
                    render time; you do not need to paste anything.
                </p>

                <div class="mt-2" invisible="not is_call_stage">
                    <span class="text-muted me-2">Wired to:</span>
                    <button name="action_open_call_template" type="object"
                            class="btn btn-sm btn-secondary me-1"
                            icon="fa-envelope-o" string="Template"
                            invisible="not call_check_template"/>
                    <button name="action_open_appointment_type" type="object"
                            class="btn btn-sm btn-secondary"
                            icon="fa-calendar" string="Appointment"
                            invisible="not booking_appointment_type_id"/>
                </div>

            </xpath>

        </field>
    </record>

</odoo>
