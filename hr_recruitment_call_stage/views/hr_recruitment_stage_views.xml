<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        v17.0.24.18.0 — "Configure Call Stage" button on the stage form.

        The Applications kanban stage gear → Edit opens this (global)
        hr.recruitment.stage form. This button jumps to the per-(job, stage)
        hr.job.stage.config for the vacancy currently in context
        (default_job_id), opening it as a focused dialog. It sits in the shared
        <header> anchor declared by hr_recruitment_job_stage_config, next to the
        Fireflies "Interview Questions" button.

        Visible only when a job is in context (kanban-gear entry); hidden on the
        global Settings → Stages form where there is no vacancy to scope to.
    -->
    <record id="view_hr_recruitment_stage_form_call_buttons" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.call.buttons</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id"
               ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_call_config_for_job"
                        type="object"
                        string="Configure Call Stage"
                        icon="fa-phone"
                        class="oe_highlight"
                        invisible="not context.get('default_job_id')"
                        help="Open the per-job call settings (appointment type, email template, booking URL, interviewers) for this stage on the vacancy you are working in."/>
            </xpath>
        </field>
    </record>

</odoo>
