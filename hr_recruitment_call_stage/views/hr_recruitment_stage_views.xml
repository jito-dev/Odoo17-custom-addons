<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        v17.0.7.2.0 — Etap 9.

        The native kanban gear icon on a stage column opens
        `hr_recruitment.hr_recruitment_stage_form`. Call Stage knobs
        live on `hr.job.stage.config` (per (job, stage)) — they cannot
        be edited inline on the stage form because the stage is global
        across jobs.

        Strategy: a header action button that opens the SINGLE
        per-(current job, this stage) config row in a focused modal.
        Only visible when context.default_job_id is set (i.e. the
        recruiter opened this stage from a specific vacancy's
        Applications kanban). Otherwise an info banner guides them
        to the correct entry point.
    -->
    <record id="view_hr_recruitment_stage_form_call_inherit"
            model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.call.inherit</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id"
               ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="is_call_booked_companion_for_job" invisible="1"/>
                    <button name="action_configure_call_stage_for_job"
                            type="object"
                            string="Configure Call Stage for This Job"
                            class="oe_highlight"
                            icon="fa-phone"
                            invisible="not context.get('default_job_id') or is_call_booked_companion_for_job"
                            help="Open the per-job call settings (appointment type, email template, booking URL, recruiters) for this stage on the vacancy you're currently working in."/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning mt-3"
                     role="alert"
                     invisible="not is_call_booked_companion_for_job">
                    <i class="fa fa-link me-2" title="Information" role="img" aria-label="Information"/>
                    This is the <b>Call Booked</b> companion of a Call Stage on this
                    vacancy — a status stage candidates land on after they book. It is
                    managed by its paired Call Stage, so there is nothing to configure
                    here (including Fireflies interview questions — set those on the
                    Call Stage itself).
                </div>
                <div class="alert alert-info mt-3"
                     role="alert"
                     invisible="context.get('default_job_id')">
                    <i class="fa fa-info-circle me-2" title="Information" role="img" aria-label="Information"/>
                    <b>Per-job call settings</b> (appointment type,
                    booking URL, recruiters) are configured per vacancy.
                    To edit them, open this stage from a specific
                    vacancy's Applications kanban
                    (<b>Recruitment → Vacancies → [job] → Applications</b>),
                    or use the Job form → <b>Stages</b> tab.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
