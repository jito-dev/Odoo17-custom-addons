<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.timesheet.rounding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='time_encoding_setting_container']" position="after">
                <block title="All Tracking Rounding" name="jito_tracking_rounding_container">
                    <setting id="timesheet_rounding_enabled"
                             company_dependent="1"
                             string="Enable company hours tracking rounding"
                             help="Tracked time (Hours Spent) is rounded to the nearest step below when a timesheet is saved. Nothing is rejected and nothing has to be corrected by hand. Entries already in the database keep their value — a duration is only rounded when someone enters or edits it.">
                        <field name="timesheet_rounding_enabled"/>
                        <div class="content-group" invisible="not timesheet_rounding_enabled">
                            <div class="mt16">
                                <label for="timesheet_rounding_step" class="o_light_label"/>
                                <field name="timesheet_rounding_step" class="oe_inline"/>
                            </div>
                            <div class="text-muted mt8">
                                Durations snap to the nearest step, halves upwards:
                                on a 15-minute step 1:07 becomes 1:00 and 1:08 becomes 1:15.
                                Anything above zero is worth at least one full step,
                                so 5 minutes becomes 15 rather than disappearing.
                            </div>
                            <div class="text-muted mt8">
                                The value is corrected as soon as the user leaves the field,
                                with a short note explaining what changed.
                            </div>
                            <div class="text-muted mt8">
                                Existing entries are never rewritten in bulk, and an edit that
                                only changes the description or the task leaves the duration alone.
                            </div>
                            <div class="text-muted mt8">
                                Timesheets generated from time off keep the exact duration of the
                                leave they belong to, and the timer is aligned with this step.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
