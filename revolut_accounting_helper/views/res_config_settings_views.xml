<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_revolut" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.revolut.drive</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Revolut Helper" name="revolut_accounting_helper"
                     groups="revolut_accounting_helper.group_revolut_user">
                    <block title="Google Drive Integration" name="google_drive_settings">
                        <setting string="Client ID"
                                 help="OAuth 2.0 Client ID from Google Cloud Console. Add '{base_url}/google/drive/callback' as an Authorised redirect URI.">
                            <field name="google_drive_client_id" placeholder="xxxx.apps.googleusercontent.com"/>
                        </setting>
                        <setting string="Client Secret"
                                 help="OAuth 2.0 Client Secret from Google Cloud Console.">
                            <field name="google_drive_client_secret" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
