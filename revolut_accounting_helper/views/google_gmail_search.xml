<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_gmail_search_wizard" model="ir.ui.view">
        <field name="name">google.gmail.search.wizard.form</field>
        <field name="model">google.gmail.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Gmail Search">
                <header>
                    <button name="action_search_emails"
                            type="object"
                            string="Search in Gmail"
                            class="btn-primary"
                            icon="fa-search"/>
                    <button name="action_clear_search"
                            type="object"
                            string="Clear"
                            class="btn-secondary"
                            icon="fa-times"/>
                </header>
                <sheet>
                    <field name="search_performed" invisible="1"/>
                    <field name="can_go_prev" invisible="1"/>
                    <field name="can_go_next" invisible="1"/>

                    <style>
                        .o_control_panel { display: none !important; }
                        .gmail_email_card { border: 1px solid #e0e0e0; border-radius: 8px; background: #fff; }
                        .gmail_email_header { background: #f8f9fa; border-bottom: 1px solid #e0e0e0; border-radius: 8px 8px 0 0; padding: 16px 20px; }
                        .gmail_email_meta { padding: 12px 20px; border-bottom: 1px solid #f0f0f0; font-size: 0.9em; }
                        .gmail_email_meta .meta-row { margin-bottom: 4px; }
                        .gmail_email_meta .meta-label { color: #666; min-width: 50px; display: inline-block; }
                        .gmail_email_body { padding: 20px; min-height: 80px; }
                        .gmail_email_attachments { background: #fafafa; border-top: 1px solid #e0e0e0; border-radius: 0 0 8px 8px; padding: 12px 20px; }
                        .gmail_nav_bar { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 10px 16px; }
                        .o_field_html iframe { max-width: 100% !important; }
                    </style>

                    <!-- ── Search inputs ─────────────────────────────────────── -->
                    <group>
                        <group string="Search Criteria">
                            <field name="mixed_input"
                                   placeholder="e.g.  10 Jan, 2026  Slack invoice"/>
                            <field name="search_keywords"
                                   placeholder="invoice  payment  Slack…"/>
                            <field name="target_date"/>
                            <field name="search_range"/>
                        </group>
                        <group string="Options">
                            <field name="with_attachment" widget="boolean_toggle"/>
                            <field name="max_results"/>
                        </group>
                    </group>

                    <!-- ── Gmail query display ──────────────────────────────── -->
                    <div class="alert alert-info mt-3" role="alert">
                        <strong><i class="fa fa-code"/> Gmail Query:</strong>
                        <field name="gmail_query"
                               readonly="1"
                               force_save="1"
                               class="fw-bold mt-1 oe_inline"
                               style="font-family: monospace; font-size: 1.05em; display: block;"/>
                    </div>
                    <div class="text-muted mb-4" style="font-size: 0.85em;">
                        <i class="fa fa-calendar me-1"/>
                        <field name="date_range_display"
                               readonly="1"
                               force_save="1"
                               class="oe_inline"/>
                    </div>

                    <div class="alert alert-warning"
                         invisible="not search_performed or results_count != 0"
                         role="alert">
                        <i class="fa fa-inbox me-2"/>
                        No emails found matching your search criteria.
                    </div>

                    <!-- ══ Results section ══════════════════════════════════════ -->
                    <div invisible="results_count == 0">

                        <div class="gmail_nav_bar d-flex justify-content-between align-items-center mb-3">
                            <button name="action_prev_result"
                                    type="object"
                                    string="← Previous"
                                    class="btn btn-outline-secondary btn-sm"
                                    invisible="not can_go_prev"/>
                            <div style="width: 95px;" invisible="can_go_prev"/>

                            <span class="text-muted fw-semibold" style="font-size: 0.95em;">
                                <i class="fa fa-envelope-o me-1"/>
                                Email&#160;<field name="current_result_number"
                                                  readonly="1"
                                                  class="oe_inline"
                                                  style="display: inline; width: auto;"/>&#160;of&#160;<field name="results_count"
                                                  readonly="1"
                                                  class="oe_inline"
                                                  style="display: inline; width: auto;"/>
                            </span>

                            <button name="action_next_result"
                                    type="object"
                                    string="Next →"
                                    class="btn btn-outline-secondary btn-sm"
                                    invisible="not can_go_next"/>
                            <div style="width: 73px;" invisible="can_go_next"/>
                        </div>

                        <!-- ── Email card ──────────────────────────────────── -->
                        <div class="gmail_email_card mb-4">
                            <div class="gmail_email_attachments"
                                 invisible="not current_attachment_ids">
                                <div class="mb-2 fw-semibold" style="font-size: 0.9em;">
                                    <i class="fa fa-paperclip me-1"/>
                                    Attachments
                                </div>
                                <field name="current_attachment_ids"
                                       readonly="1"
                                       nolabel="1">
                                    <tree string="Attachments" editable="false" decoration-muted="not name">
                                        <field name="name" string="File Name"/>
                                        <field name="mime_type" string="Type" optional="show"/>
                                        <field name="size_display" string="Size" optional="show"/>
                                        <button name="action_download"
                                                type="object"
                                                string="Download"
                                                icon="fa-download"
                                                class="btn btn-sm btn-primary"/>
                                    </tree>
                                </field>
                            </div>

                            <!-- Subject header -->
                            <div class="gmail_email_header">
                                <h4 class="mb-0 fw-bold text-dark" style="line-height: 1.3;">
                                    <i class="fa fa-envelope-o me-2 text-primary"/>
                                    <field name="current_subject"
                                           readonly="1"
                                           class="oe_inline"
                                           placeholder="(No Subject)"/>
                                </h4>
                            </div>

                            <!-- Email metadata -->
                            <div class="gmail_email_meta">
                                <div class="meta-row">
                                    <span class="meta-label fw-semibold">From:</span>
                                    <field name="current_sender"
                                           readonly="1"
                                           class="oe_inline"/>
                                </div>
                                <div class="meta-row" invisible="not current_to">
                                    <span class="meta-label fw-semibold">To:</span>
                                    <field name="current_to"
                                           readonly="1"
                                           class="oe_inline"/>
                                </div>
                                <div class="meta-row" invisible="not current_cc">
                                    <span class="meta-label fw-semibold">CC:</span>
                                    <field name="current_cc"
                                           readonly="1"
                                           class="oe_inline"/>
                                </div>
                                <div class="meta-row">
                                    <span class="meta-label fw-semibold">Date:</span>
                                    <field name="current_date_str"
                                           readonly="1"
                                           class="oe_inline text-muted"/>
                                </div>
                            </div>

                            <!-- Email body: HTML version -->
                            <div class="gmail_email_body" invisible="not current_body_html">
                                <field name="current_body_html"
                                       readonly="1"
                                       widget="html"
                                       nolabel="1"
                                       style="max-width: 100%; overflow-x: auto;"/>
                            </div>

                            <!-- Email body: plain-text fallback -->
                            <div class="gmail_email_body"
                                 invisible="current_body_html">
                                <div invisible="not current_body_text">
                                    <field name="current_body_text"
                                           readonly="1"
                                           nolabel="1"
                                           style="white-space: pre-wrap; font-family: inherit; font-size: 0.95em; line-height: 1.6;"/>
                                </div>
                                <!-- Snippet fallback when no body at all -->
                                <div invisible="current_body_text"
                                     class="text-muted fst-italic">
                                    <i class="fa fa-comment-o me-1"/>
                                    <field name="current_snippet"
                                           readonly="1"
                                           class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helper_google_gmail" model="ir.actions.act_window">
        <field name="name">Gmail Search</field>
        <field name="res_model">google.gmail.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
