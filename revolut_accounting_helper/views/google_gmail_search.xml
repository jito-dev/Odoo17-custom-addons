<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard: Gmail search form ─────────────────────────────────────────── -->
    <record id="view_google_gmail_search_wizard" model="ir.ui.view">
        <field name="name">google.gmail.search.wizard.form</field>
        <field name="model">google.gmail.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Gmail Search">
                <header>
                    <button name="action_search_emails"
                            type="object"
                            string="Search in Gmail"
                            class="btn-primary"
                            icon="fa-search"/>
                    <button name="action_clear_search"
                            type="object"
                            string="Clear"
                            class="btn-secondary"
                            icon="fa-times"/>
                </header>
                <sheet>
                    <field name="search_performed" invisible="1"/>
                    <field name="results_count" invisible="1"/>

                    <style>
                        .o_control_panel { display: none !important; }
                        .gmail_results_summary {
                            background: #f0f4ff;
                            border: 1px solid #c9d4ff;
                            border-radius: 6px;
                            padding: 8px 14px;
                            font-size: 0.9em;
                            margin-bottom: 10px;
                        }
                        /* prevent Odoo's html-field wrapper from adding extra padding/margin */
                        .o_field_html .odoo-editor-editable {
                            padding: 0 !important;
                            margin: 0 !important;
                        }
                        /* remove extra spacing Odoo injects around the html widget */
                        .o_field_html {
                            padding: 0 !important;
                            margin: 0 !important;
                        }
                        /* ensure email cards do not collapse their bottom margin */
                        .gmail_cards_container > div {
                            margin-bottom: 16px !important;
                        }
                    </style>

                    <!-- ── Search inputs ──────────────────────────────────── -->
                    <group>
                        <group string="Search Criteria">
                            <field name="mixed_input"
                                   placeholder="e.g.  10 Jan, 2026  Slack invoice"/>
                            <field name="search_keywords"
                                   placeholder="invoice  payment  Slack…"/>
                            <field name="target_date"/>
                            <field name="search_range"/>
                        </group>
                        <group string="Options">
                            <field name="with_attachment" widget="boolean_toggle"/>
                            <field name="max_results"/>
                        </group>
                    </group>

                    <!-- ── Gmail query display ────────────────────────────── -->
                    <div class="alert alert-info mt-3" role="alert">
                        <strong><i class="fa fa-code"/> Gmail Query:</strong>
                        <field name="gmail_query"
                               readonly="1"
                               force_save="1"
                               class="fw-bold mt-1 oe_inline"
                               style="font-family: monospace; font-size: 1.05em; display: block;"/>
                    </div>
                    <div class="text-muted mb-3" style="font-size: 0.85em;">
                        <i class="fa fa-calendar me-1"/>
                        <field name="date_range_display"
                               readonly="1"
                               force_save="1"
                               class="oe_inline"/>
                    </div>

                    <!-- ── No results notice ──────────────────────────────── -->
                    <div class="alert alert-warning"
                         invisible="not search_performed or results_count != 0"
                         role="alert">
                        <i class="fa fa-inbox me-2"/>
                        No emails found matching your search criteria.
                    </div>

                    <!-- ── Results: all email cards rendered inline ───────── -->
                    <div invisible="results_count == 0">
                        <div class="gmail_results_summary d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa fa-envelope-o me-1 text-primary"/>
                                Found
                                <strong>
                                    <field name="results_count"
                                           readonly="1"
                                           class="oe_inline"
                                           style="display: inline; width: auto;"/>
                                </strong>
                                email(s)
                            </span>
                        </div>

                        <field name="results_html"
                               widget="html"
                               readonly="1"
                               nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helper_google_gmail" model="ir.actions.act_window">
        <field name="name">Gmail Search</field>
        <field name="res_model">google.gmail.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
