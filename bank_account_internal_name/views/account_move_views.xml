<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer invoice → Other Info: add "Recipient Bank Internal Name" right
         after the Recipient Bank, so you can select the bank by its internal name.
         Anchored before qr_code_method (the field that immediately follows the
         customer-side Recipient Bank, and is unique in the form). -->
    <record id="view_move_form_recipient_bank_internal_name" model="ir.ui.view">
        <field name="name">account.move.form.recipient.bank.internal.name</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qr_code_method']" position="before">
                <field name="recipient_bank_internal_id"
                       context="{'default_partner_id': bank_partner_id, 'display_account_trust': True, 'bank_by_internal_name': 1}"
                       domain="[('partner_id.ref_company_ids', 'parent_of', company_id)]"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- Keep the stock "Recipient Bank" showing the IBAN, always.

         `bank_by_internal_name` is an opt-in context key: `res.partner.bank`
         shows its internal name instead of the IBAN when it is set. Odoo's web
         client, however, merges the context of the field being edited into the
         context of the whole `onchange` RPC (see `getFieldsSpec` /
         `evalPartialContext` in `web/static/src/model/relational_model/utils.js`).
         So the moment the user picks an account in the field above, every bank
         field in that response inherits the key — and `partner_bank_id` came back
         reading "jito.usd" instead of the account number until the page was
         reloaded.

         A field's own spec context wins over the request context, so both
         `partner_bank_id` nodes of the stock form say the key is off. The whole
         attribute has to be restated (`<attribute add=...>` appends to a string
         and would break the dict), so it repeats the stock value — check it
         against `account/views/account_move_views.xml` when upgrading Odoo. -->
    <record id="view_move_form_recipient_bank_keeps_iban" model="ir.ui.view">
        <field name="name">account.move.form.recipient.bank.keeps.iban</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- vendor bills, in the header -->
            <xpath expr="//field[@name='payment_reference']/following-sibling::field[@name='partner_bank_id'][1]"
                   position="attributes">
                <attribute name="context">{'default_partner_id': bank_partner_id, 'display_account_trust': True, 'bank_by_internal_name': False}</attribute>
            </xpath>
            <!-- customer invoices, Other Info -->
            <xpath expr="//field[@name='invoice_origin']/following-sibling::field[@name='partner_bank_id'][1]"
                   position="attributes">
                <attribute name="context">{'default_partner_id': bank_partner_id, 'display_account_trust': True, 'bank_by_internal_name': False}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
