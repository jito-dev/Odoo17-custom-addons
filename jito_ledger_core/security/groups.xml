<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module category for the Management Ledger feature -->
        <record id="module_category_mgmt_ledger" model="ir.module.category">
            <field name="name">Management Ledger</field>
            <field name="description">Access to the management-accounting layer (Non-Leading Ledger, Extension Ledgers, semantic adjustments).</field>
            <field name="sequence">20</field>
        </record>

        <!-- Accountant: extends account.group_account_user (per PRD §Security Matrix) -->
        <record id="group_mgmt_ledger_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="category_id" ref="module_category_mgmt_ledger"/>
            <field name="comment">Day-to-day accounting in the management-ledger layer. Cannot perform destructive reversal of management adjustments.</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <!-- Senior Accountant: extends account.group_account_manager -->
        <record id="group_mgmt_ledger_senior_accountant" model="res.groups">
            <field name="name">Senior Accountant</field>
            <field name="category_id" ref="module_category_mgmt_ledger"/>
            <field name="comment">Senior accounting role with permission to perform destructive reversal of management adjustments.</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager')), (4, ref('group_mgmt_ledger_accountant'))]"/>
        </record>

        <!-- Finance Manager / CFO: extends account.group_account_manager -->
        <record id="group_mgmt_ledger_finance_manager" model="res.groups">
            <field name="name">Finance Manager / CFO</field>
            <field name="category_id" ref="module_category_mgmt_ledger"/>
            <field name="comment">Finance Manager / CFO. Reads all ledgers; creates and reverses management adjustments. Statutory posting to the Leading Ledger uses the standard Accounting flows.</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager')), (4, ref('group_mgmt_ledger_accountant'))]"/>
        </record>

        <!-- ERP Administrator / Solution Architect: extends base.group_system -->
        <record id="group_mgmt_ledger_admin" model="res.groups">
            <field name="name">Management Ledger Administrator</field>
            <field name="category_id" ref="module_category_mgmt_ledger"/>
            <field name="comment">Configures ledgers, FX rate feeds and semantic-layer accounts. Full administrative rights on management-ledger models.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_system')), (4, ref('group_mgmt_ledger_senior_accountant')), (4, ref('group_mgmt_ledger_finance_manager'))]"/>
        </record>

    </data>
</odoo>
