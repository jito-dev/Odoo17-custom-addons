<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jito_faap_sync_wizard_form" model="ir.ui.view">
        <field name="name">jito.ledger.faap.sync.wizard.form</field>
        <field name="model">jito.ledger.faap.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync FAAP Mirrors from Stock Chart of Accounts">
                <p class="text-muted">
                    For each stock <code>account.account</code> in the chosen company,
                    ensure a corresponding <code>jito.ledger.account</code> exists with
                    code <code>FAAP.&lt;stock_code&gt;</code>, name and type mirrored,
                    and <code>statutory_account_id</code> pointing back at the stock account.
                    Per HLD Decision #13, stock <code>account.account</code> is not modified.
                </p>
                <group>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="skip_deprecated"/>
                    <field name="skip_off_balance"/>
                    <field name="skip_equity_unaffected"/>
                    <field name="update_existing"/>
                </group>
                <footer>
                    <button name="action_sync"
                            type="object"
                            string="Run Sync"
                            class="oe_highlight"/>
                    <button special="cancel"
                            string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jito_faap_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync FAAP Mirrors from Stock CoA</field>
        <field name="res_model">jito.ledger.faap.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!--
        Server action with model binding — adds "Sync FAAP Mirrors from
        Stock CoA" to the Action (cog ⚙) dropdown of any list view of
        jito.ledger.account. Restricted to group_mgmt_ledger_admin so
        non-admins don't see it.

        We use a server action (instead of a tree <header> button)
        because Odoo 17's tree <header> buttons only appear when records
        are selected — useless when the FAAP list is empty before the
        first sync.

        The action is bound to all list views of the model, so it shows
        in both "Managerial CoA" and "FAAP Mirrors" cog menus. The
        explicit name disambiguates regardless of which list the user is
        looking at.
    -->
    <record id="action_jito_faap_sync_server" model="ir.actions.server">
        <field name="name">Sync FAAP Mirrors from Stock CoA</field>
        <field name="model_id" ref="jito_ledger_core.model_jito_ledger_account"/>
        <field name="binding_model_id" ref="jito_ledger_core.model_jito_ledger_account"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('jito_ledger_core.group_mgmt_ledger_admin'))]"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Sync FAAP Mirrors from Stock CoA',
    'res_model': 'jito.ledger.faap.sync.wizard',
    'view_mode': 'form',
    'target': 'new',
}</field>
    </record>

</odoo>
