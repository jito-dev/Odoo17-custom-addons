<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- jito.ledger.account.category views (17.0.3.0.0)              -->
    <!-- User-defined buckets so reports can roll up similar accounts -->
    <!-- (e.g. FAAP.Sales_NA + MGT.Sales → "Sales") into one subtotal.-->
    <!-- ============================================================ -->

    <record id="view_jito_ledger_account_category_tree" model="ir.ui.view">
        <field name="name">jito.ledger.account.category.tree</field>
        <field name="model">jito.ledger.account.category</field>
        <field name="arch" type="xml">
            <tree string="Account Categories" sample="1" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="account_count" string="# Accounts"/>
                <field name="description" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_jito_ledger_account_category_form" model="ir.ui.view">
        <field name="name">jito.ledger.account.category.form</field>
        <field name="model">jito.ledger.account.category</field>
        <field name="arch" type="xml">
            <form string="Account Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales, Expenses, Working Capital"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="account_count" string="Accounts assigned"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="What does this category represent? Which kinds of accounts should be assigned to it?"/>
                    </group>
                    <notebook>
                        <page string="Accounts in this category" name="accounts">
                            <!--
                                17.0.3.1.0 — "Add existing accounts..."
                                opens a wizard to bulk-assign existing
                                accounts (across all semantic families
                                — FAAP mirrors AND NL alike).
                                The "x" button on each row clears the
                                account's category_id (preserves the
                                account, only unassigns it from this
                                category).
                            -->
                            <div>
                                <button name="action_add_accounts"
                                        type="object"
                                        class="btn btn-link"
                                        icon="fa-plus"
                                        string="Add existing accounts..."/>
                            </div>
                            <field name="account_ids" readonly="1">
                                <tree create="false" delete="false" edit="true">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="semantic_family"/>
                                    <field name="account_type"/>
                                    <button name="action_remove_from_category"
                                            type="object"
                                            icon="fa-times"
                                            title="Remove from category"
                                            confirm="Remove this account from the category?"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_jito_ledger_account_category_kanban" model="ir.ui.view">
        <field name="name">jito.ledger.account.category.kanban</field>
        <field name="model">jito.ledger.account.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="account_count"/>
                <field name="description"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       data-bs-display="static"
                                       href="#"
                                       aria-label="Dropdown menu"
                                       title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="description"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-secondary">
                                        <field name="account_count"/> accounts
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_jito_ledger_account_category_search" model="ir.ui.view">
        <field name="name">jito.ledger.account.category.search</field>
        <field name="model">jito.ledger.account.category</field>
        <field name="arch" type="xml">
            <search string="Account Categories">
                <field name="name"/>
                <separator/>
                <filter string="Archived"
                        name="archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_jito_ledger_account_category" model="ir.actions.act_window">
        <field name="name">Account Categories</field>
        <field name="res_model">jito.ledger.account.category</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_jito_ledger_account_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Account Category
            </p>
            <p>
                Categories let you group similar
                <code>jito.ledger.account</code> rows (e.g.
                <code>FAAP.Sales_NA</code> + <code>MGT.Sales</code>) so the
                Trial Balance and General Ledger reports roll them up into one
                subtotal. Common buckets: Sales, Cost of Goods Sold,
                Operating Expenses, Working Capital, Equity.
            </p>
            <p>
                Accounts without a category appear under
                "(Uncategorized)" in reports.
            </p>
        </field>
    </record>

</odoo>
