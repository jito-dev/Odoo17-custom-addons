<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_tm_billing_run_export_wizard_form" model="ir.ui.view">
        <field name="name">tm.billing.run.export.wizard.form</field>
        <field name="model">tm.billing.run.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Timesheets">
                <sheet>
                    <div class="oe_title">
                        <h1>Export Timesheets</h1>
                    </div>

                    <!-- Billing Run Summary -->
                    <group>
                        <group>
                            <field name="billing_run_id" readonly="1" invisible="1"/>
                            <label for="client_id" string="Client"/>
                            <div>
                                <field name="client_id" readonly="1" class="oe_inline"/>
                            </div>
                            <label for="date_start" string="Period"/>
                            <div>
                                <field name="date_start" readonly="1" class="oe_inline"/>
                                <span class="mx-2">to</span>
                                <field name="date_end" readonly="1" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="timesheet_count" readonly="1"/>
                            <field name="total_hours" readonly="1"/>
                            <field name="total_amount" readonly="1" widget="monetary"/>
                            <field name="currency_id" readonly="1" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info mb-3" role="alert" style="margin: 10px 0;">
                        <i class="fa fa-info-circle"></i>
                        <strong>Note:</strong> Only included timesheets will be exported. Use the buttons below to download in your preferred format.
                    </div>

                    <!-- Preview -->
                    <notebook>
                        <page string="Timesheet Preview" name="preview">
                            <field name="preview_data" nolabel="1" widget="html"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Footer with Export Buttons -->
                <footer>
                    <button name="action_export_pdf" type="object"
                            string="Advanced Export"
                            class="btn-primary"
                            icon="fa-list"/>
                    <button name="action_export_csv" type="object"
                            string="Export CSV"
                            class="btn-primary"
                            icon="fa-file-text-o"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_tm_billing_run_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Timesheets</field>
        <field name="res_model">tm.billing.run.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_tm_billing_run"/>
    </record>

</odoo>
