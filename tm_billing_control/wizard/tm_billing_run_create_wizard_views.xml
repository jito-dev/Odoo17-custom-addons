<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tm_billing_run_create_wizard_form" model="ir.ui.view">
        <field name="name">tm.billing.run.create.wizard.form</field>
        <field name="model">tm.billing.run.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Billing Run">
                <sheet>
                    <!-- Hidden fields used in modifier expressions -->
                    <field name="preview_ready" invisible="1"/>
                    <field name="available_client_ids" invisible="1"/>
                    <field name="available_currency_ids" invisible="1"/>

                    <div class="oe_title">
                        <h1>Create Billing Run</h1>
                    </div>

                    <!-- Period (read-only, pre-filled from dashboard) + Options -->
                    <group>
                        <group string="Period">
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group string="Options">
                            <field name="group_by_project"/>
                            <field name="group_by_month"/>
                        </group>
                    </group>

                    <!-- Available combinations table with per-row Create buttons -->
                    <notebook>
                        <page string="Available Billing Combinations" name="combinations">
                            <field name="line_ids"
                                   mode="tree"
                                   nolabel="1"
                                   style="min-height: 300px;">
                                <tree
                                    string="Available Billing Combinations"
                                    create="0" edit="0" delete="0"
                                    limit="20"
                                    decoration-muted="timesheet_count == 0">
                                    <field name="client_id" string="Client" readonly="1"/>
                                    <field name="currency_id" string="Currency" readonly="1"
                                           widget="badge"/>
                                    <field name="timesheet_count" string="Timesheets" readonly="1"/>
                                    <field name="hours_spent" string="Hours Spent"
                                           readonly="1" sum="Total Hours Spent" widget="float_time"/>
                                    <field name="adjusted_hours" string="Adjusted Hours"
                                           readonly="1" sum="Total Adjusted Hours" widget="float_time"/>
                                    <field name="amount" string="Est. Amount"
                                           readonly="1" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Total Est. Amount"/>
                                    <button name="action_create_billing_run"
                                            type="object"
                                            string="Create Billing Run"
                                            icon="fa-plus"
                                            class="btn-primary btn-sm"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Manual selection (fallback) -->
                        <page string="Manual Selection" name="manual">
                            <group>
                                <group string="Select Combination">
                                    <field name="client_id"
                                           domain="[('id', 'in', available_client_ids)]"
                                           options="{'no_create': True, 'no_quick_create': True}"/>
                                    <field name="currency_id"
                                           domain="[('id', 'in', available_currency_ids)]"
                                           options="{'no_create': True, 'no_quick_create': True}"/>
                                </group>
                                <group string="Preview" invisible="not preview_ready">
                                    <field name="preview_timesheet_count" string="Timesheets" readonly="1"/>
                                    <field name="preview_hours_spent" string="Hours Spent" readonly="1" widget="float_time"/>
                                    <field name="preview_adjusted_hours" string="Adjusted Hours" readonly="1" widget="float_time"/>
                                    <field name="preview_currency_id" invisible="1"/>
                                    <label for="preview_amount" string="Est. Billable Amount"/>
                                    <div class="o_row">
                                        <field name="preview_amount" class="oe_inline"
                                               widget="monetary"
                                               options="{'currency_field': 'preview_currency_id'}"
                                               readonly="1"/>
                                    </div>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-2" role="alert"
                                 invisible="preview_ready or not client_id or not currency_id">
                                <i class="fa fa-exclamation-triangle"/>
                                No billable timesheets found for the selected combination in this period.
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <!-- Only shown when manual selection is ready -->
                    <button name="action_create_billing_run"
                            type="object"
                            string="Create from Manual Selection"
                            class="btn-primary"
                            icon="fa-plus"
                            invisible="not preview_ready"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
