<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Tree View for Timesheet Export -->
    <record id="view_account_analytic_line_export_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.export.tree</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree string="Timesheets" create="false" edit="false" delete="false">
                <field name="date" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="task_id" optional="show"/>
                <field name="name" optional="show"/>
                <field name="unit_amount" string="Hours Spent" sum="Total Hours Spent" optional="show"/>
                <field name="tm_adjusted_hours" string="Adjusted Hours" sum="Total Adjusted Hours" optional="show"/>
                <field name="tm_billing_rate" string="Billing Rate" optional="show"/>
                <field name="tm_billable_amount" string="Billable Amount" sum="Total Amount" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="department_id" optional="hide"/>
                <field name="so_line" string="Sales Order Item" optional="hide"/>
                <field name="timesheet_invoice_id" string="Invoice" optional="hide"/>
                <field name="partner_id" optional="hide"/>
            </tree>
        </field>
    </record>

</odoo>
