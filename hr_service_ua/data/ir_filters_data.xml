<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="filter_garazd_hr_service" model="ir.filters">
        <field name="name">Garazd Creation | UA HR Services</field>
        <field name="model_id">ir.module.module</field>
        <field name="user_id" eval="False"/>
        <field name="domain">[("author", "=", "Garazd Creation"), ("name", "like", "hr_")]</field>
