<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_vacancy_list" model="ir.actions.act_window">
        <field name="name">Vacancies</field>
        <field name="res_model">hr.job</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'kanban', 'view_id': ref('hr_recruitment.view_hr_job_kanban')})]"/>
        <field name="context">{'default_djinni_account_id': active_id}</field>
        <field name="domain">[('djinni_account_id', '=', active_id)]</field>
    </record>

    <record id="view_djinni_account_form" model="ir.ui.view">
        <field name="name">djinni.account.form</field>
        <field name="model">djinni.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_sync"
                        string="Synchronization"
                        type="object"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_vacancy_list)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-briefcase"
                                string="">
                            <field name="job_count" string="Vacancies" widget="statinfo"/>
                        </button>
                        <button name="action_open_sync_logs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                string="">
                            <field name="sync_log_count" string="Sync Logs" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Account Name"/></h1>
                    </div>
                    <group>
                        <label for="authorization_type"/>
                        <field name="authorization_type" widget="radio" options="{'horizontal': true}"/>
                        <group>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="secret" password="True" invisible="authorization_type in ['api_key',False]"/>
                            <field name="api_key" password="True" invisible="authorization_type in ['login',False]"/>
                        </group>
                    </group>
                    <group string="Technical" groups="base.group_no_one">
                        <field name="debug_mode" widget="boolean_toggle"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_djinni_accounts" model="ir.actions.act_window">
        <field name="name">Djinni Accounts</field>
        <field name="res_model">djinni.account</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_djinni_account"
        name="Accounts"
        parent="menu_djinni_configuration"
        sequence="1"
        groups="hr.group_hr_manager"
        action="action_djinni_accounts"
    />

</odoo>
