<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_applicant_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.hr_djinni</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_on_djinni"
                    class="oe_stat_button"
                    type="object"
                    icon="fa-address-card-o"
                    invisible="not djinni_candidate_url"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Open on</span>
                        <span class="o_stat_text">Djinni</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook/page" position="after">
                <page string="Djinni" name="djinni" invisible="not djinni_ref">
                    <group>
                        <group name="djinni_general">
                            <field name="djinni_date" string="Date"/>
                            <field name="djinni_contacts_revealed"/>
                        </group>
                        <group name="djinni_technical">
                            <field name="djinni_ref" string="Candidate ID"/>
                            <field name="djinni_candidate_url" invisible="1"/>
                            <field name="djinni_candidate_cv_url" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Profile from Djinni"/>
                    <field name="djinni_profile_html" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="djinni_send_acknowledgement_server_action" model="ir.actions.server">
        <field name="name">Send Acknowledgement Email</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="state">code</field>
        <field name="code">action = records.action_djinni_send_acknowledgement()</field>
        <field name="groups_id" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="hr_applicant_view_search" model="ir.ui.view">
        <field name="name">hr.applicant.search.inherit.hr_djinni</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search"/>
        <field name="arch" type="xml">
            <filter name="reserve" position="after">
                <separator/>
                <filter string="Djinni: Sourced" name="djinni_sourced"
                        domain="[('djinni_ref', '!=', False)]"/>
                <filter string="Djinni: Contacts Revealed" name="djinni_revealed"
                        domain="[('djinni_contacts_revealed', '=', True)]"/>
                <filter string="Djinni: Still Anonymous" name="djinni_anonymous"
                        domain="[('djinni_ref', '!=', False), ('partner_name', '=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="hr_kanban_view_applicant" model="ir.ui.view">
        <field name="name">hr.applicant.kanban.inherit.hr_djinni</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="djinni_ref" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]" position="inside">
                <div t-if="record.djinni_ref.value">
                    <span class="badge text-bg-light">Djinni</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
