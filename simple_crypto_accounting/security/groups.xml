<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_crypto_accounting" model="ir.module.category">
        <field name="name">Crypto Accounting</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_sca_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_crypto_accounting"/>
        <!-- 17.0.10.0.0 — partner_manager so crypto users can create/edit
             contacts and save the embedded Crypto Addresses (base.group_user
             is read-only on res.partner). Side effect: unlocks the standard
             Contacts app for them. -->
        <field name="implied_ids"
               eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_sca_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_crypto_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_sca_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
