<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree (editable) -->
    <record id="view_sca_mgt_ledger_map_tree" model="ir.ui.view">
        <field name="name">sca.mgt.ledger.map.tree</field>
        <field name="model">sca.mgt.ledger.map</field>
        <field name="arch" type="xml">
            <tree string="Management Ledger Mapping" editable="bottom">
                <field name="watched_address_id"/>
                <field name="token_id"
                       domain="[('watched_address_id', '=', watched_address_id)]"
                       options="{'no_create': True}"/>
                <field name="journal_id" options="{'no_create': True}"/>
                <field name="ledger_id" readonly="1" optional="show"/>
                <field name="asset_account_id" readonly="1" optional="show"/>
                <field name="counterpart_account_id" readonly="1" optional="show"/>
                <field name="currency_id" readonly="1" optional="show"/>
                <field name="company_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_sca_mgt_ledger_map_form" model="ir.ui.view">
        <field name="name">sca.mgt.ledger.map.form</field>
        <field name="model">sca.mgt.ledger.map</field>
        <field name="arch" type="xml">
            <form string="Management Ledger Mapping">
                <sheet>
                    <group>
                        <group string="Crypto Source">
                            <field name="watched_address_id"/>
                            <field name="token_id"
                                   domain="[('watched_address_id', '=', watched_address_id)]"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group string="Management Ledger Destination">
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="ledger_id" readonly="1"/>
                            <field name="asset_account_id" readonly="1"/>
                            <field name="counterpart_account_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Each crypto transaction posted via <strong>Inject
                        to Management Ledger</strong> on Transactions
                        consults this mapping. The generated
                        <code>jito.ledger.move</code> (entry_type
                        <code>ext_adjustment</code>) posts to the
                        chosen journal with one line on the Asset
                        Account and one balancing line on the
                        Counterpart Account — both in the chosen
                        currency.
                    </p>
                    <div class="alert alert-info" role="alert">
                        <p>
                            <strong>17.0.8.0.0 — single source of truth.</strong>
                            <em>Crypto Asset Account</em> and <em>Counterpart Account</em>
                            now come from the chosen Journal's <strong>Bank/Cash
                            Configuration</strong> group (Management Ledger →
                            Configuration → Journals → open the journal). <em>Token
                            Currency</em> comes from the Watched Token's currency
                            (open the watched address → Watched Tokens → pick a
                            preset to fill it). The mapping itself is just the
                            <strong>(wallet, token) → journal</strong> binding.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sca_mgt_ledger_map" model="ir.actions.act_window">
        <field name="name">Management Ledger Mapping</field>
        <field name="res_model">sca.mgt.ledger.map</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No management-ledger mappings yet</p>
            <p>
                Map each <strong>watched address + token</strong> to a
                management-ledger destination: a journal in a Non-Leading
                or Extension ledger, an asset account that holds the
                token balance (e.g. <code>MGT.CRYPTO.USDT</code>), and a
                counterpart account that the inflow / outflow balances
                against.
            </p>
        </field>
    </record>

</odoo>
