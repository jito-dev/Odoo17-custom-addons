<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        17.0.9.0.0 — admin-browsable cache of fetched Binance Klines
        close prices. Source-of-truth for crypto-tx USD pricing at
        management-ledger injection time.
    -->

    <record id="view_sca_price_candle_tree" model="ir.ui.view">
        <field name="name">sca.price.candle.tree</field>
        <field name="model">sca.price.candle</field>
        <field name="arch" type="xml">
            <tree string="Price Candles" create="0" delete="0">
                <field name="currency_id"/>
                <field name="timestamp"/>
                <field name="close_usd" string="Close (USD)"/>
                <field name="interval_code" string="Interval"/>
                <field name="source"/>
            </tree>
        </field>
    </record>

    <record id="view_sca_price_candle_search" model="ir.ui.view">
        <field name="name">sca.price.candle.search</field>
        <field name="model">sca.price.candle</field>
        <field name="arch" type="xml">
            <search string="Price Candles">
                <field name="currency_id"/>
                <field name="timestamp"/>
                <filter string="1 minute" name="f_1m"
                        domain="[('interval_code', '=', '1m')]"/>
                <filter string="1 hour" name="f_1h"
                        domain="[('interval_code', '=', '1h')]"/>
                <filter string="1 day" name="f_1d"
                        domain="[('interval_code', '=', '1d')]"/>
                <group expand="0" string="Group By">
                    <filter string="Currency"
                            name="group_currency"
                            context="{'group_by': 'currency_id'}"/>
                    <filter string="Interval"
                            name="group_interval"
                            context="{'group_by': 'interval_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sca_price_candle" model="ir.actions.act_window">
        <field name="name">Price Cache</field>
        <field name="res_model">sca.price.candle</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_sca_price_candle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No price candles fetched yet
            </p>
            <p>
                Cached Binance Klines close prices, populated on demand
                during management-ledger injection. The cache is
                append-only — historical prices never change.
            </p>
        </field>
    </record>

    <!-- Admin-only Configuration menu entry -->
    <menuitem id="menu_sca_price_candle"
              name="Price Cache (Binance)"
              parent="menu_sca_configuration"
              action="action_sca_price_candle"
              sequence="50"
              groups="simple_crypto_accounting.group_sca_admin"/>

</odoo>
