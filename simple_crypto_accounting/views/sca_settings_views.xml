<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sca_settings_form" model="ir.ui.view">
        <field name="name">sca.settings.form</field>
        <field name="model">sca.settings</field>
        <field name="arch" type="xml">
            <form string="Crypto Accounting Settings" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Etherscan Configuration</h1>
                    </div>
                    <group>
                        <group string="API Credentials">
                            <field name="etherscan_api_key"
                                   password="True"
                                   placeholder="Enter your Etherscan API key..."/>
                        </group>
                        <group string="Sync Info">
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p>
                            Get a free API key at
                            <strong>etherscan.io/apis</strong>.
                            The free tier allows up to 5 calls/second and 100,000 calls/day.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sca_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">sca.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
