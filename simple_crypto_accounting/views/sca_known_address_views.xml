<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sca_known_address_tree" model="ir.ui.view">
        <field name="name">sca.known_address.tree</field>
        <field name="model">sca.known_address</field>
        <field name="arch" type="xml">
            <tree string="Known Addresses" editable="top">
                <field name="name" string="Name / Alias"/>
                <field name="address" string="Address"/>
                <field name="partner_id" string="Contact" optional="show"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="action_sca_known_address" model="ir.actions.act_window">
        <field name="name">Known Addresses</field>
        <field name="res_model">sca.known_address</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
