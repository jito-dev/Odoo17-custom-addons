<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_test_task" model="ir.ui.view">
        <field name="name">hr.job.form.test.task</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='recruitment']" position="inside">
                <field name="add_test_task"/>
                <field name="test_task_url" widget="url" placeholder="https://github.com/your-org/test-task" invisible="not add_test_task"/>
                <button name="action_preview_test_task_email"
                        type="object"
                        string="Preview Invitation Email"
                        icon="fa-envelope-o"
                        class="btn-link"
                        invisible="not add_test_task"/>
            </xpath>
        </field>
    </record>
</odoo>