<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Multi-company scoping for the new Phase 4 models -->

        <record id="jito_ledger_trace_multi_company_rule" model="ir.rule">
            <field name="name">jito.ledger.trace: multi-company</field>
            <field name="model_id" ref="model_jito_ledger_trace"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('jito_ledger_core.group_mgmt_ledger_accountant')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_senior_accountant')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_finance_manager')),
                (4, ref('jito_ledger_core.group_mgmt_ledger_admin')),
            ]"/>
        </record>

