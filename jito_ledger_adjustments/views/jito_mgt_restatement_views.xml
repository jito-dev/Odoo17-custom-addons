<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jito_mgt_restatement_tree" model="ir.ui.view">
        <field name="name">jito.mgt.restatement.tree</field>
        <field name="model">jito.mgt.restatement</field>
        <field name="arch" type="xml">
            <tree string="Management Restatements"
                  sample="1"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="target_account_id"/>
                <field name="reason" optional="show"/>
                <field name="generated_move_id" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"/>
            </tree>
        </field>
    </record>

    <record id="view_jito_mgt_restatement_form" model="ir.ui.view">
        <field name="name">jito.mgt.restatement.form</field>
        <field name="model">jito.mgt.restatement</field>
        <field name="arch" type="xml">
            <form string="Management Restatement">
                <header>
                    <button name="action_post"
                            string="Post"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"
                                   placeholder="New (assigned on Post)"/>
                        </h1>
                    </div>
                    <field name="journal_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="target_account_id"
                                   string="Final Destination"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   placeholder="MGT.* — the new economic meaning"/>
                            <!--
                                17.0.7.0.0 — optional match against an
                                existing entry on the destination
                                account. When set, auto-fills Final
                                Amount, computes the FX rate, and
                                makes the FX Clearing account
                                unnecessary (same-currency match).
                                Domain on the field restricts to the
                                target account; only available after
                                Final Destination is picked.
                            -->
                            <field name="destination_line_id"
                                   string="Match Existing Entry"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   invisible="not target_account_id"
                                   placeholder="Pick an existing entry on this account (optional)"/>
                            <field name="is_fx_conversion" invisible="1"/>
                            <field name="target_currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="generated_move_id" readonly="1"
                                   invisible="not generated_move_id"/>
                        </group>
                    </group>
                    <!--
                        Cross-Currency Conversion is visible whenever
                        the source/target currencies differ — including
                        in matched mode (17.0.7.1.0). The CLR picker
                        stays required for per-currency balance; the
                        MGT-target side is auto-reconciled by the
                        match, so only the FX residual sits in CLR.
                        Final Amount becomes read-only when matched
                        (auto-filled from the picked entry).
                    -->
                    <group string="Cross-Currency Conversion"
                           invisible="not is_fx_conversion">
                        <group>
                            <label for="target_currency_id"/>
                            <div>
                                <field name="target_currency_id"
                                       readonly="1" force_save="1" nolabel="1"/>
                                <span class="text-muted">
                                    (derived from Final Destination account)
                                </span>
                            </div>
                            <field name="fx_clearing_account_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"
                                   required="is_fx_conversion"
                                   placeholder="CLR.* — holds both sides"/>
                        </group>
                        <group>
                            <field name="target_amount"
                                   readonly="state != 'draft' or destination_line_id"
                                   force_save="1"
                                   required="is_fx_conversion and state == 'posted'"
                                   placeholder="Final amount in target currency"/>
                            <field name="effective_fx_rate"
                                   readonly="1"
                                   force_save="1"/>
                        </group>
                        <p class="text-muted" colspan="2"
                           invisible="not destination_line_id">
                            <strong>Matched mode:</strong> Final Amount
                            auto-fills from the matched destination
                            entry. The full 4-line move is posted
                            (FAAP-reversal + CLR-src + MGT-target +
                            CLR-tgt); the MGT-target sign is flipped
                            against the destination so the two reconcile
                            on Post. The FX residual sits on the CLR
                            account above and surfaces at report time
                            via FR-23 — clear it manually against
                            real-world spot when applicable.
                        </p>
                    </group>
                    <!--
                        17.0.7.0.0 — same-currency match summary, shown
                        only when matched AND no FX is involved (the FX
                        section above covers cross-currency matched).
                    -->
                    <group string="Matched Destination"
                           invisible="not destination_line_id or is_fx_conversion">
                        <group>
                            <field name="target_amount"
                                   readonly="1" force_save="1"
                                   string="Final Amount (matched)"/>
                            <field name="effective_fx_rate"
                                   readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <p class="text-muted" colspan="2">
                                Final Amount auto-fills from the
                                matched entry's transaction amount.
                                On Post, the new MGT-target line is
                                reconciled against the matched entry —
                                no FX Clearing account needed.
                            </p>
                        </group>
                    </group>
                    <notebook>
                        <page string="Source Lines" name="sources">
                            <field name="source_line_ids"
                                   readonly="state != 'draft'">
                                <tree>
                                    <field name="move_id"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="currency_id" optional="hide"/>
                                    <field name="amount_currency" optional="show"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                Pick the LL <code>account.move.line</code>
                                records whose management meaning is being
                                restated. Each source line generates a
                                FAAP-reversal line + an MGT-target line in
                                the resulting <code>jito.ledger.move</code>,
                                with provenance traces linking back to the
                                source.
                            </p>
                        </page>
                        <page string="Preview" name="preview"
                              invisible="state == 'posted'">
                            <field name="preview_html" widget="html"
                                   readonly="1" nolabel="1"/>
                            <p class="text-muted">
                                Live preview of the would-be jito.ledger.move
                                lines based on current selections.
                            </p>
                        </page>
                        <!--
                            17.0.9.0.0 — Realization (FX delta allocation).
                            Visible only when cross-currency AND the
                            company-currency delta between source and
                            target market values is non-zero. The user
                            distributes that delta across P&L accounts;
                            the constraint blocks Post until the
                            remainder is zero.
                        -->
                        <page string="Realization (FX Delta)"
                              name="realization"
                              invisible="not is_fx_conversion or realization_delta == 0">
                            <group>
                                <group string="Summary">
                                    <field name="realization_delta" readonly="1"
                                           string="Delta to allocate"/>
                                    <field name="realization_allocated" readonly="1"
                                           string="Allocated"/>
                                    <field name="realization_remaining" readonly="1"
                                           string="Remaining"
                                           decoration-danger="not realization_is_complete"
                                           decoration-success="realization_is_complete"/>
                                    <field name="realization_is_complete" invisible="1"/>
                                </group>
                                <group string="Actions">
                                    <button name="action_realization_fill_remainder"
                                            type="object"
                                            string="Fill Remainder as One Row"
                                            class="btn-secondary"
                                            invisible="state != 'draft' or realization_is_complete"/>
                                    <p class="text-muted" colspan="2">
                                        Allocate the delta to P&amp;L accounts
                                        (Conversion Fee, FX Loss, etc.).
                                        Positive amounts = realized loss;
                                        negative = realized gain. The full
                                        delta must net out before posting.
                                    </p>
                                </group>
                            </group>
                            <field name="realization_line_ids"
                                   readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="account_id"
                                           options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Total Allocated"/>
                                </tree>
                            </field>
                        </page>
                        <!--
                            17.0.7.3.0 — once posted, show the actual
                            journal items generated by this restatement
                            (the lines on generated_move_id). The tab
                            replaces the Preview tab post-post since
                            preview is no longer informative once the
                            move exists.
                        -->
                        <page string="Generated Journal Items"
                              name="generated_lines"
                              invisible="state != 'posted'">
                            <field name="generated_line_ids" readonly="1">
                                <tree string="Journal Items">
                                    <field name="move_id" optional="show"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="partner_id" optional="hide"/>
                                    <field name="currency_id" optional="show"/>
                                    <field name="amount_currency"/>
                                    <!--
                                        17.0.8.0.1 — company-currency
                                        twins. The whole point of this
                                        tab is to inspect what the
                                        calibrated FX restatement
                                        posted, so debit/credit/balance
                                        default to ``optional="show"``
                                        (visible by default). For an FX
                                        restatement, these columns make
                                        the per-line company-currency
                                        balance visible — and confirm
                                        the CLR pair nets to 0.
                                    -->
                                    <field name="debit" optional="show"
                                           string="Debit (co.)"
                                           sum="Debit (co.) Total"/>
                                    <field name="credit" optional="show"
                                           string="Credit (co.)"
                                           sum="Credit (co.) Total"/>
                                    <field name="balance" optional="show"
                                           string="Balance (co.)"
                                           sum="Balance (co.) Total"/>
                                    <field name="company_currency_id"
                                           optional="hide"
                                           string="Co. Currency"/>
                                    <field name="amount_residual_currency" optional="show"/>
                                    <field name="reconciled" widget="boolean_toggle" optional="show"/>
                                    <field name="date" optional="show"/>
                                    <field name="move_state" optional="hide"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                All journal items on the generated
                                <code>jito.ledger.move</code>
                                (<field name="generated_move_id" readonly="1" nolabel="1" class="oe_inline"/>).
                                Each row links back to its parent move; click
                                a row to open the item form.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_jito_mgt_restatement" model="ir.actions.act_window">
        <field name="name">Restatements</field>
        <field name="res_model">jito.mgt.restatement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Restatement</p>
            <p>
                Re-categorize the management meaning of specific LL lines.
                Generates a balanced <code>jito.ledger.move</code> with
                provenance traces — auditors can ask "show me which
                statutory line drove this management line" and get an
                indexed answer.
            </p>
        </field>
    </record>

</odoo>
