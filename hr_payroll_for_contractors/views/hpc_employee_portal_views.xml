        groups="hr_payroll_for_contractors.group_hpc_employee"/>

    <menuitem
        id="menu_hpc_employee_contracts"
        name="My Contracts"
        parent="menu_hpc_employee_root"
        action="action_hpc_employee_contracts"
        sequence="20"
        groups="hr_payroll_for_contractors.group_hpc_employee"/>

    <menuitem
        id="menu_hpc_employee_contractor_data"
        name="My Contractor Profile"
        parent="menu_hpc_employee_root"
        action="action_hpc_employee_open_profile"
        sequence="30"
        groups="hr_payroll_for_contractors.group_hpc_employee"/>

    <menuitem
        id="menu_hpc_employee_invoices"
        name="My Invoices"
        parent="menu_hpc_employee_root"
        action="action_hpc_employee_invoices"
        sequence="40"
        groups="hr_payroll_for_contractors.group_hpc_employee"/>

</odoo>
