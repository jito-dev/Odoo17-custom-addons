<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Contractor Invoice - Tree View                               -->
    <!-- ============================================================ -->
    <record id="view_hpc_contractor_invoice_tree" model="ir.ui.view">
        <field name="name">hpc.contractor.invoice.tree</field>
        <field name="model">hpc.contractor.invoice</field>
        <field name="arch" type="xml">
            <tree string="Contractor Invoices"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'generated'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="salary_run_id" optional="show"/>
                <field name="legal_entity_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="hours_on_invoice" widget="float_time" optional="show"/>
                <field name="amount_on_invoice" widget="monetary" optional="show"
                       groups="hr_payroll_for_contractors.group_hpc_user"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'generated'"/>
                <field name="generated_docx_id" optional="show" widget="many2one_url"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Contractor Invoice - Form View                               -->
    <!-- ============================================================ -->
    <record id="view_hpc_contractor_invoice_form" model="ir.ui.view">
        <field name="name">hpc.contractor.invoice.form</field>
        <field name="model">hpc.contractor.invoice</field>
        <field name="arch" type="xml">
            <form string="Contractor Invoice">
                <header>
                    <button name="action_generate_invoice_docs"
                            type="object"
                            string="Generate Invoice"
                            class="btn-primary"/>
                    <button name="action_build_context"
                            type="object"
                            string="Rebuild Context"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <!-- Hidden fields for invisible modifiers -->
                    <field name="generated_docx_id"           invisible="1"/>
                    <field name="generated_pdf_id"            invisible="1"/>
                    <field name="invoice_sign_template_id"    invisible="1"/>
                    <field name="invoice_sign_request_id"     invisible="1"/>
                    <field name="invoice_sign_request_state"  invisible="1"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="text-muted small">Invoice ID (ctx.invoice_id):</span>
                            <field name="invoice_uid" readonly="1" nolabel="1"
                                   placeholder="— generated on first context build —"
                                   class="fw-bold"/>
                        </div>
                    </div>

                    <group>
                        <group string="Salary Run">
                            <field name="employee_id"/>
                            <field name="salary_run_id"
                                   domain="[('employee_id', '=', employee_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="hours_on_invoice" widget="float_time" readonly="1"/>
                            <field name="amount_on_invoice" widget="monetary" readonly="1"
                                   groups="hr_payroll_for_contractors.group_hpc_user"/>
                        </group>
                        <group string="Invoice Setup">
                            <field name="legal_entity_id"
                                   domain="[('contractor_id.employee_id', '=', employee_id)]"/>
                        </group>
                    </group>

                    <!-- Generated Documents -->
                    <separator string="Generated Documents"/>
                    <group>
                        <group string="Files">
                            <label for="generated_docx_id" string="DOCX"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="generated_docx_id" readonly="1" nolabel="1"
                                       options="{'no_create': True, 'no_open': False}"/>
                                <button name="action_download_docx" type="object"
                                        string="Download" class="btn btn-outline-secondary btn-sm"
                                        invisible="not generated_docx_id"/>
                            </div>
                            <label for="generated_pdf_id" string="PDF"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="generated_pdf_id" readonly="1" nolabel="1"
                                       options="{'no_create': True, 'no_open': False}"/>
                                <button name="action_download_pdf" type="object"
                                        string="Download" class="btn btn-outline-secondary btn-sm"
                                        invisible="not generated_pdf_id"/>
                            </div>
                        </group>
                        <group>
                            <div class="d-flex gap-2">
                                <button name="action_send_for_signing" type="object"
                                        string="Send for Signing" class="btn btn-secondary btn-sm"
                                        invisible="not generated_pdf_id or invoice_sign_template_id"/>
                            </div>
                            <!-- Sign status row -->
                            <div class="d-flex align-items-center gap-2 mt-1"
                                 invisible="not invoice_sign_template_id">
                                <span class="fw-bold small text-muted">Signing:</span>
                                <field name="invoice_sign_request_state"
                                       widget="badge"
                                       decoration-success="invoice_sign_request_state == 'signed'"
                                       decoration-warning="invoice_sign_request_state in ['sent', 'shared']"
                                       decoration-danger="invoice_sign_request_state in ['refused', 'canceled', 'expired']"
                                       readonly="1" nolabel="1"/>
                                <button name="action_view_signing" type="object"
                                        string="View Request" class="btn btn-link btn-sm p-0"/>
                                <button name="action_download_signed" type="object"
                                        string="Download Signed PDF" class="btn btn-success btn-sm"
                                        invisible="invoice_sign_request_state != 'signed'"/>
                                <button name="action_reset_signing" type="object"
                                        string="Delete" class="btn btn-danger btn-sm"
                                        confirm="This will cancel and permanently delete the signing request and signed document. Continue?"/>
                            </div>
                        </group>
                    </group>

                    <!-- Template Variables with resolved values -->
                    <div invisible="not rendered_vars_html">
                        <separator string="Template Variables"/>
                        <field name="rendered_vars_html" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Context Preview -->
                    <div invisible="not context_data">
                        <separator string="Built Context (JSON)"/>
                        <field name="context_data" nolabel="1"
                               widget="ace" options="{'mode': 'json'}"
                               readonly="1"/>
                    </div>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Contractor Invoice - Search View                             -->
    <!-- ============================================================ -->
    <record id="view_hpc_contractor_invoice_search" model="ir.ui.view">
        <field name="name">hpc.contractor.invoice.search</field>
        <field name="model">hpc.contractor.invoice</field>
        <field name="arch" type="xml">
            <search string="Contractor Invoices">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="salary_run_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Generated" name="filter_generated"
                        domain="[('state', '=', 'generated')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Legal Entity" name="group_by_legal_entity"
                            context="{'group_by': 'legal_entity_id'}"/>
                    <filter string="Status" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Contractor Invoice - Action                                  -->
    <!-- ============================================================ -->
    <record id="action_hpc_contractor_invoice" model="ir.actions.act_window">
        <field name="name">Contractor Invoices</field>
        <field name="res_model">hpc.contractor.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No contractor invoices yet
            </p>
            <p>
                Contractor invoices are generated from approved salary runs
                via the <strong>Generate Contractors Invoices</strong> button on a salary run.
            </p>
        </field>
    </record>
</odoo>
