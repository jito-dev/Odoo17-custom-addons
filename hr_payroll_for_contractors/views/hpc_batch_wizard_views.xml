<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hpc_batch_wizard_form" model="ir.ui.view">
        <field name="name">hr.payroll.contractor.batch.wizard.form</field>
        <field name="model">hr.payroll.contractor.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Batch Salary Runs">
                <sheet>
                    <group string="Period">
                        <field name="date_start" readonly="1"/>
                        <field name="date_end" readonly="1"/>
                    </group>
                    <field name="line_ids">
                        <tree create="0" delete="0" string="Preview">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="contracting_type" readonly="1"/>
                            <field name="total_hours" readonly="1" widget="float_time"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_to_pay" readonly="1" widget="monetary"/>
                            <field name="existing_run_id" readonly="1" string="Existing Run"
                                   optional="show"/>
                            <button name="action_create_single_run" type="object"
                                    string="+ Create Run"
                                    class="btn-secondary btn-sm"
                                    invisible="existing_run_id != False"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_all_selected" type="object"
                            string="Create Selected Salary Runs"
                            class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
