<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Contract Form – Revolut Payment Details section              -->
    <!-- ============================================================ -->
    <record id="view_hpc_contract_revolut_form" model="ir.ui.view">
        <field name="name">hr.payroll.contractor.contract.revolut.form</field>
        <field name="model">hr.payroll.contractor.contract</field>
        <field name="inherit_id" ref="hr_payroll_for_contractors.view_hpc_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='compensation_group']" position="after">
                <div class="o_horizontal_separator mt-4 mb-1"
                     groups="hr_payroll_for_contractors.group_hpc_user"
                     style="display:flex; align-items:center; gap:8px;">
                    <img src="/hpc_revolut_payments/static/img/revolut_icon.png"
                         style="height:26px; width:26px; border-radius:6px; flex-shrink:0;"/>
                    <field name="is_revolut_enabled" widget="boolean_toggle"
                           groups="hr_payroll_for_contractors.group_hpc_user"/>
                    <span>Payment Details for Revolut Business</span>
                </div>
                <group groups="hr_payroll_for_contractors.group_hpc_user"
                       invisible="not is_revolut_enabled">
                    <group>
                        <field name="revolut_recipient_name"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="revolut_iban"/>
                        <field name="revolut_bic"/>
                        <field name="revolut_bank_country_id"/>
                    </group>
                    <group string="Address">
                        <field name="revolut_recipient_country_id"/>
                        <field name="revolut_address_line1"/>
                        <field name="revolut_address_line2"/>
                        <field name="revolut_city"/>
                        <field name="revolut_postal_code"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
