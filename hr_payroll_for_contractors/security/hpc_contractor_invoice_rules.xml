<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Allow group_hpc_employee to read only their own contractor invoices -->
    <record id="rule_hpc_contractor_invoice_employee_own"
            model="ir.rule">
        <field name="name">Contractor Invoice: employee sees own</field>
        <field name="model_id" ref="model_hpc_contractor_invoice"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_payroll_for_contractors.group_hpc_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
