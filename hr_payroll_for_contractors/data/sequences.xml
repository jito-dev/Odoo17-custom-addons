<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_hpc_salary_run" model="ir.sequence">
        <field name="name">Payroll Contractor Salary Run</field>
        <field name="code">hr.payroll.contractor.salary.run</field>
        <field name="prefix">PCRUN/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
    </record>

    <record id="seq_hpc_contract_service_agreement" model="ir.sequence">
        <field name="name">Payroll Contractor Service Agreement</field>
        <field name="code">hpc.contract.service.agreement</field>
        <field name="prefix">CSA/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
    </record>

    <record id="seq_hpc_contractor_invoice" model="ir.sequence">
        <field name="name">Payroll Contractor Invoice</field>
        <field name="code">hpc.contractor.invoice</field>
        <field name="prefix">CINV/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
    </record>
</odoo>
