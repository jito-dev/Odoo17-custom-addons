<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ecb.exchange.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='update_exchange_rates']" position="after">
                <setting id="ecb_exchange_rates" string="ECB Exchange Rates Downloader"
                         help="Download exchange rates from the European Central Bank (ECB) for all active currencies. Rates are automatically normalized to your company's base currency.">
                    <div class="content-group">
                        <field name="ecb_last_sync_status" invisible="1"/>

                        <!-- Sync status -->
                        <div class="row mt8 mb8">
                            <span class="col-lg-3 o_form_label">Last Sync</span>
                            <div class="col-lg-9 d-flex align-items-center gap-2">
                                <field name="ecb_last_sync_date" widget="datetime"
                                       readonly="1" nolabel="1"
                                       invisible="not ecb_last_sync_date"/>
                                <span class="badge text-bg-success"
                                      invisible="ecb_last_sync_status != 'success'">
                                    Success
                                </span>
                                <span class="badge text-bg-danger"
                                      invisible="ecb_last_sync_status != 'failed'">
                                    Failed
                                </span>
                                <span class="text-muted"
                                      invisible="ecb_last_sync_date">
                                    Never synced
                                </span>
                            </div>
                        </div>

                        <!-- Error message (only when failed) -->
                        <div class="row mb8"
                             invisible="ecb_last_sync_status != 'failed'">
                            <span class="col-lg-3 o_form_label">Error</span>
                            <div class="col-lg-9">
                                <field name="ecb_last_sync_error" readonly="1"
                                       nolabel="1" class="text-danger"/>
                            </div>
                        </div>

                        <!-- Stale rate threshold -->
                        <div class="row mb8">
                            <label for="ecb_stale_rate_days" class="col-lg-3 o_light_label"
                                   string="Block posting if rates older than"/>
                            <div class="col-lg-9 d-flex align-items-center gap-1">
                                <field name="ecb_stale_rate_days" nolabel="1"
                                       class="o_field_integer" style="width: 60px;"/>
                                <span>days (0 = disabled)</span>
                            </div>
                        </div>

                        <div class="text-muted mb8">
                            A daily scheduled action updates rates automatically
                            with retry and fallback.
                        </div>

                        <!-- Action buttons -->
                        <div class="mt8">
                            <button name="action_ecb_download_daily"
                                    type="object"
                                    string="Download Latest Rates"
                                    class="btn-link"
                                    icon="fa-download"/>
                        </div>
                        <div class="mt8">
                            <button name="%(action_ecb_rate_history_wizard)d"
                                    type="action"
                                    string="Download Historical Rates"
                                    class="btn-link"
                                    icon="fa-history"/>
                        </div>
                        <div class="mt8">
                            <button name="action_ecb_delete_all_rates"
                                    type="object"
                                    string="Delete All Rates"
                                    class="btn-link text-danger"
                                    icon="fa-trash"
                                    confirm="This will permanently delete ALL exchange rate records for ALL currencies in this company. This action cannot be undone. Are you sure?"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
