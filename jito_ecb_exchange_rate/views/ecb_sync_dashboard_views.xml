<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         ECB Sync Dashboard — Form View
         ══════════════════════════════════════════════════════════════════ -->

    <record id="ecb_sync_dashboard_view_form" model="ir.ui.view">
        <field name="name">ecb.sync.dashboard.form</field>
        <field name="model">ecb.sync.dashboard</field>
        <field name="arch" type="xml">
            <form string="ECB Exchange Rate Sync" create="false" delete="false">
                <header>
                    <button name="action_download_now" type="object"
                            string="Download Latest Rates"
                            class="btn-primary" icon="fa-download"/>
                    <button name="action_run_cron" type="object"
                            string="Run Cron (All Companies)"
                            class="btn-secondary" icon="fa-play"/>
                </header>
                <sheet>
                    <!-- ── Stat Buttons ──────────────────────────── -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_open_rates"
                                type="object" icon="fa-line-chart">
                            <field string="Rate Records" name="total_rate_records"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="action_open_currencies"
                                type="object" icon="fa-money">
                            <field string="Active Currencies" name="active_currencies"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_rates" icon="fa-calendar-check-o">
                            <field string="Updated Today" name="rates_today"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_currencies" icon="fa-exclamation-triangle"
                                invisible="stale_currencies == 0">
                            <field string="Stale Currencies" name="stale_currencies"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <!-- ── Title ─────────────────────────────────── -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ── Sync Status Section ──────────────────── -->
                    <group string="Sync Status">
                        <group>
                            <field name="last_sync_date" widget="datetime"
                                   readonly="1" string="Last Sync"/>
                            <field name="sync_status" readonly="1"
                                   string="Status" widget="badge"
                                   decoration-success="sync_status == 'success'"
                                   decoration-danger="sync_status == 'failed'"
                                   decoration-muted="sync_status == 'never'"/>
                            <field name="last_sync_error" readonly="1"
                                   invisible="sync_status != 'failed'"
                                   class="text-danger"/>
                            <field name="company_currency" readonly="1"
                                   string="Base Currency"/>
                            <field name="stale_rate_days" readonly="1"
                                   string="Stale Threshold (days)"/>
                        </group>
                        <group>
                            <field name="latest_rate_date" readonly="1"/>
                            <field name="oldest_rate_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── Stale Currencies Warning ─────────────── -->
                    <div class="alert alert-warning" role="alert"
                         invisible="stale_currencies == 0">
                        <strong>
                            <i class="fa fa-exclamation-triangle"/>
                            Stale Currencies
                        </strong>
                        <p class="mb-0">
                            The following currencies have no rate update within
                            the configured threshold:
                            <field name="stale_currency_names" nolabel="1" readonly="1"/>
                        </p>
                    </div>

                    <!-- ── Scheduled Action ─────────────────────── -->
                    <group string="Scheduled Action (Cron)">
                        <group>
                            <field name="cron_active" readonly="1"
                                   widget="boolean_toggle"/>
                            <field name="cron_interval" readonly="1"/>
                        </group>
                        <group>
                            <field name="cron_next_call" readonly="1"
                                   widget="datetime"/>
                        </group>
                    </group>

                    <!-- ── Quick Actions ─────────────────────────── -->
                    <group string="Quick Actions">
                        <div>
                            <button name="action_open_settings" type="object"
                                    string="Open ECB Settings"
                                    class="btn-link" icon="fa-cog"/>
                        </div>
                        <div>
                            <button name="action_open_rates" type="object"
                                    string="View All Exchange Rates"
                                    class="btn-link" icon="fa-table"/>
                        </div>
                        <div>
                            <button name="action_open_currencies" type="object"
                                    string="View Active Currencies"
                                    class="btn-link" icon="fa-money"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Action: open dashboard singleton
         ══════════════════════════════════════════════════════════════════ -->

    <record id="action_ecb_sync_dashboard" model="ir.actions.server">
        <field name="name">ECB Sync Dashboard</field>
        <field name="model_id" ref="model_ecb_sync_dashboard"/>
        <field name="state">code</field>
        <field name="code">
record = env['ecb.sync.dashboard']._get_singleton()
action = {
    'type': 'ir.actions.act_window',
    'name': 'ECB Sync Dashboard',
    'res_model': 'ecb.sync.dashboard',
    'view_mode': 'form',
    'res_id': record.id,
    'target': 'current',
    'views': [(env.ref('jito_ecb_exchange_rate.ecb_sync_dashboard_view_form').id, 'form')],
}
        </field>
    </record>


</odoo>
