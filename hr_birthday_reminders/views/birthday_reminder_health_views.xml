<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Form view for the Health Check dashboard.

        The view is intentionally a "viewer", not an editor:
        create/edit/delete are disabled. The Run-Now buttons in the
        header are gated to Birthday Reminders Managers; everyone
        else (Responsibles) sees only the status fields and the
        drill-down "View" links.
    -->
    <record id="birthday_reminder_health_form_view" model="ir.ui.view">
        <field name="name">birthday.reminder.health.form</field>
        <field name="model">birthday.reminder.health</field>
        <field name="arch" type="xml">
            <form string="Birthday Reminders — Health Check"
                  create="false" edit="false" delete="false">
                <header>
                    <field name="overall_status"
                           widget="badge"
                           decoration-success="overall_status == 'ok'"
                           decoration-warning="overall_status == 'warning'"
                           decoration-danger="overall_status == 'danger'"/>
                    <button name="action_refresh"
                            type="object"
                            string="Refresh"
                            class="btn-secondary"/>
                    <button name="action_run_reminders_cron_now"
                            type="object"
                            string="Run Reminders Cron Now"
                            class="btn-primary"
                            confirm="Run the reminders cron now? The flow is idempotent — re-running on the same day produces no duplicate notifications."
                            groups="hr_birthday_reminders.group_birthday_manager"/>
                    <button name="action_run_greetings_cron_now"
                            type="object"
                            string="Run Greetings Cron Now"
                            class="btn-primary"
                            confirm="Run the greetings cron now? The flow is idempotent."
                            groups="hr_birthday_reminders.group_birthday_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Birthday Reminders — Health Check</h1>
                        <field name="overall_message" readonly="1" nolabel="1"/>
                    </div>

                    <group string="Cron Status">
                        <group string="Reminders → Responsibles">
                            <field name="reminders_cron_active"/>
                            <field name="reminders_cron_lastcall"/>
                            <field name="reminders_cron_nextcall"/>
                            <field name="reminders_cron_status"
                                   widget="badge"
                                   decoration-success="reminders_cron_status == 'ok'"
                                   decoration-warning="reminders_cron_status == 'warning'"
                                   decoration-danger="reminders_cron_status == 'danger'"/>
                        </group>
                        <group string="Greetings → Employee">
                            <field name="greetings_cron_active"/>
                            <field name="greetings_cron_lastcall"/>
                            <field name="greetings_cron_nextcall"/>
                            <field name="greetings_cron_status"
                                   widget="badge"
                                   decoration-success="greetings_cron_status == 'ok'"
                                   decoration-warning="greetings_cron_status == 'warning'"
                                   decoration-danger="greetings_cron_status == 'danger'"/>
                        </group>
                    </group>

                    <group string="Today">
                        <group>
                            <field name="today_birthdays"/>
                            <field name="today_reminders_sent"/>
                        </group>
                        <group>
                            <field name="today_greetings_sent"/>
                            <field name="today_greetings_failed"
                                   widget="badge"
                                   decoration-success="today_greetings_failed == 0"
                                   decoration-danger="today_greetings_failed > 0"/>
                        </group>
                    </group>

                    <group string="Subscriptions">
                        <field name="subscriptions_active"/>
                        <div class="o_row">
                            <field name="subscriptions_stale"
                                   widget="badge"
                                   decoration-success="subscriptions_stale == 0"
                                   decoration-warning="subscriptions_stale > 0"/>
                            <button name="action_open_stale_subscriptions"
                                    type="object"
                                    string="View stale →"
                                    class="btn-link"
                                    invisible="subscriptions_stale == 0"/>
                        </div>
                    </group>

                    <group string="Recent failures (last 30 days)">
                        <div class="o_row">
                            <field name="recent_failures_30d"
                                   widget="badge"
                                   decoration-success="recent_failures_30d == 0"
                                   decoration-danger="recent_failures_30d > 0"/>
                            <button name="action_open_failed_greetings"
                                    type="object"
                                    string="View failed greetings →"
                                    class="btn-link"
                                    invisible="recent_failures_30d == 0"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        Entry-point server action. We can't link the menuitem directly
        to an act_window on a TransientModel (the form would open in
        "new" mode with discard/save buttons, which is the wrong UX
        for a read-only dashboard). The server action below creates a
        fresh transient record and returns an act_window targeting
        that record by id, so the form opens already-populated and
        the user never sees an unsaved-changes state.
    -->
    <record id="birthday_reminder_health_action" model="ir.actions.server">
        <field name="name">Birthday Reminders — Health Check</field>
        <field name="model_id" ref="model_birthday_reminder_health"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <menuitem id="menu_birthday_reminder_health"
              name="Health Check"
              parent="menu_birthday_reminders_root"
              action="birthday_reminder_health_action"
              sequence="1"/>

</odoo>
