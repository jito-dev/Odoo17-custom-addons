<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Custom hr.employee kanban for the Birthday Reminders app.

        All employee data (photo, job title, work email, birthday) is read
        directly from hr.employee — we do not duplicate any field. The
        view is opened via our own action so it does not interfere with
        the default HR kanban.

        Photo handling follows the HR canonical pattern: prefer image_1024
        with a low-res preview, fall back to avatar_128, finally an SVG
        silhouette so an employee without a photo still renders cleanly.
    -->
    <record id="hr_employee_birthday_kanban_view" model="ir.ui.view">
        <field name="name">hr.employee.birthday.kanban</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban class="o_hr_employee_kanban o_birthday_employee_kanban" sample="1"
                    create="false"
                    default_group_by="birthday_proximity"
                    default_order="next_birthday"
                    group_create="false"
                    group_delete="false"
                    group_edit="false"
                    records_draggable="false">
                <field name="id"/>
                <field name="name"/>
                <field name="job_title"/>
                <field name="work_email"/>
                <field name="birthday"/>
                <field name="next_birthday"/>
                <field name="birthday_proximity"/>
                <field name="birthday_greeting_state"/>
                <field name="image_128"/>
                <field name="image_1024"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <t t-if="record.image_1024.raw_value">
                                <field name="image_1024"
                                       class="o_kanban_image_fill_left d-block"
                                       preview_image="image_128"
                                       widget="background_image"
                                       options="{'zoom': true, 'zoom_delay': 1000}"/>
                            </t>
                            <t t-elif="record.image_128.raw_value">
                                <field name="avatar_128"
                                       class="o_kanban_image_fill_left d-block"
                                       widget="background_image"
                                       options="{'zoom': true, 'zoom_delay': 1000}"/>
                            </t>
                            <div t-else="" class="o_kanban_image_fill_left d-flex align-items-center justify-content-center bg-100 bg-gradient">
                                <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <g fill="currentColor">
                                        <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                        <circle cx="10" cy="5.5" r="4.5"/>
                                    </g>
                                </svg>
                            </div>

                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <ul>
                                    <li t-if="record.job_title.raw_value">
                                        <field name="job_title"/>
                                    </li>
                                    <li t-if="record.work_email.raw_value">
                                        <i class="fa fa-envelope me-1" role="img" aria-label="Email" title="Email"/>
                                        <field name="work_email"/>
                                    </li>
                                    <li t-if="record.next_birthday.raw_value">
                                        <span>🎂 </span>
                                        <field name="next_birthday"/>
                                    </li>
                                </ul>
                                <div t-if="record.birthday_proximity.raw_value === '1_today'" class="mt-1">
                                    <span t-if="record.birthday_greeting_state.raw_value === 'sent'"
                                          class="badge rounded-pill text-bg-success"
                                          title="Birthday greeting email was sent to the employee.">
                                        <i class="fa fa-check me-1" aria-hidden="true"/>Sent
                                    </span>
                                    <span t-if="record.birthday_greeting_state.raw_value === 'failed'"
                                          class="badge rounded-pill text-bg-warning"
                                          title="Auto greeting could not be delivered. Responsibles have been notified.">
                                        <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>Failed
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--
        Custom tree view: same fields as the HR canonical list but trimmed
        to the columns relevant to the birthday-reminders flow. No photo
        column per the spec — photo lives in the kanban view only.
    -->
    <record id="hr_employee_birthday_tree_view" model="ir.ui.view">
        <field name="name">hr.employee.birthday.tree</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Employees" sample="1" create="false" delete="false"
                  default_order="next_birthday">
                <field name="name"/>
                <field name="job_title"/>
                <field name="work_email"/>
                <field name="next_birthday"/>
                <field name="birthday_proximity"
                       widget="badge"
                       decoration-danger="birthday_proximity == '1_today'"
                       decoration-warning="birthday_proximity == '2_tomorrow'"
                       decoration-info="birthday_proximity == '3_this_week'"
                       decoration-muted="birthday_proximity == '4_later'"/>
                <field name="birthday_greeting_state"
                       widget="badge"
                       optional="show"
                       decoration-success="birthday_greeting_state == 'sent'"
                       decoration-warning="birthday_greeting_state == 'failed'"/>
            </tree>
        </field>
    </record>

    <!--
        Calendar view: anchored on `next_birthday` (computed live from
        hr.employee.birthday) so events appear on the upcoming occurrence
        in the current/next year, not on the historical birth date.
        Coloured by department so HR can see which teams have upcoming
        celebrations at a glance.
    -->
    <record id="hr_employee_birthday_calendar_view" model="ir.ui.view">
        <field name="name">hr.employee.birthday.calendar</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <calendar string="Birthdays"
                      date_start="next_birthday"
                      mode="month"
                      hide_time="true"
                      quick_create="0"
                      create="false"
                      delete="false"
                      color="department_id">
                <field name="name"/>
                <field name="job_title"/>
                <field name="work_email"/>
                <field name="department_id" filters="1"/>
                <field name="birthday_greeting_state"/>
            </calendar>
        </field>
    </record>

    <record id="birthday_employees_action" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,calendar</field>
        <!--
            Domain restricts to employees whose ``birthday_proximity`` is
            set — equivalent to "has a birthday". We deliberately use
            ``birthday_proximity`` (our compute field, no group
            restriction) instead of ``birthday`` (gated by
            ``hr.group_hr_user``) so Responsibles without HR rights can
            still load the view.
        -->
        <field name="domain">[('birthday_proximity', '!=', False)]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban',   'view_id': ref('hr_employee_birthday_kanban_view')}),
            (0, 0, {'view_mode': 'tree',     'view_id': ref('hr_employee_birthday_tree_view')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('hr_employee_birthday_calendar_view')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employees with a birthday yet.
            </p>
            <p>
                Set a birthday on an employee record (in the HR module) to
                have them appear here and in the daily reminders cron.
            </p>
        </field>
    </record>

    <menuitem id="menu_birthday_employees"
              name="Employees"
              parent="menu_birthday_reminders_root"
              action="birthday_employees_action"
              sequence="5"/>

</odoo>
