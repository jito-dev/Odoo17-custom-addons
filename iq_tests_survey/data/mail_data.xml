<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_iq_invite" model="mail.template">
        <field name="name">Recruitment: IQ Test Invitation</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="subject">Assessment for {{ object.job_id.name }}: Please complete your IQ Test</field>
        <field name="email_to">{{ object.email_from }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello <t t-out="object.partner_name or 'Applicant'"/>,<br/><br/>
                    Congratulations! You have passed the initial screening for the 
                    <strong><t t-out="object.job_id.name"/></strong> position.<br/><br/>
                    
                    The next step in our process is a logic assessment. 
                    Please click the link below to start the test. This link is unique to you.
                    <br/><br/>
                    <div style="text-align: center; margin: 16px 0px;">
                        <a t-att-href="object._get_iq_test_url()"
                           style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">
                           Start IQ Test
                        </a>
                    </div>
                    <br/>
                    Good luck!<br/>
                    The Recruitment Team
                </p>
            </div>
        </field>
    </record>

</odoo>