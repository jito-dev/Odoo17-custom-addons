<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iq_survey_form" model="ir.ui.view">
        <field name="name">iq.survey.form</field>
        <field name="model">iq.survey</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_results" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="participant_count" widget="statinfo" string="Results"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only"/>
                        <h1><field name="title"/></h1>
                        <h3><field name="slug" class="oe_inline" placeholder="url-slug"/></h3>
                    </div>
                    
                    <group>
                        <group>
                            <field name="access_mode" widget="radio"/>
                            <field name="test_url" widget="CopyClipboardChar" invisible="access_mode == 'token'"/>
                            <field name="active"/>
                            <field name="job_id" placeholder="Optional (for Recruitment)"/>
                        </group>
                        <group string="Statistics">
                            <field name="average_score"/>
                            <field name="median_score"/>
                            <field name="average_duration"/>
                            <label for="min_score" string="Score Range"/>
                            <div class="o_row">
                                <field name="min_score"/> - <field name="max_score"/>
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Result Configuration">
                            <group>
                                <group>
                                    <field name="show_score"/>
                                    <field name="show_category"/>
                                    <div colspan="2" class="mt-2">
                                        <button name="action_preview_result" string="Preview Result Page" type="object" 
                                                class="btn btn-outline-primary" icon="fa-eye"/>
                                    </div>
                                </group>
                            </group>
                            <!-- Horizontal Message Field -->
                            <group string="Success Message">
                                <field name="result_msg_success" nolabel="0" colspan="2"/>
                            </group>
                        </page>
                        <page string="Email Configuration">
                            <group>
                                <field name="email_template_id"/>
                                <div class="text-muted" colspan="2">
                                    This template will be sent when an applicant is moved to the 'IQ Test Assigned' stage.
                                    If left empty, the default template will be used.
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_iq_survey_tree" model="ir.ui.view">
        <field name="name">iq.survey.tree</field>
        <field name="model">iq.survey</field>
        <field name="arch" type="xml">
            <tree>
                <field name="title"/>
                <field name="slug"/>
                <field name="access_mode"/>
                <field name="participant_count"/>
                <field name="average_score"/>
                <field name="average_duration" string="Avg Time (min)"/>
            </tree>
        </field>
    </record>

    <record id="view_iq_user_input_tree" model="ir.ui.view">
        <field name="name">iq.user_input.tree</field>
        <field name="model">iq.user_input</field>
        <field name="arch" type="xml">
            <tree string="Results" create="false" default_order="create_date desc">
                <field name="create_date"/>
                <field name="survey_id" optional="show"/>
                <field name="name"/>
                <field name="email" optional="show"/>
                <field name="age" optional="hide"/>
                <field name="iq_score" decoration-bf="1" decoration-success="iq_score &gt; 110" decoration-warning="iq_score &lt; 90"/>
                <field name="iq_category"/>
                <field name="test_duration" string="Time (min)"/>
                <field name="applicant_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_iq_user_input_form" model="ir.ui.view">
        <field name="name">iq.user_input.form</field>
        <field name="model">iq.user_input</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Candidate">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="age"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Performance">
                            <field name="raw_score"/>
                            <field name="iq_score" class="oe_title" style="font-size: 2em;"/>
                            <field name="iq_category"/>
                            <field name="test_duration"/>
                        </group>
                    </group>
                    
                    <div class="mt-4">
                        <separator string="Distribution Curve"/>
                        <div class="d-flex justify-content-center">
                            <img src="/iq_tests_survey/static/src/img/iq_curve.png" style="max-width: 800px; width: 100%; border: 1px solid #e9ecef; padding: 10px; border-radius: 5px;"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>