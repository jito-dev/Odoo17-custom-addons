<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_iq_tests" model="ir.module.category">
        <field name="name">Cognitive Assessments</field>
        <field name="description">Manage Cognitive Assessments and Campaigns for internal employees.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Cognitive Assessments User: can take assigned assessments, view own results (read-only) -->
    <record id="group_iq_user" model="res.groups">
        <field name="name">Cognitive Assessments User</field>
        <field name="category_id" ref="module_category_iq_tests"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Cognitive Assessments Administrator: full management access, implies Cognitive Assessments User -->
    <record id="group_iq_manager" model="res.groups">
        <field name="name">Cognitive Assessments Administrator</field>
        <field name="category_id" ref="module_category_iq_tests"/>
        <field name="implied_ids" eval="[(4, ref('group_iq_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
