<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- iq.survey: manager sees all -->
        <record id="rule_iq_survey_manager" model="ir.rule">
            <field name="name">Cognitive Survey: manager sees all</field>
            <field name="model_id" ref="model_iq_survey"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('iq_tests_survey.group_iq_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- iq.survey: user reads all (to select and display test info) -->
        <record id="rule_iq_survey_user" model="ir.rule">
            <field name="name">Cognitive Survey: user reads all</field>
            <field name="model_id" ref="model_iq_survey"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('iq_tests_survey.group_iq_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- iq.question: manager sees all -->
        <record id="rule_iq_question_manager" model="ir.rule">
            <field name="name">Cognitive Question: manager sees all</field>
            <field name="model_id" ref="model_iq_question"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('iq_tests_survey.group_iq_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- iq.question: user reads all (needed to take the test) -->
        <record id="rule_iq_question_user" model="ir.rule">
            <field name="name">Cognitive Question: user reads all</field>
            <field name="model_id" ref="model_iq_question"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('iq_tests_survey.group_iq_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- iq.user_input: manager sees all -->
        <record id="rule_iq_user_input_manager" model="ir.rule">
            <field name="name">Cognitive Result: manager sees all</field>
            <field name="model_id" ref="model_iq_user_input"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('iq_tests_survey.group_iq_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- iq.user_input: user sees only their own (matched by employee linked user) -->
        <record id="rule_iq_user_input_user" model="ir.rule">
            <field name="name">Cognitive Result: user sees own only</field>
            <field name="model_id" ref="model_iq_user_input"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('iq_tests_survey.group_iq_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>
</odoo>
