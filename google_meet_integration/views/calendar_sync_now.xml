<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backend "Sync now" engine: a server action that pulls/pushes the
         current user's Google Calendar on demand, surfaced as a menu item in
         the Calendar app. The in-calendar button (assets) reuses the native
         model sync; this menu is the no-JS, support-friendly twin. -->
    <record id="action_google_calendar_sync_now" model="ir.actions.server">
        <field name="name">Sync Google now</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env.user.action_sync_google_calendar_now()</field>
    </record>

    <menuitem
        id="menu_google_calendar_sync_now"
        name="Sync Google now"
        parent="calendar.mail_menu_calendar"
        action="action_google_calendar_sync_now"
        sequence="5"
        groups="base.group_user"/>

</odoo>
