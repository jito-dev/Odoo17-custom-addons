<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Videocall URL is meant to fill itself automatically:

          * Plain calendar events created by a Google-synced user get a Google
            Meet link from the native `google_calendar` two-way sync. When an
            event is pushed to Google with an empty `videocall_location` and no
            `location`, Odoo sends `conferenceData.createRequest` and Google
            mints a Meet link that syncs straight back into the field
            (`google_calendar/models/calendar.py`).

        Because the link is generated for you, the native manual "create URL"
        button is redundant and confusing, so we hide it on both event forms:

          * `set_discuss_videocall_location` ("+ Odoo meeting") — native button.

        The `videocall_location` field itself stays visible (read-only display of
        the auto-generated link) together with the "Clear" and "Join" actions.
        (The old "+ Google Meet" REST-mint button and its server method were
        removed in v17.0.4.0.0 — links come from the native sync.)
    -->

    <record id="view_calendar_event_form_inherit_google_meet" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.google.meet</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- Hide the native "+ Odoo meeting" manual-create button. -->
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_calendar_event_quick_create_inherit_google_meet" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.google.meet</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
