<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_google_meet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.meet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="google_calendar.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cal_sync_paused']/.." position="after">
                <div class="mt16 row">
                    <label for="google_meet_fallback_user_id"
                           string="Google Meet Fallback User"
                           class="col-3 col-lg-3 o_light_label"/>
                    <field name="google_meet_fallback_user_id" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
