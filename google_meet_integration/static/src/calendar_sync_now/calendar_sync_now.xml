<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Append a "Sync now" button to the Google sync toolbar that the
         google_calendar module injects (#google_calendar_sync). We extend the
         SAME base template (calendar.AttendeeCalendarController) that
         google_calendar extends; our assets load after it (dependency), so the
         div already exists in the accumulated template. Shown only when the
         user's Google Calendar is connected and syncing. -->
    <t t-name="google_meet_integration.CalendarSyncNowButton"
       t-inherit="calendar.AttendeeCalendarController"
       t-inherit-mode="extension">
        <xpath expr="//div[@id='google_calendar_sync']" position="inside">
            <button t-if="model.state.googleIsSync" type="button"
                    id="google_sync_now"
                    class="ms-1 o_google_sync_button btn btn-outline-secondary text-nowrap"
                    title="Pull the latest changes from Google Calendar now"
                    t-on-click="onForceGoogleSyncNow">
                <b>
                    <i class="fa fa-cloud-download"/>
                    <span class="mx-1">Sync now</span>
                </b>
            </button>
        </xpath>
    </t>

</templates>
