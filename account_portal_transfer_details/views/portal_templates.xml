<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        One row of the card. QWeb raises on an undefined variable, so every `t-call` sets all
        five values explicitly, defaults included.

          label  what the bank form calls it
          value  what the customer reads
          copy   what lands on the clipboard, which is not always the same string
          mono   -1 proportional · 0 monospace · 4 monospace, split into blocks of four
          ref    the payment reference, the one row carrying emphasis - weight only

        The row is a real <button>, not a div with a role: it gets Enter, Space, the focus ring
        and the accessible name for free, and a finance person on a keyboard never has to reach
        for the mouse.
    -->
    <template id="jt_pay_row" name="Bank transfer row">
        <button type="button" t-attf-class="jt-row #{ref and 'jt-row--ref' or ''}"
                t-att-data-copy="copy" t-attf-aria-label="Copy #{label}">
            <span class="jt-label">
                <span class="jt-label-idle" t-out="label"/>
                <span class="jt-label-done">
                    <svg class="jt-ico jt-ico--tick" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 12.5l5.5 5.5L20 7"/>
                    </svg>
                    <span>Copied</span>
                </span>
            </span>
            <span t-attf-class="jt-value #{mono >= 0 and 'jt-value--mono' or ''}"
                  t-att-data-group="mono > 0 and mono or None" t-out="value"/>
            <span class="jt-copy" aria-hidden="true">
                <svg class="jt-ico jt-ico--copy" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="9" y="9" width="12" height="12" rx="2"/>
                    <path d="M5 15V5a2 2 0 0 1 2-2h8"/>
                </svg>
                <svg class="jt-ico jt-ico--done" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M4 12.5l5.5 5.5L20 7"/>
                </svg>
            </span>
        </button>
    </template>

    <!--
        The card.

        It is a <details open> with the summary as its header, so folding is the browser's own
        and survives a page with no JavaScript: the customer can always close the block they are
        done with, and the invoice underneath is one scroll away rather than ten.

        The amount and the "Copy details" button live *inside* the summary, which is why their
        handlers stop the event - without that, copying would fold the card shut.
    -->
    <template id="transfer_details_card" name="Bank Transfer Details Card">
        <section class="jt-pay">
            <details class="jt-card" open="open">

                <summary class="jt-head">
                    <span class="jt-head-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 10l9-6 9 6"/>
                            <path d="M5 10v8m4-8v8m6-8v8m4-8v8"/>
                            <path d="M3 20h18"/>
                        </svg>
                    </span>

                    <span class="jt-head-main">
                        <span class="jt-eyebrow">Bank transfer</span>
                        <button type="button" class="jt-amount"
                                t-att-data-copy="card['hero']['copy']"
                                t-attf-aria-label="Copy #{card['hero']['label']}">
                            <span class="jt-amount-num" t-out="card['hero']['value_number']"/>
                            <span class="jt-amount-cur" t-out="card['currency']"/>
                            <svg class="jt-ico jt-amount-ico" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect x="9" y="9" width="12" height="12" rx="2"/>
                                <path d="M5 15V5a2 2 0 0 1 2-2h8"/>
                            </svg>
                        </button>
                        <span t-if="card['settled']" class="jt-settled" t-out="card['settled']"/>
                    </span>

                    <span class="jt-head-side">
                        <span t-if="card['due']"
                              t-attf-class="jt-due #{card['due']['late'] and 'jt-due--late' or ''}">
                            <svg class="jt-ico jt-ico--clock" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M12 7v5.5l3.5 2"/>
                            </svg>
                            <span t-out="card['due']['text']"/>
                        </span>

                        <button type="button" class="jt-all" t-att-data-copy-all="card['copy_all']"
                                aria-label="Copy all payment details">
                            <svg class="jt-ico jt-all-ico" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <rect x="9" y="9" width="12" height="12" rx="2"/>
                                <path d="M5 15V5a2 2 0 0 1 2-2h8"/>
                            </svg>
                            <!--
                                Both labels are laid over each other in the same box, so the
                                button is already as wide as the longer one and the header does
                                not jump when the copy lands.
                            -->
                            <span class="jt-all-text">
                                <span class="jt-all-idle">Copy details</span>
                                <span class="jt-all-done" aria-hidden="true">All details copied</span>
                            </span>
                        </button>

                        <svg class="jt-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M6 9l6 6 6-6"/>
                        </svg>
                    </span>
                </summary>

                <div class="jt-body">

                    <!--
                        The amount and the currency: the two halves of "how much", and the two a
                        bank form asks for in separate boxes. They are rows like any other because
                        the figure in the header is a heading, and a heading is not something a
                        customer expects to be able to copy field by field.
                    -->
                    <h6 class="jt-group-title">How much</h6>
                    <t t-foreach="card['hero_rows']" t-as="row">
                        <t t-call="account_portal_transfer_details.jt_pay_row">
                            <t t-set="label" t-value="row['label']"/>
                            <t t-set="value" t-value="row['value']"/>
                            <t t-set="copy" t-value="row['copy']"/>
                            <t t-set="mono" t-value="row['mono']"/>
                            <t t-set="ref" t-value="False"/>
                        </t>
                    </t>

                    <t t-foreach="card['groups']" t-as="group">
                        <h6 class="jt-group-title" t-out="group['title']"/>
                        <t t-foreach="group['rows']" t-as="row">
                            <t t-call="account_portal_transfer_details.jt_pay_row">
                                <t t-set="label" t-value="row['label']"/>
                                <t t-set="value" t-value="row['value']"/>
                                <t t-set="copy" t-value="row['copy']"/>
                                <t t-set="mono" t-value="row['mono']"/>
                                <t t-set="ref" t-value="row['key'] == 'reference'"/>
                            </t>
                        </t>
                    </t>

                    <p t-if="card['contact_email']" class="jt-foot">
                        Questions about this payment?
                        <a t-attf-href="mailto:#{card['contact_email']}" t-out="card['contact_email']"/>
                    </p>

                </div>
            </details>

            <!--
                Outside the card: the toast is fixed to the viewport, and a card that later gains
                a transform or a filter would clip it back inside itself.
            -->
            <div class="jt-toast" aria-hidden="true">
                <svg class="jt-ico jt-toast-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12.5l5.5 5.5L20 7"/>
                </svg>
                <span class="jt-toast-text"/>
            </div>
            <div class="jt-sr" role="status" aria-live="polite"/>
        </section>
    </template>

    <!--
        Inserted above the rendered invoice, where the customer looks before scrolling into the
        document itself. Fallback anchor for a customised portal layout:
        //div[hasclass('o_portal_sidebar')]//div[hasclass('row')][1]
    -->
    <template id="portal_invoice_page_transfer_details"
              inherit_id="account.portal_invoice_page" name="Transfer details on the invoice">
        <xpath expr="//div[@id='invoice_content']//div[hasclass('o_portal_html_view')]" position="before">
            <t t-if="invoice.move_type == 'out_invoice' and invoice.state == 'posted'
                     and invoice.payment_state not in ('paid', 'in_payment')
                     and invoice.partner_bank_id">
                <t t-set="card" t-value="invoice._get_transfer_card()"/>
                <t t-if="card">
                    <t t-call="account_portal_transfer_details.transfer_details_card"/>
                </t>
            </t>
        </xpath>
    </template>

    <!--
        Odoo shows its own "Finalize your payment" panel as soon as a transaction is pending, and
        for wire transfer that panel is the bank-account dump this module replaces. Two sets of
        transfer details on one page is worse than either alone: the customer has to decide which
        one to trust. Hidden only for wire transfer, and only when a card was actually rendered.
    -->
    <template id="portal_invoice_hide_stock_transfer_status"
              inherit_id="account_payment.portal_invoice_page_inherit_payment"
              name="Hide the duplicate transfer panel">
        <xpath expr="//div[hasclass('o_account_payment_tx_status')]" position="attributes">
            <attribute name="t-if" add="and not (tx.provider_id.sudo().custom_mode == 'wire_transfer' and invoice._get_transfer_details())" separator=" "/>
        </xpath>
    </template>

</odoo>
