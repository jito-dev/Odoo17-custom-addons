<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Where a product says how it should be named to a bank. On the Accounting page the
         account module already adds, because that is where the rest of "what this product
         does to a document" lives. -->
    <record id="product_template_form_view_transfer_purpose" model="ir.ui.view">
        <field name="name">product.template.form.transfer.purpose</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']//group[@name='accounting']" position="inside">
                <group string="Bank Transfer" name="transfer_purpose">
                    <field name="transfer_purpose_name"
                           placeholder="e.g. Software development services"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
