<odoo>
    <record id="rule_trainer_students" model="ir.rule">
        <field name="name">Trainer sees own students</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('gym_management.group_gym_trainer'))]"/>
        <field name="domain_force">['|', ('trainer_id', '=', False), ('trainer_id', '=', user.id)]</field>
    </record>

    <record id="rule_student_appointments" model="ir.rule">
        <field name="name">Student sees own appointments</field>
        <field name="model_id" ref="model_gym_appointment"/>
        <field name="groups" eval="[(4, ref('gym_management.group_gym_student'))]"/>
        <field name="domain_force">[('student_id', '=', user.partner_id.id)]</field>
    </record>

    <record id="rule_student_payment_history" model="ir.rule">
        <field name="name">Student sees own payment history</field>
        <field name="model_id" ref="model_gym_payment"/>
        <field name="groups" eval="[(4, ref('gym_management.group_gym_student'))]"/>
        <field name="domain_force">[('student_id', '=', user.partner_id.id)]</field>
    </record>
</odoo>
