<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gym_maintenance_tree" model="ir.ui.view">
        <field name="name">gym.maintenance.tree</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <tree string="Items">
                <field name="name"/>
                <field name="category_id"/>
                <field name="condition" widget="badge" 
                    decoration-success="condition == 'good'" 
                    decoration-danger="condition == 'broken'"
                    decoration-warning="condition == 'check'"
                />
                <field name="location"/>
                <field name="effective_date" string="Purchase Date" optional="show"/>
                <field name="next_maintenance_date" optional="show" string="Next Maintenance"/>
            </tree>
        </field>
    </record>

    <record id="view_gym_maintenance_kanban" model="ir.ui.view">
        <field name="name">gym.maintenance.kanban</field>
        <field name="model">maintenance.equipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" class="o_kanban_mobile">
                <field name="name"/>
                <field name="category_id"/>
                <field name="condition"/>
                <field name="location"/>
                <field name="effective_date"/>
                <field name="next_maintenance_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click shadow-sm border-left-lg">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title" style="font-size: 1.1em;">
                                    <field name="name"/>
                                </strong>
                                
                                <div class="mt-2 text-muted">
                                    <i class="fa fa-map-marker mr-1"/> <field name="location"/>
                                </div>

                                <div class="mt-1">
                                    <i class="fa fa-tag mr-1"/> <field name="category_id"/>
                                </div>

                                <div class="mt-3 d-flex justify-content-between align-items-center">
                                    <field name="condition" widget="label_selection" 
                                        options="{'classes': {'good': 'success', 'check': 'warning', 'broken': 'danger'}}"/>
                                    
                                    <small class="text-danger" t-if="record.next_maintenance_date.raw_value">
                                        <i class="fa fa-wrench mr-1"/> <field name="next_maintenance_date"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>    
        </field>   
    </record>

    <record id="action_gym_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_gym_maintenance_tree"/>
    </record>

    <record id="action_gym_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_gym_maintenance_tree"/>
        <field name="act_window_id" ref="action_gym_equipment"/>
    </record>

    <record id="action_gym_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_gym_maintenance_kanban"/>
        <field name="act_window_id" ref="action_gym_equipment"/>
    </record>
</odoo>