<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_gym_student_tree" model="ir.ui.view">
        <field name="name">gym.student.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Students">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_gym_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('trainer_id', '!=', False)]</field>
        <field name="context">{'default_trainer_id': uid}</field>
        
        <field name="view_id" ref="view_gym_student_tree"/>
    </record>
</odoo>
